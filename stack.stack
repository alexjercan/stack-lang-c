func stack_preprocessor.run.generate.data.init (stack_ast, stack_ast_data, stack_parser) () in -- ast, data, parser
    match ast decl parser in
        decl stack_ast_data.fields decl stack_ast_data.name stack_ast_node.value
        stack_ast_expr.sizeof array.init.with_sz match fields owner exprs in
            exprs parser owner "." string.concat STACK_SIZEOF string.concat stack_preprocessor.run.generate.data.call
            exprs parser STACK_FUNC_PTR_ALLOC stack_preprocessor.run.generate.data.call

            -- The last field is on top of the stack.
            fields array.count while dup 0 > loop
                1 - dup fields swp array.get unwrap stack_ast_data_field.* match i field in
                    field stack_ast_data_field.type stack_ast_node.value match ftype in
                        exprs parser STACK_FUNC_DUP stack_preprocessor.run.generate.data.call
                        exprs parser STACK_FUNC_ROT stack_preprocessor.run.generate.data.call
                        exprs parser STACK_FUNC_ROT stack_preprocessor.run.generate.data.call
                        exprs parser
                        owner "." string.concat field stack_ast_data_field.name stack_ast_node.value string.concat
                        "." string.concat STACK_OFFSET string.concat
                        stack_preprocessor.run.generate.data.call
                        exprs parser STACK_FUNC_PTR_OFFSET stack_preprocessor.run.generate.data.call
                        exprs parser STACK_FUNC_SWP stack_preprocessor.run.generate.data.call
                        exprs parser ftype ".&" string.concat stack_preprocessor.run.generate.data.call
                        exprs parser ftype "." string.concat STACK_SIZEOF string.concat stack_preprocessor.run.generate.data.call
                        exprs parser STACK_FUNC_PTR_COPY stack_preprocessor.run.generate.data.call
                        exprs parser STACK_FUNC_POP stack_preprocessor.run.generate.data.call
                    end
                    i
                end
            pool pop

            exprs parser owner ".*" string.concat stack_preprocessor.run.generate.data.call

            ast
            decl stack_ast_data.name owner "." string.concat STACK_INIT string.concat
            stack_preprocessor.run.generate.data.name
            exprs stack_ast_const.init stack_ast.features.append.const
        end
    end
end


func stack_preprocessor.run.generate.data.getters (stack_ast, stack_ast_data, stack_parser) () in -- ast, data, parser
    match ast decl parser in
        decl stack_ast_data.fields decl stack_ast_data.name stack_ast_node.value match fields owner in
            fields array.count while dup 0 > loop
                1 - dup fields swp array.get unwrap stack_ast_data_field.*
