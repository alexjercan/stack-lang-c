@import "stdlib"
@import "stack/lexer"
@import "stack/parser"
@import "stack/preprocessor"
@import "stack/typecheck"
@import "stack/builtins"

-- STACK TOKENIZER

func stack_lexer.dump (stack_lexer) () in
    match lexer in
        true while loop
            lexer stack_lexer.next match token in
                token stack_token.kind stack_token_kind.map
                token stack_token.value string.len 0 > if
                    "(" string.concat token stack_token.value string.concat ")" string.concat
                fi
                "\n" string.concat string.stdout

                token stack_token.kind STACK_TOKEN_EOF = not
            end
        pool
    end
end

-- STACK PARSER

const stack_ast.dump.indent 4

func stack_ast.dump.pad (int) () in -- indent
    " " swp string.repeat string.stdout
end

func stack_ast.dump.node (int, stack_ast_node) () in -- indent, node
    swp stack_ast.dump.pad stack_ast_node.value string.stdout "\n" string.stdout
end

func stack_ast.dump.cond (int, stack_ast_cond) () in -- indent, cond
    match indent cond in
        indent stack_ast.dump.pad "IF\n" string.stdout
        indent stack_ast.dump.indent + cond stack_ast_cond.if_ stack_ast.dump.exprs
        indent stack_ast.dump.pad "ELSE\n" string.stdout
        indent stack_ast.dump.indent + cond stack_ast_cond.else_ stack_ast.dump.exprs
        indent stack_ast.dump.pad "FI\n" string.stdout
    end
end

func stack_ast.dump.binds (array) () in -- array<node>
    match binds in
        0 while dup binds array.count < loop
            " " string.stdout
            dup binds swp array.get unwrap stack_ast_node.* stack_ast_node.value string.stdout
            1 +
        pool pop
    end
end

func stack_ast.dump.match (int, stack_ast_match) () in -- indent, match
    match indent node in
        indent stack_ast.dump.pad "MATCH" string.stdout
        node stack_ast_match.binds stack_ast.dump.binds
        "\n" string.stdout
        indent stack_ast.dump.indent + node stack_ast_match.exprs stack_ast.dump.exprs
    end
end

func stack_ast.dump.while (int, stack_ast_while) () in -- indent, while
    match indent node in
        indent stack_ast.dump.pad "WHILE\n" string.stdout
        indent stack_ast.dump.indent + node stack_ast_while.while_ stack_ast.dump.exprs
        indent stack_ast.dump.pad "LOOP\n" string.stdout
        indent stack_ast.dump.indent + node stack_ast_while.exprs stack_ast.dump.exprs
        indent stack_ast.dump.pad "POOL\n" string.stdout
    end
end

func stack_ast.dump.exprs (int, array) () in -- indent, array<expr>
    match indent exprs in
        0 while dup exprs array.count < loop
            dup exprs swp array.get unwrap stack_ast_expr.* match expr in
                expr stack_ast_expr.kind
                dup STACK_AST_EXPR_NUMBER = if
                    pop indent expr stack_ast_expr.expr stack_ast_node.* stack_ast.dump.node
                else dup STACK_AST_EXPR_BOOLEAN = if
                    pop indent expr stack_ast_expr.expr stack_ast_node.* stack_ast.dump.node
                else dup STACK_AST_EXPR_STRING = if
                    pop indent expr stack_ast_expr.expr stack_ast_node.* stack_ast.dump.node
                else dup STACK_AST_EXPR_NAME = if
                    pop indent expr stack_ast_expr.expr stack_ast_node.* stack_ast.dump.node
                else dup STACK_AST_EXPR_COND = if
                    pop indent expr stack_ast_expr.expr stack_ast_cond.* stack_ast.dump.cond
                else dup STACK_AST_EXPR_MATCH = if
                    pop indent expr stack_ast_expr.expr stack_ast_match.* stack_ast.dump.match
                else dup STACK_AST_EXPR_WHILE = if
                    pop indent expr stack_ast_expr.expr stack_ast_while.* stack_ast.dump.while
                else
                    panic pop
                fi fi fi fi fi fi fi
            end
            1 +
        pool pop
    end
end

func stack_ast.dump.params (int, string, array) () in -- indent, label, array<node>
    match indent label names in
        0 while dup names array.count < loop
            indent stack_ast.dump.pad
            label over int.show string.concat string.stdout ": " string.stdout
            dup names swp array.get unwrap stack_ast_node.* stack_ast_node.value string.stdout "\n" string.stdout
            1 +
        pool pop
    end
end

func stack_ast.dump.fields (int, array) () in -- indent, array<stack_ast_data_field>
    match indent fields in
        0 while dup fields array.count < loop
            dup fields swp array.get unwrap stack_ast_data_field.* match field in
                indent stack_ast.dump.pad
                field stack_ast_data_field.name stack_ast_node.value string.stdout ": " string.stdout
                field stack_ast_data_field.type stack_ast_node.value string.stdout "\n" string.stdout
            end
            1 +
        pool pop
    end
end

func stack_ast.dump (stack_ast) () in
    stack_ast.features match features in
        0 while dup features array.count < loop
            dup features swp array.get unwrap stack_ast_feature.* match feat in
                feat stack_ast_feature.kind
                dup STACK_AST_FEATURE_DATA = if
                    pop feat stack_ast_feature.feature stack_ast_data.* match node in
                        "data " string.stdout
                        node stack_ast_data.name stack_ast_node.value string.stdout
                        "\n" string.stdout

                        stack_ast.dump.indent node stack_ast_data.fields stack_ast.dump.fields
                        "\n" string.stdout
                    end
                else dup STACK_AST_FEATURE_FUNC = if
                    pop feat stack_ast_feature.feature stack_ast_func.* match node in
                        "func " string.stdout
                        node stack_ast_func.name stack_ast_node.value string.stdout
                        "\n" string.stdout

                        stack_ast.dump.indent "arg" node stack_ast_func.args stack_ast.dump.params
                        stack_ast.dump.indent "ret" node stack_ast_func.rets stack_ast.dump.params

                        stack_ast.dump.indent stack_ast.dump.pad "body:\n" string.stdout
                        stack_ast.dump.indent stack_ast.dump.indent + node stack_ast_func.exprs stack_ast.dump.exprs
                        "\n" string.stdout
                    end
                else dup STACK_AST_FEATURE_CONST = if
                    pop feat stack_ast_feature.feature stack_ast_const.* match node in
                        "const " string.stdout
                        node stack_ast_const.name stack_ast_node.value string.stdout
                        "\n" string.stdout

                        stack_ast.dump.indent node stack_ast_const.exprs stack_ast.dump.exprs
                        "\n" string.stdout
                    end
                else dup STACK_AST_FEATURE_IMPORT = if
                    pop feat stack_ast_feature.feature stack_ast_import.* match node in
                        "@import \"" string.stdout
                        node stack_ast_import.name stack_ast_node.value string.stdout
                        "\"\n\n" string.stdout
                    end
                else dup STACK_AST_FEATURE_EXTERN = if
                    pop feat stack_ast_feature.feature stack_ast_extern.* match node in
                        "extern " string.stdout
                        node stack_ast_extern.name stack_ast_node.value string.stdout
                        "\n" string.stdout

                        stack_ast.dump.indent "arg" node stack_ast_extern.args stack_ast.dump.params
                        stack_ast.dump.indent "ret" node stack_ast_extern.rets stack_ast.dump.params

                        stack_ast.dump.indent stack_ast.dump.pad "symbol: \"" string.stdout
                        node stack_ast_extern.symbol stack_ast_node.value string.stdout
                        "\"\n\n" string.stdout
                    end
                else
                    int.show string.stdout "\n" string.stdout
                    todo
                fi fi fi fi fi
            end
            1 +
        pool pop
    end
end

-- STACK ASSEMBLER

const STACK_LITERAL_NUMBER 0
const STACK_LITERAL_BOOLEAN 1
const STACK_LITERAL_STRING 2

data stack_literal (int kind, string value)

data stack_assembler (int fd, array bind_map, array func_map, array literal_map, int if_counter)

func stack_literal.= (stack_literal, stack_literal) (bool) in
    dup2 stack_literal.kind swp stack_literal.kind = rot' -- bool, l1, l2
    stack_literal.value swp stack_literal.value string.= and -- bool
end

func stack_assembler.init.with_fd (int) (stack_assembler) in
    string.sizeof array.init.with_sz
    string.sizeof array.init.with_sz
    stack_literal.sizeof array.init.with_sz
    0

    stack_assembler.init -- stack_assembler
end

func emit (stack_assembler, string) () in -- asm, s
    swp stack_assembler.fd swp -- fd, s
    "\n" string.concat -- fd, s
    stdlib.fwrite not if "cannot write assembly output" stack_io.error fi
end

func stack_assembler.bind.index (stack_assembler, string) (int) in -- asm, name
    swp stack_assembler.bind_map match name binds in
        0 while
            dup binds array.count < if
                dup binds swp array.get unwrap string.* name string.= not
            else
                false
            fi
        loop 1 + pool -- i

        dup binds array.count >= if pop -1 fi
    end
end

func stack_assembler.bind.append (stack_assembler, string) () in -- asm, name
    swp stack_assembler.bind_map -- string, array<string>
    swp string.& array.append unwrap
end

func stack_assembler.bind.pop (stack_assembler) () in -- asm
    stack_assembler.bind_map -- array<string>
    array.pop unwrap
end

func stack_assembler.func.name (stack_assembler, string) (string) in -- asm, name
    swp stack_assembler.func_map match name names in
        0 while
            dup names array.count < if
                dup names swp array.get unwrap string.* name string.= not
            else
                false
            fi
        loop 1 + pool -- i

        dup names array.count >= if names name string.& array.append unwrap fi
        int.show "func." swp string.concat -- string
    end
end

func stack_assembler.literal.name (stack_assembler, stack_literal) (string) in -- asm, value
    swp stack_assembler.literal_map match literal literals in
        0 while
            dup literals array.count < if
                dup literals swp array.get unwrap stack_literal.* literal stack_literal.= not
            else
                false
            fi
        loop 1 + pool -- i

        dup literals array.count >= if literals literal stack_literal.& array.append unwrap fi
        int.show "literal." swp string.concat -- string
    end
end

func stack_assembler.emit.expr.number (stack_assembler, stack_ast_node) () in -- asm, number
    swp dup rot -- asm, asm, node
    stack_ast_node.value dup2 -- asm, asm, value, asm, value
    STACK_LITERAL_NUMBER swp stack_literal.init -- asm, asm, value, asm, stack_literal
    stack_assembler.literal.name -- asm, asm, value, s
    "    mov     rdi, " swp string.concat " ; " string.concat swp string.concat emit

    dup "    call    stack_push_addr" emit

    pop
end

func stack_assembler.emit.expr.boolean (stack_assembler, stack_ast_node) () in -- asm, boolean
    swp dup rot -- asm, asm, node
    stack_ast_node.value dup2 -- asm, asm, value, asm, value
    STACK_LITERAL_BOOLEAN swp stack_literal.init -- asm, asm, value, asm, stack_literal
    stack_assembler.literal.name -- asm, asm, value, s
    "    mov     rdi, " swp string.concat " ; " string.concat swp string.concat emit

    dup "    call    stack_push_addr" emit

    pop
end

-- Keep printable ASCII and write all other bytes as \xHH.
func stack_assembler.comment.escape (string) (string) in -- s
    match s in
        "" 0 while -- result, i
            dup s string.len < loop -- result, i
            match r i in
                s i string.!! match b in
                    b BYTE_SPACE >= b BYTE_~ <= and if
                        r s i 1 string.substr string.concat
                    else
                        r "\\x" string.concat
                        "0123456789ABCDEF" b 16 / 1 string.substr string.concat
                        "0123456789ABCDEF" b 16 % 1 string.substr string.concat
                    fi
                end
                i 1 +
            end
        pool -- result, i
        pop
    end
end

func stack_assembler.emit.expr.string (stack_assembler, stack_ast_node) () in -- asm, string
    swp dup rot -- asm, asm, node
    stack_ast_node.value dup2 -- asm, asm, value, asm, value
    STACK_LITERAL_STRING swp stack_literal.init -- asm, asm, value, asm, stack_literal
    stack_assembler.literal.name -- asm, asm, value, s
    "    mov     rdi, " swp string.concat " ; " string.concat swp stack_assembler.comment.escape string.concat emit

    dup "    call    stack_push_addr" emit

    pop
end

func stack_assembler.emit.pretty_call (stack_assembler, string) (string) in -- asm, name
    -- string string asm
    dup rot swp -- string, asm, string
    stack_assembler.func.name -- name, string
    "    call    " swp string.concat -- name, "   call string"
    " ; " string.concat -- name, call
    swp string.concat
end

func stack_assembler.emit.push_bind (stack_assembler, int, string) () in -- asm, i, name
    swp 8 * 8 + -- asm, name, i*8+8
    int.show "    mov     rdi, qword [rbp - " swp string.concat "]" string.concat -- asm, name, s
    rot dup rot emit -- name, asm
    dup "    call    stack_push_addr" emit -- name, asm

    pop2
end

func stack_assembler.emit.expr.name (stack_assembler, stack_ast_node) () in -- asm, name
    dup2 -- ..., asm, name
    stack_ast_node.value -- ..., asm, "name
    stack_assembler.bind.index dup -- asm, name, i, i
    0 >= if -- asm, name, i
        dup3 swp stack_ast_node.value -- ..., asm, i, "name
        stack_assembler.emit.push_bind -- asm, name, i
        pop2 -- asm
    else
        pop -- asm, name
        dup2 stack_ast_node.value stack_assembler.emit.pretty_call swp pop -- asm, string
        swp dup rot emit -- asm
    fi -- asm

    pop
end

func stack_assembler.emit.expr.cond (stack_assembler, stack_ast_cond) () in -- asm, cond
    swp dup stack_assembler.if_counter 0 + -- cond, asm, if_count
    match cond asm counter in
        asm dup stack_assembler.if_counter 1 + stack_assembler.if_counter.set

        asm "    call    stack_pop" emit
        asm "    test    rax, rax" emit

        asm "    jnz     .if" counter int.show string.concat emit
        asm ".else" counter int.show string.concat ":" string.concat emit

        asm cond stack_ast_cond.else_ stack_assembler.emit.exprs

        asm "    jmp    .fi" counter int.show string.concat emit
        asm ".if" counter int.show string.concat ":" string.concat emit

        asm cond stack_ast_cond.if_ stack_assembler.emit.exprs

        asm ".fi" counter int.show string.concat ":" string.concat emit
    end
end

func stack_assembler.emit.expr.match.binds (stack_assembler, array) () in -- asm, array<node>
    match asm binds in
        0 while dup binds array.count < loop
            match i in
                asm "    call    stack_pop_addr" emit

                -- The first pop is the last bind. It takes the highest slot.
                asm stack_assembler.bind_map array.count binds array.count + i 2 * - 1 - 8 * 8 +
                int.show "    mov     qword [rbp - " swp string.concat "], rax" string.concat
                asm swp emit

                asm binds i array.get unwrap stack_ast_node.* stack_ast_node.value stack_assembler.bind.append
                i 1 +
            end
        pool pop
    end
end

func stack_assembler.emit.expr.match.binds_pop (stack_assembler, array) () in -- asm, array<node>
    match asm binds in
        0 while dup binds array.count < loop
            asm stack_assembler.bind.pop
            1 +
        pool pop
    end
end

func stack_assembler.emit.expr.match (stack_assembler, stack_ast_match) () in -- asm, match
    match asm node in
        node stack_ast_match.binds match binds in
            asm "    sub     rsp, " binds array.count 8 * int.show string.concat emit
            asm binds stack_assembler.emit.expr.match.binds

            asm node stack_ast_match.exprs stack_assembler.emit.exprs

            asm "    add     rsp, " binds array.count 8 * int.show string.concat emit
            asm binds stack_assembler.emit.expr.match.binds_pop
        end
    end
end

func stack_assembler.emit.expr.while (stack_assembler, stack_ast_while) () in -- asm, while
    swp dup stack_assembler.if_counter 0 + -- while asm if_count
    match ast asm counter in
        asm dup stack_assembler.if_counter 1 + stack_assembler.if_counter.set

        asm ".while" counter int.show string.concat ":" string.concat emit

        asm ast stack_ast_while.while_ stack_assembler.emit.exprs

        asm "    call    stack_pop" emit
        asm "    test    rax, rax" emit

        asm "    jz     .pool" counter int.show string.concat emit

        asm ".loop" counter int.show string.concat ":" string.concat emit

        asm ast stack_ast_while.exprs stack_assembler.emit.exprs

        asm "    jmp     .while" counter int.show string.concat emit
        asm ".pool" counter int.show string.concat ":" string.concat emit
    end
end

func stack_assembler.emit.expr (stack_assembler, stack_ast_expr) () in -- asm, expr
    dup stack_ast_expr.kind  -- asm, expr, kind
    dup STACK_AST_EXPR_NUMBER = if -- asm, expr, kind
        pop stack_ast_expr.expr stack_ast_node.* stack_assembler.emit.expr.number
    else dup STACK_AST_EXPR_BOOLEAN = if -- asm, expr, kind
        pop stack_ast_expr.expr stack_ast_node.* stack_assembler.emit.expr.boolean
    else dup STACK_AST_EXPR_STRING = if -- asm, expr, kind
        pop stack_ast_expr.expr stack_ast_node.* stack_assembler.emit.expr.string
    else dup STACK_AST_EXPR_NAME = if -- asm, expr, kind
        pop stack_ast_expr.expr stack_ast_node.* stack_assembler.emit.expr.name
    else dup STACK_AST_EXPR_COND = if -- asm, expr, kind
        pop stack_ast_expr.expr stack_ast_cond.* stack_assembler.emit.expr.cond
    else dup STACK_AST_EXPR_MATCH = if -- asm, expr, kind
        pop stack_ast_expr.expr stack_ast_match.* stack_assembler.emit.expr.match
    else dup STACK_AST_EXPR_WHILE = if -- asm, expr, kind
        pop stack_ast_expr.expr stack_ast_while.* stack_assembler.emit.expr.while
    else
        panic pop3
    fi fi fi fi fi fi fi -- ()
end

func stack_assembler.emit.exprs (stack_assembler, array) () in -- asm, array<expr>
    match asm exprs in
        0 while dup exprs array.count < loop
            asm over exprs swp array.get unwrap stack_ast_expr.* stack_assembler.emit.expr
            1 +
        pool pop
    end
end

func stack_assembler.emit.pretty_func (stack_assembler, string) (string) in -- asm, name
    -- string string asm
    dup rot swp -- string, asm, string
    stack_assembler.func.name -- name, string
    ":" string.concat -- name, string
    " ; " string.concat -- name, string
    swp string.concat
end

func stack_assembler.emit.func (stack_assembler, stack_ast_func) () in -- asm, func
    dup stack_ast_func.name -- asm, func, node
    stack_ast_node.value -- asm, func, string

    swp rot' -- func, asm, string
    dup2 stack_assembler.emit.pretty_func swp pop -- func, asm, label
    swp rot -- label, asm, func

    swp
    dup rot4                    emit
    dup "    push    rbp"       emit
    dup "    mov     rbp, rsp"  emit
    dup ""                      emit

    dup2 swp stack_ast_func.exprs stack_assembler.emit.exprs

    dup ""                      emit
    dup "    pop     rbp"       emit
    dup "    ret"               emit
    dup ""                      emit

    pop2
end

func stack_assembler.emit.data (stack_assembler, stack_ast_data) () in -- asm, data
    dup stack_ast_data.name -- asm, data, node
    stack_ast_node.value ".*" string.concat -- asm, data, string
    rot dup rot4' swp stack_assembler.func.name ":" string.concat rot' -- label, asm, data

    swp
    dup rot4                            emit
    dup "    push    rbp"               emit
    dup "    mov     rbp, rsp"          emit
    dup ""                              emit
    dup "    ; ref data"                emit
    dup "    call    stack_pop"         emit
    dup "    mov     rdi, rax"          emit
    dup "    call    stack_push_addr"   emit
    dup ""                              emit
    dup "    pop     rbp"               emit
    dup "    ret"                       emit
    dup ""                              emit

    swp -- asm, data

    dup stack_ast_data.name -- asm, data, node
    stack_ast_node.value ".&" string.concat -- asm, data, string
    rot dup rot4' swp stack_assembler.func.name ":" string.concat rot' -- label, asm, data

    swp
    dup rot4                            emit
    dup "    push    rbp"               emit
    dup "    mov     rbp, rsp"          emit
    dup ""                              emit
    dup "    ; ref data"                emit
    dup "    call    stack_pop_addr"    emit
    dup "    mov     rdi, rax"          emit
    dup "    call    stack_push"        emit
    dup ""                              emit
    dup "    pop     rbp"               emit
    dup "    ret"                       emit
    dup ""                              emit

    swp -- asm, data

    pop2
end

func stack_assembler.emit.feature (stack_assembler, stack_ast_feature) () in -- asm, feature
    dup stack_ast_feature.kind
    dup STACK_AST_FEATURE_DATA = if -- asm, feat, kind
        pop stack_ast_feature.feature stack_ast_data.* stack_assembler.emit.data
    else dup STACK_AST_FEATURE_FUNC = if
        pop stack_ast_feature.feature stack_ast_func.* stack_assembler.emit.func
    else dup STACK_AST_FEATURE_CONST = if
        pop3 -- nothing to do for const in asm
    else dup STACK_AST_FEATURE_IMPORT = if
        pop3 -- nothing to do for import in asm
    else
        todo pop3
    fi fi fi fi -- ()
end

func stack_assembler.emit.ast (stack_assembler, stack_ast) () in -- asm, prog
    stack_ast.features match asm features in
        asm "section '.text' executable" emit
        asm ""                           emit

        0 while dup features array.count < loop
            asm over features swp array.get unwrap stack_ast_feature.* stack_assembler.emit.feature
            1 +
        pool pop
    end
end
func stack_assembler.emit.literal.string.helper (string, string) (string) in -- str, value
    match prefix value in
        value string.len 0 = if
            prefix "0" string.concat
        else
            prefix
            "" 0 while dup value string.len < loop -- bytes, i
                match bytes i in
                    bytes i 0 > if "," string.concat fi
                    value i string.!! int.show string.concat
                    i 1 +
                end
            pool pop
            ",0" int.sizeof value string.len int.sizeof mod - string.repeat -- str, bytes, padding
            string.concat string.concat
        fi -- string
    end
end

func stack_assembler.emit.literal (stack_assembler, stack_literal, int) () in -- asm, literal, i
    swp dup stack_literal.value rot int.show -- asm, literal, value, id
    match asm literal value id in
        literal stack_literal.kind
        dup STACK_LITERAL_NUMBER = if
            pop asm "literal." id string.concat " dq " string.concat value string.concat emit
        else dup STACK_LITERAL_BOOLEAN = if
            pop asm "literal." id string.concat " dq " string.concat
            value "true" string.= if "1" else "0" fi string.concat emit
        else dup STACK_LITERAL_STRING = if
            pop value stack_string.interpret match bytes in
                asm "literal." id string.concat " dq " string.concat bytes string.len int.show string.concat emit
                asm "          dq string." id string.concat emit
                asm "string." id string.concat " db " string.concat bytes stack_assembler.emit.literal.string.helper emit
            end
        else
            panic pop
        fi fi fi
    end
end

func stack_assembler.emit.literals (stack_assembler) () in -- asm
    dup stack_assembler.literal_map match asm literals in
        asm "section '.data'" emit
        asm "" emit

        0 while dup literals array.count < loop
            asm over literals swp array.get unwrap stack_literal.* 2 pick int.* stack_assembler.emit.literal
            1 +
        pool pop
    end
end

func stack_assembler.emit (stack_assembler, stack_ast) () in -- asm, ast
    swp
    dup "format ELF64" emit
    dup ""             emit

    dup stack_assembler.emit.allocator
    dup stack_assembler.emit.entry
    dup stack_assembler.emit.keywords
    swp dup2 stack_assembler.emit.ast
    swp dup stack_assembler.emit.literals

    pop2
end

data stack_args
    ( string filename
    , bool lexer
    , bool parser
    , bool preprocessor
    , bool typecheck
    , bool assembler
    )

func stack_args.init.empty () (stack_args) in
    "" false false false false false stack_args.init
end

func stack_args.usage () () in
    "usage: slc [option] [input]\n" string.stdout
    "stack lang compiler\n" string.stdout
    "\n" string.stdout
    "options:\n" string.stdout
    "  -h, --help\n" string.stdout
    "      print this help message\n" string.stdout
    "\n" string.stdout
    "  -l, --lexer\n" string.stdout
    "      flag to stop on the lexer phase\n" string.stdout
    "\n" string.stdout
    "  -p, --parser\n" string.stdout
    "      flag to stop on the parser phase\n" string.stdout
    "\n" string.stdout
    "  -P, --preprocessor\n" string.stdout
    "      flag to stop on the preprocessor phase\n" string.stdout
    "\n" string.stdout
    "  -t, --typecheck\n" string.stdout
    "      flag to stop on the typecheck phase\n" string.stdout
    "\n" string.stdout
    "  -a, --assembler\n" string.stdout
    "      flag to stop on the assembler phase\n" string.stdout
    "\n" string.stdout
    "  i, input\n" string.stdout
    "      the input file\n" string.stdout
    "\n" string.stdout
end

func stack_args.parse (int, ptr) (stack_args) in -- argc, argv
    swp dup ptr.sizeof rot4 array.init stack_args.init.empty match argv args in
        1 while dup argv array.count < loop
            dup argv swp array.get unwrap ptr.* string.init.cstr match arg in
                arg "--help" string.= arg "-h" string.= or if
                    stack_args.usage 0 sys.exit
                else arg "--lexer" string.= arg "-l" string.= or if
                    args true stack_args.lexer.set
                else arg "--parser" string.= arg "-p" string.= or if
                    args true stack_args.parser.set
                else arg "--preprocessor" string.= arg "-P" string.= or if
                    args true stack_args.preprocessor.set
                else arg "--typecheck" string.= arg "-t" string.= or if
                    args true stack_args.typecheck.set
                else arg "--assembler" string.= arg "-a" string.= or if
                    args true stack_args.assembler.set
                else
                    args stack_args.filename string.len 0 > if
                        stack_args.usage
                        "Got unexpected CLI argument: `" arg string.concat "`\n" string.concat string.stderr
                        1 sys.exit
                    else
                        args arg stack_args.filename.set
                    fi
                fi fi fi fi fi fi
            end
            1 +
        pool pop
        args
    end
end

func stack_io.error (string) () in -- message
    "I/O error: " swp string.concat "\n" string.concat string.stderr
    1 sys.exit
end

func stack_io.read.source (string) (string, stack_file_id) in -- filename
    match filename in
        filename string.len 0 = if
            STDIN "standard input"
        else
            filename "r" stdlib.fopen unwrap
            "source file \"" filename string.concat "\"" string.concat
        fi -- fd, source

        filename string.len 0 > -- fd, source, owned

        match fd source owned in
            fd 0 < if "cannot open " source string.concat stack_io.error fi
            fd stdlib.fidentity match dev ino ok in
                ok not if
                    owned if fd stdlib.fclose pop fi
                    "cannot stat " source string.concat stack_io.error
                fi
                fd stdlib.fread.<eof> not if
                    owned if fd stdlib.fclose pop fi
                    "cannot read " source string.concat stack_io.error
                fi
                owned if
                    fd stdlib.fclose not if "cannot close " source string.concat stack_io.error fi
                fi
                dev ino stack_file_id.init
            end
        end
    end
end

func main (int, ptr) (int) in -- argc, argv
    stack_args.parse -- args

    dup stack_args.filename stack_io.read.source -- args, string, id
    stack_preprocessor.init.with_main rot' -- pre, args, string
    swp dup stack_args.filename -- string, args, fname
    dup string.len 0 = if pop "stdin" fi -- string, args, fname
    swp rot' -- args, string, filename
    stack_lexer.init.with_buffer -- args, stack_lexer

    swp dup stack_args.lexer if  -- stack_lexer, args
        swp dup stack_lexer.dump -- args, stack_lexer
        0 sys.exit swp
    fi swp -- args, stack_lexer

    stack_parser.init.with_lexer -- args, stack_parser
    dup stack_parser.parse -- args, stack_parser, stack_ast, ok
    not if over stack_parser.diag stack_diagnostic.stderr 1 sys.exit fi
    swp pop -- args, stack_ast

    swp dup stack_args.parser if -- stack_ast, args
        swp dup stack_ast.dump -- args, stack_lexer
        0 sys.exit swp
    fi swp -- args, stack_ast

    rot dup rot4' -- pre, args, ast, pre
    over stack_preprocessor.run -- pre, args, ast
    rot dup stack_preprocessor.diag match pre diag in
        diag stack_diagnostic.failed if diag stack_diagnostic.stderr 1 sys.exit fi
        pre
    end rot' -- pre, args, ast

    swp dup stack_args.preprocessor if -- stack_ast, args
        swp dup stack_ast.dump -- args, stack_lexer
        0 sys.exit swp
    fi swp -- args, stack_ast

    stack_context.init.base -- args, ast, ctx
    dup2 swp stack_context.typecheck -- args, ast, ctx
    stack_context.ok not if
        1 sys.exit
    fi -- args, ast

    swp dup stack_args.typecheck if -- ast, args
        0 sys.exit
    fi swp -- args, ast

    STDOUT stack_assembler.init.with_fd -- args, stack_ast, asm
    swp stack_assembler.emit -- args

    dup stack_args.assembler if -- args
        0 sys.exit
    fi -- args

    -- TODO: fasm stage
    -- TODO: ld stage

    pop2

    0
end

func stack_assembler.emit.entry (stack_assembler) () in
    dup "section '.data' writeable" emit
    dup "" emit
    dup "stack_env dq 0" emit
    dup "" emit
    dup "; Define some constants" emit
    dup "loc_0 = 8" emit
    dup "loc_1 = 16" emit
    dup "loc_2 = 24" emit
    dup "loc_3 = 32" emit
    dup "loc_4 = 40" emit
    dup "loc_5 = 48" emit
    dup "loc_6 = 56" emit
    dup "loc_7 = 64" emit
    dup "" emit
    dup "arg_0 = 16" emit
    dup "arg_1 = 24" emit
    dup "arg_2 = 32" emit
    dup "arg_3 = 40" emit
    dup "arg_4 = 48" emit
    dup "arg_5 = 56" emit
    dup "arg_6 = 64" emit
    dup "arg_7 = 72" emit
    dup "" emit
    dup "; Define entry point" emit
    dup "section '.text' executable" emit
    dup "public _start" emit
    dup "_start:" emit
    dup "    ; Initialize the memory" emit
    dup "    call allocator_init" emit
    dup "" emit
    dup "    ; store argc on the stack" emit
    dup "    mov     rdi, qword [rsp]" emit
    dup "    call    stack_push" emit
    dup "" emit
    dup "    ; store argv on the stack" emit
    dup "    mov     rdi, rsp" emit
    dup "    add     rdi, 8" emit
    dup "    call    stack_push" emit
    dup "" emit
    dup "    ; store env in stack_env" emit
    dup "    mov     rax, qword [rsp]" emit
    dup "    shl     rax, 3" emit
    dup "    mov     rdi, rsp" emit
    dup "    add     rdi, 8" emit
    dup "    add     rdi, rax" emit
    dup "    add     rdi, 8" emit
    dup "    mov     qword [stack_env], rdi" emit
    dup "" emit
    dup "    ; Call the main method" emit
    dup STACK_FUNC_MAIN stack_assembler.emit.pretty_call swp dup rot emit -- asm
    dup "" emit
    dup "    ; Exit the program" emit
    dup "    call    stack_pop" emit
    dup "    mov     rdi, rax" emit
    dup "    mov     rax, 60" emit
    dup "    syscall" emit
    dup "" emit

    pop
end

func stack_assembler.emit.allocator (stack_assembler) () in
    dup "section '.data' writeable" emit
    dup "" emit

    dup "; memory layout" emit
    dup "stack_pos dq 0" emit
    dup "stack_end dq 0" emit
    dup "heap_base dq 0" emit
    dup "heap_top dq 0" emit
    dup "heap_end dq 0" emit
    dup "cell_pos dq 0" emit
    dup "cell_end dq 0" emit
    dup "free_list dq 0" emit
    dup "" emit
    dup "alloc_oom_msg db 'Runtime error: out of memory', 10" emit
    dup "alloc_oom_len = $ - alloc_oom_msg" emit
    dup "alloc_negative_msg db 'Runtime error: negative allocation size', 10" emit
    dup "alloc_negative_len = $ - alloc_negative_msg" emit
    dup "alloc_invalid_msg db 'Runtime error: invalid free', 10" emit
    dup "alloc_invalid_len = $ - alloc_invalid_msg" emit
    dup "alloc_double_msg db 'Runtime error: double free', 10" emit
    dup "alloc_double_len = $ - alloc_double_msg" emit
    dup "" emit
    dup "STACK_SIZE = 0x10000" emit
    dup "CELL_CHUNK_SIZE = 0x10000" emit
    dup "HEAP_GROW_SIZE = 0x100000" emit
    dup "" emit

    dup "section '.text' executable" emit
    dup "" emit

    dup ";" emit
    dup ";" emit
    dup "; allocator_init" emit
    dup ";" emit
    dup ";   INPUT: nothing" emit
    dup ";   OUTPUT: nothing" emit
    dup "allocator_init:" emit
    dup "    push    rbp                        ; save return address" emit
    dup "    mov     rbp, rsp                   ; set up stack frame" emit
    dup "" emit
    dup "    ; initialize the heap" emit
    dup "    mov     rax, 12                    ; brk" emit
    dup "    mov     rdi, 0                     ; increment = 0" emit
    dup "    syscall" emit
    dup "    mov     [heap_end], rax            ; save the end of the heap" emit
    dup "    add     rax, 7" emit
    dup "    and     rax, -8" emit
    dup "    mov     [heap_top], rax            ; align the top of the heap" emit
    dup "" emit
    dup "    ; allocate the stack 64K" emit
    dup "    mov     rdi, STACK_SIZE" emit
    dup "    call    heap_take" emit
    dup "    mov     [stack_pos], rax           ; save the current position of the stack" emit
    dup "    add     rax, STACK_SIZE" emit
    dup "    mov     [stack_end], rax           ; save the end of the stack" emit
    dup "" emit
    dup "    ; blocks and cell chunks come after the stack" emit
    dup "    mov     [heap_base], rax" emit
    dup "    mov     [cell_pos], rax" emit
    dup "    mov     [cell_end], rax" emit
    dup "" emit
    dup "    pop     rbp                        ; restore return address" emit
    dup "    ret" emit
    dup "" emit

    dup ";" emit
    dup ";" emit
    dup "; stack push addr" emit
    dup ";" emit
    dup ";   INPUT: rdi contains the int64 (pointer) that we add to the stack" emit
    dup ";   OUTPUT: nothing" emit
    dup ";" emit
    dup "stack_push_addr:" emit
    dup "    push    rbp                        ; save return address" emit
    dup "    mov     rbp, rsp                   ; set up stack frame" emit
    dup "" emit
    dup "    mov     rsi, qword [stack_pos]" emit
    dup "    mov     qword [rsi], rdi" emit
    dup "    add     qword [stack_pos], 8" emit
    dup "" emit
    dup "    pop     rbp                        ; restore return address" emit
    dup "    ret" emit
    dup "" emit

    dup ";" emit
    dup ";" emit
    dup "; stack push" emit
    dup ";" emit
    dup ";   INPUT: rdi contains the int64 (pointer) that we add to the stack" emit
    dup ";   OUTPUT: nothing" emit
    dup ";" emit
    dup "stack_push:" emit
    dup "    push    rbp                        ; save return address" emit
    dup "    mov     rbp, rsp                   ; set up stack frame" emit
    dup "" emit
    dup "    mov     rax, qword [cell_pos]" emit
    dup "    cmp     rax, qword [cell_end]" emit
    dup "    jb      .push_cell" emit
    dup "" emit
    dup "    push    rdi" emit
    dup "    mov     rdi, CELL_CHUNK_SIZE" emit
    dup "    call    heap_take                  ; start a new cell chunk" emit
    dup "    pop     rdi" emit
    dup "    lea     rsi, [rax + CELL_CHUNK_SIZE]" emit
    dup "    mov     qword [cell_end], rsi" emit
    dup "" emit
    dup ".push_cell:" emit
    dup "    mov     qword [rax], rdi" emit
    dup "    lea     rsi, [rax + 8]" emit
    dup "    mov     qword [cell_pos], rsi" emit
    dup "" emit
    dup "    mov     rsi, qword [stack_pos]" emit
    dup "    mov     qword [rsi], rax" emit
    dup "    add     qword [stack_pos], 8" emit
    dup "" emit
    dup "    pop     rbp                        ; restore return address" emit
    dup "    ret" emit
    dup "" emit

    dup ";" emit
    dup ";" emit
    dup "; stack peek addr" emit
    dup ";" emit
    dup ";   INPUT: nothing" emit
    dup ";   OUTPUT: rax contains the int64 (pointer) that we pop from the stack" emit
    dup ";" emit
    dup "stack_peek_addr:" emit
    dup "    push    rbp                        ; save return address" emit
    dup "    mov     rbp, rsp                   ; set up stack frame" emit
    dup "" emit
    dup "    mov     rax, qword [stack_pos]" emit
    dup "    mov     rax, qword [rax - 8]" emit
    dup "" emit
    dup "    pop     rbp                        ; restore return address" emit
    dup "    ret" emit
    dup "" emit

    dup ";" emit
    dup ";" emit
    dup "; stack peek" emit
    dup ";" emit
    dup ";   INPUT: nothing" emit
    dup ";   OUTPUT: rax contains the int64 (pointer) that we pop from the stack" emit
    dup ";" emit
    dup "stack_peek:" emit
    dup "    push    rbp                        ; save return address" emit
    dup "    mov     rbp, rsp                   ; set up stack frame" emit
    dup "" emit
    dup "    mov     rax, qword [stack_pos]" emit
    dup "    mov     rax, qword [rax - 8]" emit
    dup "    mov     rax, qword [rax]" emit
    dup "" emit
    dup "    pop     rbp                        ; restore return address" emit
    dup "    ret" emit
    dup "" emit

    dup ";" emit
    dup ";" emit
    dup "; stack pop addr" emit
    dup ";" emit
    dup ";   INPUT: nothing" emit
    dup ";   OUTPUT: rax contains the int64 (pointer) that we pop from the stack" emit
    dup ";" emit
    dup "stack_pop_addr:" emit
    dup "    push    rbp                        ; save return address" emit
    dup "    mov     rbp, rsp                   ; set up stack frame" emit
    dup "" emit
    dup "    mov     rax, qword [stack_pos]" emit
    dup "    mov     rax, qword [rax - 8]" emit
    dup "    sub     qword [stack_pos], 8" emit
    dup "" emit
    dup "    pop     rbp                        ; restore return address" emit
    dup "    ret" emit
    dup "" emit

    dup ";" emit
    dup ";" emit
    dup "; stack pop" emit
    dup ";" emit
    dup ";   INPUT: nothing" emit
    dup ";   OUTPUT: rax contains the int64 (pointer) that we pop from the stack" emit
    dup ";" emit
    dup "stack_pop:" emit
    dup "    push    rbp                        ; save return address" emit
    dup "    mov     rbp, rsp                   ; set up stack frame" emit
    dup "" emit
    dup "    mov     rax, qword [stack_pos]" emit
    dup "    mov     rax, qword [rax - 8]" emit
    dup "    mov     rax, qword [rax]" emit
    dup "    sub     qword [stack_pos], 8" emit
    dup "" emit
    dup "    pop     rbp                        ; restore return address" emit
    dup "    ret" emit
    dup "" emit

    dup ";" emit
    dup ";" emit
    dup "; stack pick" emit
    dup ";" emit
    dup ";   INPUT: rdi contains the index" emit
    dup ";   OUTPUT: rax contains the int64 (pointer) that we pick from the stack" emit
    dup ";" emit
    dup "stack_pick_addr:" emit
    dup "    push    rbp                        ; save return address" emit
    dup "    mov     rbp, rsp                   ; set up stack frame" emit
    dup "" emit
    dup "    mov     rax, qword [stack_pos]" emit
    dup "    shl     rdi, 3 ; multiply index with 8" emit
    dup "    sub     rax, rdi ; offset stack_pos with index*8" emit
    dup "    mov     rax, qword [rax - 8]" emit
    dup "" emit
    dup "    pop     rbp                        ; restore return address" emit
    dup "    ret" emit
    dup "" emit

    dup ";" emit
    dup ";" emit
    dup "; heap take" emit
    dup ";" emit
    dup ";   INPUT: rdi contains the size in bytes (multiple of 8)" emit
    dup ";   OUTPUT: rax points to new memory at the top of the heap" emit
    dup ";" emit
    dup "heap_take:" emit
    dup "    push    rbp                        ; save return address" emit
    dup "    mov     rbp, rsp                   ; set up stack frame" emit
    dup "    push    rcx" emit
    dup "    push    rdx" emit
    dup "    push    rdi" emit
    dup "    push    r11" emit
    dup "" emit
    dup "    mov     rdx, qword [heap_top]" emit
    dup "    add     rdx, rdi                   ; new top of the heap" emit
    dup "    jc      alloc_oom" emit
    dup "    cmp     rdx, qword [heap_end]" emit
    dup "    jbe     .take_ok" emit
    dup "" emit
    dup "    mov     rdi, rdx" emit
    dup "    add     rdi, HEAP_GROW_SIZE - 1" emit
    dup "    jc      alloc_oom" emit
    dup "    and     rdi, -HEAP_GROW_SIZE       ; new end of the heap" emit
    dup "    mov     rax, 12                    ; brk" emit
    dup "    syscall" emit
    dup "    cmp     rax, rdi                   ; brk returns the old end on failure" emit
    dup "    jb      alloc_oom" emit
    dup "    mov     qword [heap_end], rax" emit
    dup "" emit
    dup ".take_ok:" emit
    dup "    mov     rax, qword [heap_top]" emit
    dup "    mov     qword [heap_top], rdx" emit
    dup "" emit
    dup "    pop     r11" emit
    dup "    pop     rdi" emit
    dup "    pop     rdx" emit
    dup "    pop     rcx" emit
    dup "    pop     rbp                        ; restore return address" emit
    dup "    ret" emit
    dup "" emit

    dup ";" emit
    dup ";" emit
    dup "; allocate" emit
    dup ";" emit
    dup ";   INPUT: rdi contains the size in bytes" emit
    dup ";   OUTPUT: rax points to the newly allocated zeroed memory" emit
    dup ";" emit
    dup ";   A block has an 8 byte header with the block size and bit 0 set when" emit
    dup ";   allocated. A free block keeps the next free block in its first 8 bytes." emit
    dup ";" emit
    dup "allocate:" emit
    dup "    push    rbp                        ; save return address" emit
    dup "    mov     rbp, rsp                   ; set up stack frame" emit
    dup "    push    rcx" emit
    dup "    push    rdx" emit
    dup "    push    rsi" emit
    dup "    push    rdi" emit
    dup "    push    r8" emit
    dup "" emit
    dup "    test    rdi, rdi" emit
    dup "    js      alloc_negative" emit
    dup "    add     rdi, 15" emit
    dup "    and     rdi, -8                    ; block size with header" emit
    dup "    cmp     rdi, 16" emit
    dup "    jae     .alloc_sized" emit
    dup "    mov     rdi, 16                    ; at least 8 bytes of memory" emit
    dup ".alloc_sized:" emit
    dup "" emit
    dup "    ; first fit in the free list" emit
    dup "    xor     esi, esi                   ; previous free block" emit
    dup "    mov     rax, qword [free_list]" emit
    dup ".alloc_find:" emit
    dup "    test    rax, rax" emit
    dup "    jz      .alloc_fresh" emit
    dup "    mov     rdx, qword [rax]" emit
    dup "    cmp     rdx, rdi" emit
    dup "    jae     .alloc_found" emit
    dup "    mov     rsi, rax" emit
    dup "    mov     rax, qword [rax + 8]" emit
    dup "    jmp     .alloc_find" emit
    dup "" emit
    dup ".alloc_found:" emit
    dup "    mov     rcx, qword [rax + 8]       ; next free block" emit
    dup "    sub     rdx, rdi" emit
    dup "    cmp     rdx, 16" emit
    dup "    jb      .alloc_whole" emit
    dup "    lea     r8, [rax + rdi]            ; split the rest into a free block" emit
    dup "    mov     qword [r8], rdx" emit
    dup "    mov     qword [r8 + 8], rcx" emit
    dup "    mov     rcx, r8" emit
    dup "    jmp     .alloc_unlink" emit
    dup ".alloc_whole:" emit
    dup "    add     rdi, rdx                   ; use the whole free block" emit
    dup ".alloc_unlink:" emit
    dup "    test    rsi, rsi" emit
    dup "    jz      .alloc_head" emit
    dup "    mov     qword [rsi + 8], rcx" emit
    dup "    jmp     .alloc_clear" emit
    dup ".alloc_head:" emit
    dup "    mov     qword [free_list], rcx" emit
    dup ".alloc_clear:" emit
    dup "    lea     rcx, [rax + 8]" emit
    dup "    lea     rdx, [rax + rdi]" emit
    dup ".alloc_clear_next:" emit
    dup "    mov     qword [rcx], 0" emit
    dup "    add     rcx, 8" emit
    dup "    cmp     rcx, rdx" emit
    dup "    jb      .alloc_clear_next" emit
    dup "    jmp     .alloc_ok" emit
    dup "" emit
    dup ".alloc_fresh:" emit
    dup "    call    heap_take                  ; new memory is already zero" emit
    dup "" emit
    dup ".alloc_ok:" emit
    dup "    or      rdi, 1" emit
    dup "    mov     qword [rax], rdi" emit
    dup "    add     rax, 8" emit
    dup "" emit
    dup "    pop     r8" emit
    dup "    pop     rdi" emit
    dup "    pop     rsi" emit
    dup "    pop     rdx" emit
    dup "    pop     rcx" emit
    dup "    pop     rbp                        ; restore return address" emit
    dup "    ret" emit
    dup "" emit

    dup ";" emit
    dup ";" emit
    dup "; deallocate" emit
    dup ";" emit
    dup ";   INPUT: rdi points to memory from allocate, or is 0" emit
    dup ";   OUTPUT: nothing" emit
    dup ";" emit
    dup ";   The free list is sorted by address. Adjacent free blocks are merged." emit
    dup ";" emit
    dup "deallocate:" emit
    dup "    push    rbp                        ; save return address" emit
    dup "    mov     rbp, rsp                   ; set up stack frame" emit
    dup "    push    rax" emit
    dup "    push    rcx" emit
    dup "    push    rdx" emit
    dup "    push    rsi" emit
    dup "    push    rdi" emit
    dup "    push    r8" emit
    dup "" emit
    dup "    test    rdi, rdi" emit
    dup "    jz      .free_done" emit
    dup "    test    rdi, 7" emit
    dup "    jnz     alloc_invalid_free" emit
    dup "    sub     rdi, 8                     ; block header" emit
    dup "    cmp     rdi, qword [heap_base]" emit
    dup "    jb      alloc_invalid_free" emit
    dup "    mov     rax, qword [heap_top]" emit
    dup "    sub     rax, rdi                   ; bytes from the block to the heap top" emit
    dup "    jb      alloc_invalid_free" emit
    dup "    cmp     rax, 16" emit
    dup "    jb      alloc_invalid_free" emit
    dup "    mov     rdx, qword [rdi]" emit
    dup "    mov     rcx, rdx" emit
    dup "    and     rcx, -8                    ; block size" emit
    dup "    cmp     rcx, 16" emit
    dup "    jb      alloc_invalid_free" emit
    dup "    cmp     rcx, rax" emit
    dup "    ja      alloc_invalid_free" emit
    dup "    test    rdx, 6" emit
    dup "    jnz     alloc_invalid_free" emit
    dup "    test    rdx, 1" emit
    dup "    jz      alloc_double_free" emit
    dup "" emit
    dup "    ; find the free blocks before and after the block" emit
    dup "    xor     esi, esi                   ; previous free block" emit
    dup "    mov     rax, qword [free_list]     ; next free block" emit
    dup ".free_find:" emit
    dup "    test    rax, rax" emit
    dup "    jz      .free_check" emit
    dup "    cmp     rax, rdi" emit
    dup "    jae     .free_check" emit
    dup "    mov     rsi, rax" emit
    dup "    mov     rax, qword [rax + 8]" emit
    dup "    jmp     .free_find" emit
    dup "" emit
    dup ".free_check:" emit
    dup "    test    rsi, rsi" emit
    dup "    jz      .free_check_next" emit
    dup "    mov     rdx, qword [rsi]" emit
    dup "    add     rdx, rsi" emit
    dup "    cmp     rdx, rdi" emit
    dup "    ja      alloc_double_free          ; the block is inside a free block" emit
    dup ".free_check_next:" emit
    dup "    test    rax, rax" emit
    dup "    jz      .free_merge_prev" emit
    dup "    lea     rdx, [rdi + rcx]" emit
    dup "    cmp     rdx, rax" emit
    dup "    ja      alloc_invalid_free         ; the block overlaps a free block" emit
    dup "    jb      .free_merge_prev" emit
    dup "    add     rcx, qword [rax]           ; merge with the next free block" emit
    dup "    mov     rax, qword [rax + 8]" emit
    dup "" emit
    dup ".free_merge_prev:" emit
    dup "    test    rsi, rsi" emit
    dup "    jz      .free_head" emit
    dup "    mov     rdx, qword [rsi]" emit
    dup "    lea     r8, [rsi + rdx]" emit
    dup "    cmp     r8, rdi" emit
    dup "    jne     .free_after" emit
    dup "    add     rdx, rcx                   ; merge with the previous free block" emit
    dup "    mov     qword [rsi], rdx" emit
    dup "    mov     qword [rsi + 8], rax" emit
    dup "    jmp     .free_done" emit
    dup ".free_after:" emit
    dup "    mov     qword [rsi + 8], rdi" emit
    dup "    jmp     .free_link" emit
    dup ".free_head:" emit
    dup "    mov     qword [free_list], rdi" emit
    dup ".free_link:" emit
    dup "    mov     qword [rdi], rcx" emit
    dup "    mov     qword [rdi + 8], rax" emit
    dup "" emit
    dup ".free_done:" emit
    dup "    pop     r8" emit
    dup "    pop     rdi" emit
    dup "    pop     rsi" emit
    dup "    pop     rdx" emit
    dup "    pop     rcx" emit
    dup "    pop     rax" emit
    dup "    pop     rbp                        ; restore return address" emit
    dup "    ret" emit
    dup "" emit

    dup ";" emit
    dup ";" emit
    dup "; allocator errors write a message and exit with status 1" emit
    dup ";" emit
    dup "alloc_oom:" emit
    dup "    mov     rsi, alloc_oom_msg" emit
    dup "    mov     rdx, alloc_oom_len" emit
    dup "    jmp     alloc_abort" emit
    dup "alloc_negative:" emit
    dup "    mov     rsi, alloc_negative_msg" emit
    dup "    mov     rdx, alloc_negative_len" emit
    dup "    jmp     alloc_abort" emit
    dup "alloc_invalid_free:" emit
