                            exprs parser
                            prev stack_ast_data_field.type stack_ast_node.value
                            "." string.concat STACK_SIZEOF string.concat
                            stack_preprocessor.run.generate.data.call
                            exprs parser
                            prefix prev stack_ast_data_field.name stack_ast_node.value string.concat
                            "." string.concat STACK_OFFSET string.concat
                            stack_preprocessor.run.generate.data.call
                        end
