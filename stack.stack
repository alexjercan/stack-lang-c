data stack_const_graph (array consts, array states, array path) -- array<ptr>, array<int>, array<int>

const STACK_CONST_UNVISITED 0
const STACK_CONST_ACTIVE 1
const STACK_CONST_DONE 2

func stack_const_graph.init.with_ast (stack_ast) (stack_const_graph) in -- ast
    stack_ast.features match features in
        ptr.sizeof array.init.with_sz int.sizeof array.init.with_sz 0 while -- consts, states, i
            dup features array.count < loop
            dup features swp array.get unwrap stack_ast_feature.* match consts states i feat in
                feat stack_ast_feature.kind STACK_AST_FEATURE_CONST = if
                    consts feat stack_ast_feature.feature ptr.& array.append unwrap
                    states STACK_CONST_UNVISITED int.& array.append unwrap
                fi
                consts states i 1 +
            end
        pool pop
        int.sizeof array.init.with_sz stack_const_graph.init
    end
end

func stack_const_graph.get (stack_const_graph, int) (stack_ast_const) in -- graph, i
    swp stack_const_graph.consts swp array.get unwrap ptr.* stack_ast_const.*
end

func stack_const_graph.name (stack_const_graph, int) (string) in -- graph, i
    stack_const_graph.get stack_ast_const.name stack_ast_node.value
end

func stack_const_graph.status (stack_const_graph, int) (int) in -- graph, i
    swp stack_const_graph.states swp array.get unwrap int.*
end

func stack_const_graph.mark (stack_const_graph, int, int) () in -- graph, i, status
    match graph i status in
        graph stack_const_graph.states i status int.& array.set unwrap
    end
end

func stack_const_graph.index (stack_const_graph, string) (int, bool) in -- graph, name
    match graph name in
        graph stack_const_graph.consts array.count match count in
            0 while
                dup count < if dup graph swp stack_const_graph.name name string.= not else false fi
            loop 1 + pool
            dup count <
        end
    end
end

func stack_const_graph.cycle.error (stack_const_graph, int) () in -- graph, i
    match graph i in
        graph i stack_const_graph.get stack_ast_const.name stack_ast_node.location.stderr
        ", Preprocessor error: cyclic constant " string.stderr
        graph stack_const_graph.path match path in
            0 while dup path swp array.get unwrap int.* i = not loop 1 + pool
            while dup path array.count < loop
                graph over path swp array.get unwrap int.* stack_const_graph.name string.stderr
                " -> " string.stderr
                1 +
            pool pop
        end
        graph i stack_const_graph.name string.stderr
        "\n" string.stderr
    end
    1 sys.exit
end

func stack_const_graph.visit.name (stack_const_graph, stack_ast_node) () in -- graph, node
    match graph node in
        graph node stack_ast_node.value stack_const_graph.index if
            match j in
                graph j stack_const_graph.status STACK_CONST_ACTIVE = if
                    graph j stack_const_graph.cycle.error
                fi
                graph j stack_const_graph.visit
            end
        else pop fi
    end
end

func stack_const_graph.visit.exprs (stack_const_graph, array) () in -- graph, array<expr>
    match graph exprs in
        0 while dup exprs array.count < loop
            dup exprs swp array.get unwrap stack_ast_expr.* match expr in
                expr stack_ast_expr.kind
                dup STACK_AST_EXPR_NAME = if
                    graph expr stack_ast_expr.expr stack_ast_node.* stack_const_graph.visit.name
                else dup STACK_AST_EXPR_COND = if
                    expr stack_ast_expr.expr stack_ast_cond.* match cond in
                        graph cond stack_ast_cond.if_ stack_const_graph.visit.exprs
                        graph cond stack_ast_cond.else_ stack_const_graph.visit.exprs
                    end
                else dup STACK_AST_EXPR_MATCH = if
                    graph expr stack_ast_expr.expr stack_ast_match.* stack_ast_match.exprs stack_const_graph.visit.exprs
                else dup STACK_AST_EXPR_WHILE = if
                    expr stack_ast_expr.expr stack_ast_while.* match while' in
                        graph while' stack_ast_while.while_ stack_const_graph.visit.exprs
                        graph while' stack_ast_while.exprs stack_const_graph.visit.exprs
                    end
                fi fi fi fi
                pop
            end
            1 +
        pool pop
    end
end

func stack_const_graph.visit (stack_const_graph, int) () in -- graph, i
    match graph i in
        graph i stack_const_graph.status STACK_CONST_UNVISITED = if
            graph i STACK_CONST_ACTIVE stack_const_graph.mark
            graph stack_const_graph.path i int.& array.append unwrap
            graph graph i stack_const_graph.get stack_ast_const.exprs stack_const_graph.visit.exprs
            graph stack_const_graph.path array.pop unwrap
            graph i STACK_CONST_DONE stack_const_graph.mark
        fi
    end
end

func stack_preprocessor.run.check.consts (stack_ast) () in -- ast
    stack_const_graph.init.with_ast match graph in
        0 while dup graph stack_const_graph.consts array.count < loop
            graph over stack_const_graph.visit
            1 +
        pool pop
    end
end

func stack_preprocessor.run.check.original (stack_ast, stack_ast) () in -- source, helpers
    match source helpers in
        stack_ast.init.empty
        dup source stack_ast.append
        dup helpers stack_ast.append
        stack_preprocessor.run.check.consts
    end
end

func stack_const_graph.duplicate.error (stack_const_graph, int, int, int, int) () in -- graph, i, j, builtins, generated
    match graph i j builtins generated in
        graph i stack_const_graph.get stack_ast_const.name stack_ast_node.location.stderr
        ", Preprocessor error: duplicate constant " string.stderr
        graph i stack_const_graph.name string.stderr
        j builtins < if
            ", already defined as builtin" string.stderr
        else
            j generated < if ", conflicts with data helper generated at " else ", first defined at " fi string.stderr
            graph j stack_const_graph.get stack_ast_const.name stack_ast_node.location.stderr
        fi
        "\n" string.stderr
    end
    1 sys.exit
end

func stack_preprocessor.data.duplicated (stack_preprocessor) (bool) in -- pre
    stack_preprocessor.user stack_ast.features match features in
        string.sizeof array.init.with_sz match names in
            names STACK_DATA_INT string.& array.append unwrap
            names STACK_DATA_PTR string.& array.append unwrap
            names STACK_DATA_BOOL string.& array.append unwrap
            false 0 while dup features array.count < loop -- found, i
                dup features swp array.get unwrap stack_ast_feature.* match feat in
                    feat stack_ast_feature.kind STACK_AST_FEATURE_DATA = if
                        feat stack_ast_feature.feature stack_ast_data.* stack_ast_data.name stack_ast_node.value match name in
                            0 while dup names array.count < loop
                                dup names swp array.get unwrap string.* name string.= if
                                    rot pop true rot'
                                fi
                                1 +
                            pool pop
                            names name string.& array.append unwrap
                        end
                    fi
                end
                1 +
            pool pop
        end
    end
end

func stack_preprocessor.run.check.duplicates (stack_preprocessor, stack_ast) () in -- pre, builtins
    match pre builtins in
        stack_ast.init.empty match table in
            table builtins stack_ast.append
            table stack_ast.features array.count 0 +
            table pre stack_preprocessor.generated stack_ast.append
            table stack_ast.features array.count 0 +
            table pre stack_preprocessor.user stack_ast.append
            table stack_const_graph.init.with_ast
        end
        match nb ng graph in
            pre stack_preprocessor.data.duplicated if ng else nb fi
            while dup graph stack_const_graph.consts array.count < loop
                dup graph swp stack_const_graph.name graph swp stack_const_graph.index pop match i j in
                    i j = not if graph i j nb ng stack_const_graph.duplicate.error fi
                    i
                end
                1 +
            pool pop
        end
    end
end

func stack_preprocessor.run.module (stack_preprocessor, stack_ast, stack_ast) () in -- pre, ast, module
    match pre ast module in
        stack_ast.init.empty match helpers in
            module helpers stack_preprocessor.run.generate.data
            module helpers stack_preprocessor.run.check.original
            pre stack_preprocessor.user module stack_ast.append
            pre stack_preprocessor.generated helpers stack_ast.append
            ast module stack_ast.append
            ast helpers stack_ast.append
        end
    end
end

func stack_preprocessor.run (stack_preprocessor, stack_ast) () in -- pre, ast
    match pre ast in
        stack_ast.init.empty stack_ast.init.empty stack_ast.init.empty match source helpers builtins in
            source ast stack_ast.append
            source helpers stack_preprocessor.run.generate.data
            pre stack_preprocessor.user source stack_ast.append
            pre stack_preprocessor.generated helpers stack_ast.append

            pre ast stack_preprocessor.run.import
            source helpers stack_preprocessor.run.check.original

            pre builtins stack_preprocessor.run.base.consts
            ast builtins stack_ast.append
            ast helpers stack_ast.append

            pre builtins stack_preprocessor.run.check.duplicates
            ast stack_preprocessor.run.check.consts

            ast stack_preprocessor.run.expand.consts
            ast stack_preprocessor.run.expand.funcs
            ast stack_preprocessor.run.expand.special
        end
    end
end

