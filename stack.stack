        decl stack_ast_data.fields stack_ast_expr.sizeof array.init.with_sz match fields exprs in
            exprs parser STACK_AST_EXPR_NUMBER 0 int.show stack_preprocessor.run.generate.data.expr

            -- Later fields come first, as in the generated constructor.
