        pre stack_preprocessor.files match files in
            true 0 while dup files array.count < loop -- new, i
                dup files swp array.get unwrap stack_file_id.* id stack_file_id.= if
                    swp pop false swp
                fi
                1 +
            pool pop
            dup if files id stack_file_id.& array.append unwrap fi
        end
    end
end

func stack_home () (string) in
    "STACK_HOME" os.env.get not if pop "." fi
end

const STACK_DATA_INT "int"
const STACK_DATA_PTR "ptr"
const STACK_DATA_BOOL "bool"
const STACK_DATA_STRING "string"

const STACK_INIT "init"
const STACK_SIZEOF "sizeof"
const STACK_OFFSET "offset"

const STACK_SPECIAL_FILE "__file__"
const STACK_SPECIAL_LINE "__line__"
const STACK_SPECIAL_COL "__col__"

func stack_preprocessor.run.base.consts (stack_preprocessor, stack_ast) () in -- pre, ast
    "" __file__ stack_lexer.init.with_buffer -- lexer
    stack_parser.init.with_lexer -- pre, ast, parser

    dup dup -- pre, ast, parser, parser, parser
    STACK_DATA_INT "." string.concat STACK_SIZEOF string.concat -- parser, parser, value
    0 stack_ast_node.init swp -- sizeof_node parser
    int.sizeof int.show -- sizeof_node, parser, string
    0 stack_ast_node.init -- sizeof_node, 8_node
    STACK_AST_EXPR_NUMBER -- sizeof_node, 8_node, kind
    swp stack_ast_node.& stack_ast_expr.init -- sizeof_node, 8_expr
    stack_ast_expr.sizeof array.init.with_sz -- sizeof_node, expr, array
    dup rot stack_ast_expr.& array.append unwrap -- sizeof_node, array
    stack_ast_const.init -- pre, ast, parser, int.sizeof
    dup3 rot swp stack_ast.features.append.const pop pop -- pre, ast, parser

    dup dup -- pre, ast, parser, parser, parser
    STACK_DATA_PTR "." string.concat STACK_SIZEOF string.concat -- parser, parser, value
    0 stack_ast_node.init swp -- sizeof_node parser
    int.sizeof int.show -- sizeof_node, parser, string
    0 stack_ast_node.init -- sizeof_node, 8_node
    STACK_AST_EXPR_NUMBER -- sizeof_node, 8_node, kind
    swp stack_ast_node.& stack_ast_expr.init -- sizeof_node, 8_expr
    stack_ast_expr.sizeof array.init.with_sz -- sizeof_node, expr, array
    dup rot stack_ast_expr.& array.append unwrap -- sizeof_node, array
    stack_ast_const.init -- pre, ast, parser, int.sizeof
    dup3 rot swp stack_ast.features.append.const pop pop -- pre, ast, parser

    dup dup -- pre, ast, parser, parser, parser
    STACK_DATA_BOOL "." string.concat STACK_SIZEOF string.concat -- parser, parser, value
    0 stack_ast_node.init swp -- sizeof_node parser
    int.sizeof int.show -- sizeof_node, parser, string
    0 stack_ast_node.init -- sizeof_node, 8_node
    STACK_AST_EXPR_NUMBER -- sizeof_node, 8_node, kind
    swp stack_ast_node.& stack_ast_expr.init -- sizeof_node, 8_expr
    stack_ast_expr.sizeof array.init.with_sz -- sizeof_node, expr, array
    dup rot stack_ast_expr.& array.append unwrap -- sizeof_node, array
    stack_ast_const.init -- pre, ast, parser, int.sizeof
    dup3 rot swp stack_ast.features.append.const pop pop -- pre, ast, parser

    pop3
end

func stack_ast_node.location.stderr (stack_ast_node) () in -- node
    match node in
        node stack_ast_node.parser stack_parser.lexer match lexer in
            lexer stack_lexer.filename string.stderr
            lexer node stack_ast_node.pos stack_lexer.pos.to_lc -- line, col
            ":" string.stderr
            swp int.show string.stderr
            ":" string.stderr
            int.show string.stderr
        end
    end
end

func stack_preprocessor.run.import.error (stack_ast_node, string) () in -- node, action
    match node action in
        node stack_ast_node.location.stderr
        ", Preprocessor error: cannot " string.stderr
        action string.stderr
        " import \"" string.stderr
        node stack_ast_node.value string.stderr
        "\"\n" string.stderr
    end
    1 sys.exit
end

func stack_preprocessor.run.import.open (stack_ast_node) (string, int) in -- node
    match node in
        node stack_ast_node.value "." string.concat STACK_EXT string.concat match name in
            name "r" stdlib.fopen unwrap match fd in
                fd 0 >= if
                    name fd
                else
                    stack_home "/lib/" string.concat name string.concat match path in
                        path path "r" stdlib.fopen unwrap
                    end
                fi
            end
        end
    end
end

func stack_preprocessor.run.import.file (stack_preprocessor, stack_ast, stack_ast_node) () in -- pre, ast, node
    match pre ast node in
        node stack_preprocessor.run.import.open match path fd in
            fd 0 < if node "open" stack_preprocessor.run.import.error fi
            fd stdlib.fidentity match dev ino ok in
                ok not if fd stdlib.fclose pop node "stat" stack_preprocessor.run.import.error fi
                pre dev ino stack_file_id.init stack_preprocessor.files.register if
                    fd stdlib.fread.<eof> match source ok' in
                        ok' not if fd stdlib.fclose pop node "read" stack_preprocessor.run.import.error fi
                        fd stdlib.fclose not if node "close" stack_preprocessor.run.import.error fi
                        source path stack_lexer.init.with_buffer
                        stack_parser.init.with_lexer
                        stack_parser.parse unwrap
                        pre ast rot stack_preprocessor.run.module
                    end
                else
                    fd stdlib.fclose not if node "close" stack_preprocessor.run.import.error fi
                fi
            end
        end
    end
end

func stack_preprocessor.run.import (stack_preprocessor, stack_ast) () in -- pre, ast
    match pre ast in
        0 while dup ast stack_ast.features array.count < loop
            dup ast stack_ast.features swp array.get unwrap stack_ast_feature.* match feat in
                feat stack_ast_feature.kind STACK_AST_FEATURE_IMPORT = if
                    pre ast feat stack_ast_feature.feature stack_ast_import.* stack_ast_import.name
                    stack_preprocessor.run.import.file
