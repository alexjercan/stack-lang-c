func nested () () in
    1 match a in
        2 3 match b c in
            while true loop
                true if
                    a b c match d e f in
                        d e f pop pop pop
                        false if else while false loop pool fi
                    end
                else
                    while false loop true if 1 pop fi pool
                fi
            pool
        end
    end
    true if true if true if true if 4 pop else 3 pop fi fi else fi fi
end

