@import "stdlib"
@import "tests/04-runtime/utils"

const HALF 0.5

data point (float x, int n)

func id (a) (a) in end

func swap2 (a, b) (b, a) in swp end

-- The IEEE 754 bits of the value.
func bits (float) (int) in float.& int.* 0 + end

func nan () (float) in 0.0 0.0 float./ end

func inf () (float) in 1.0 0.0 float./ end

func main () (int) in
    1.5 2.25 float.+ bits 3.75 bits = 1 check
    1.5 2.25 float.- bits -0.75 bits = 2 check
    1.5 -4.0 float.mul bits -6.0 bits = 3 check
    1.0 4.0 float./ bits 0.25 bits = 4 check
    1e3 bits 1000.0 bits = 5 check
    1E3 bits 1e+3 bits = 6 check
    1.5e-3 bits 0.0015 bits = 7 check
    -0.0 bits -9223372036854775808 = 8 check
    0.0 bits 0 = 9 check
    0.1 0.2 float.+ bits 0.30000000000000004 bits = 10 check

    2.0 1.0 float.> 11 check
    1.0 2.0 float.> not 12 check
    1.0 2.0 float.< 13 check
    2.0 1.0 float.< not 14 check
    1.0 1.0 float.= 15 check
    1.0 2.0 float.= not 16 check
    -0.0 0.0 float.= 17 check
    -0.0 0.0 float.< not 18 check
    nan nan float.= not 19 check
    nan 1.0 float.> not 20 check
    nan 1.0 float.< not 21 check
    1.0 nan float.> not 22 check
    1.0 nan float.< not 23 check
    inf 1e308 float.> 24 check

    7 int.to_float bits 7.0 bits = 25 check
    -3 int.to_float bits -3.0 bits = 26 check
    2.9 float.to_int 2 = 27 check
    -2.9 float.to_int -2 = 28 check
    -0.5 float.to_int 0 = 29 check
    nan float.to_int -9223372036854775808 = 30 check
    1e300 float.to_int -9223372036854775808 = 31 check

    4294967297 int.to_float bits 4294967297.0 bits = 39 check
    9007199254740993 int.to_float bits 9007199254740992 int.to_float bits = 40 check
    9223372036854775807 int.to_float bits 4890909195324358656 = 41 check
    -9223372036854775808 int.to_float bits -4332462841530417152 = 42 check
    -9223372036854775808 int.to_float float.to_int -9223372036854775808 = 43 check
    4890909195324358655 int.& float.* float.to_int 9223372036854774784 = 44 check
    -4332462841530417153 int.& float.* float.to_int -9223372036854774784 = 45 check
    4294967297 int.to_float float.to_int 4294967297 = 46 check
    1.5 id bits 1.5 bits = 47 check
    1 2.5 swap2 match f n in f bits 2.5 bits = 48 check n 1 = 49 check end

    -- exact conversion of literals
    9007199254740993.0 bits 4845873199050653696 = 50 check
    9007199254740995.0 bits 4845873199050653698 = 51 check
    9007199254740993.0000000001 bits 4845873199050653697 = 52 check
    0.1 bits 4591870180066957722 = 53 check
    1e23 bits 4950912855330343670 = 54 check
    0e999 bits 0 = 55 check
    -0e-999 bits -9223372036854775808 = 56 check
    2.2250738585072014e-308 bits 4503599627370496 = 57 check
    2.2250738585072009e-308 bits 4503599627370495 = 58 check
    4.9e-324 bits 1 = 59 check
    2.4703282292062328e-324 bits 1 = 60 check
    -2.4703282292062328e-324 bits -9223372036854775807 = 61 check
    1.7976931348623157e308 bits 9218868437227405311 = 62 check
    1.7976931348623158e308 bits 9218868437227405311 = 63 check
    -1.7976931348623158e308 bits -4503599627370497 = 64 check
    .0e-330 bits 4756540486875873280 = 65 check
    0. bits 4607182418800017408 = 66 check
    0.30000000000000004 bits 4599075939470750516 = 67 check
    -- exact midpoints: zero/subnormal, subnormal/normal, overflow
    2.-324
        bits 1 = 68 check
    2.-308
        bits 4503599627370496 = 69 check
    2.-308
        bits 4503599627370495 = 70 check
    1.
        bits 9218868437227405311 = 71 check

    float.sizeof 8 = 32 check
    HALF bits 0.5 bits = 33 check
    HALF 3 point.init match p in
        p point.x bits 0.5 bits = 34 check
        p 2.5 point.x.set
        p point.x bits 2.5 bits = 35 check
        p point.n 3 = 36 check
    end
    1.25 float.& float.* bits 1.25 bits = 37 check
    1.5 2.5 swp float.- bits 1.0 bits = 38 check

    0
end
