@import "json"
@import "tests/04-runtime/modules/json-check"

-- Bytes that can start a value or are whitespace.
func value.start (int) (bool) in
    match b in
        b byte.isspace b 13 = or b byte.isdigit or
        b BYTE_- = or b BYTE_QUOTE = or b BYTE_[ = or b BYTE_{ = or
    end
end

-- Illegal input and its line:column.
func main () (int) in
    "@" "1:1: expected value" 1 expect.error
    "@true" "1:1: expected value" 2 expect.error
    "true@" "1:5: expected end of input" 3 expect.error
    "\t\n @true" "2:2: expected value" 4 expect.error
    "[\n1,\n  @]" "3:3: expected value" 5 expect.error
    "\r\n\r\n?" "3:1: expected value" 6 expect.error

    "[1 2]" "1:4: expected ',' or ']'" 7 expect.error
    "[1,]" "1:4: expected value" 8 expect.error
    "[,1]" "1:2: expected value" 9 expect.error
    "{1:2}" "1:2: expected string" 10 expect.error
    "{\"a\" 1}" "1:6: expected ':'" 11 expect.error
    "{\"a\":1 \"b\":2}" "1:8: expected ',' or '}'" 12 expect.error
    "{\"a\":1,}" "1:8: expected string" 13 expect.error
    "{\"a\"}" "1:5: expected ':'" 14 expect.error
    "[}" "1:2: expected value" 15 expect.error
    "{]" "1:2: expected string" 16 expect.error
    "tru" "1:1: expected value" 17 expect.error
    "truex" "1:5: expected end of input" 18 expect.error
    "nul" "1:1: expected value" 19 expect.error
    "True" "1:1: expected value" 20 expect.error
    "[] []" "1:4: expected end of input" 21 expect.error
    "'a'" "1:1: expected value" 22 expect.error

    "01" "1:2: expected end of input" 23 expect.error
    "-" "1:1: invalid number" 24 expect.error
    "--1" "1:1: invalid number" 25 expect.error
    "-a" "1:1: invalid number" 26 expect.error
    "1." "1:1: invalid number" 27 expect.error
    "1.e5" "1:1: invalid number" 28 expect.error
    "1e" "1:1: invalid number" 29 expect.error
    "1e+" "1:1: invalid number" 30 expect.error
    "[0x1]" "1:3: expected ',' or ']'" 31 expect.error
    ".5" "1:1: expected value" 32 expect.error
    "+1" "1:1: expected value" 33 expect.error
    "1.5.2" "1:4: expected end of input" 34 expect.error

    -- Every other byte is illegal as the first byte of a value.
    0 while dup 256 < loop
        match b in
            b value.start not if
                b byte.chr "," string.concat "1:1: expected value" 35 expect.error
                b BYTE_] = not if
                    "[" b byte.chr string.concat "]" string.concat "1:2: expected value" 36 expect.error
                fi
            fi
            b 1 +
        end
    pool pop

    0
end
