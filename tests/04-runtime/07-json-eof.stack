@import "json"
@import "tests/04-runtime/modules/json-check"

func byte26 () (string) in 26 byte.chr end

-- End of input, NUL, and byte 26 in and out of strings.
func main () (int) in
    -- True EOF is out of band.
    BYTE_EOF 0 < 1 check
    "" "1:1: unexpected end of input" 2 expect.error
    " \n\t" "2:2: unexpected end of input" 3 expect.error
    "[1," "1:4: unexpected end of input" 4 expect.error
    "{\"a\"" "1:5: unexpected end of input" 5 expect.error
    "{\"a\":" "1:6: unexpected end of input" 6 expect.error
    "[" "1:2: unexpected end of input" 7 expect.error
    "{" "1:2: unexpected end of input" 8 expect.error

    -- Byte 26 is not EOF.
    byte26 "1:1: expected value" 9 expect.error
    "1" byte26 string.concat "2" string.concat "1:2: expected end of input" 10 expect.error
    "\"a" byte26 string.concat "b\"" string.concat "1:3: control character in string" 11 expect.error
    "\"\\" byte26 string.concat "\"" string.concat "1:2: invalid escape in string" 12 expect.error
    "\"a\\u001ab\"" 13 parse.string match s in
        s string.len 3 = 14 check
        s 1 string.!! 26 = 15 check
    end
    "[\"a\\u001Ab\",1]" "[\"a\\u001ab\",1]" 16 expect.dump

    -- True EOF ends unterminated strings, also after a backslash.
    "\"ab" "1:1: unterminated string" 17 expect.error
    "\"ab\\" "1:1: unterminated string" 18 expect.error
    "\"\\" "1:1: unterminated string" 19 expect.error
    "[1, \"ab\\\"]" "1:5: unterminated string" 20 expect.error

    -- NUL is data only as an escape.
    0 byte.chr "1:1: expected value" 21 expect.error
    "\"" 0 byte.chr string.concat "\"" string.concat "1:2: control character in string" 22 expect.error
    "\"\\u0000\"" 23 parse.string match s in
        s string.len 1 = 24 check
        s 0 string.!! 0 = 25 check
    end
    "[\"\\u0000\"]" "[\"\\u0000\"]" 26 expect.dump

    0
end
