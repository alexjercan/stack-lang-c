-- This is the standard library of `stack`. It imports all the modules of
-- the standard library. A program can also import one module, for example
-- "std/string".

@import "linux"
@import "std/core"
@import "std/byte"
@import "std/ptr"
@import "std/string"
@import "std/int"
@import "std/io"
@import "std/panic"
@import "std/stdio"
@import "std/error"
@import "std/array"
@import "cstr"
@import "std/os"
