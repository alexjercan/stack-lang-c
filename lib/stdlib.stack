@import "linux"

-- This is the standard library of `stack`.

const STDIN 0
const STDOUT 1
const STDERR 2

-- BASE FUNCTIONS

-- duplicate first 2 elements of the stack
func dup2 (a, b) (a, b, a, b) in
    swp dup rot dup rot'
end

-- pop the first 2 elements of the stack
func pop2 (a, b) () in
    pop pop
end

-- duplicate first 3 elements of the sack
func dup3 (a, b, c) (a, b, c, a, b, c) in
    rot dup rot4'
    rot dup rot4'
    rot dup rot4'
end

-- pop the first 3 eleemnts of the stack
func pop3 (a, b, c) () in
    pop pop pop
end

-- rotate 3 elements counter clockwise
func rot' (a, b, c) (c, a, b) in rot rot end

-- rotate 4 elements counter clockwise
func rot4' (a, b, c, d) (d, a, b, c) in rot4 rot4 rot4 end

-- duplicate the second element first
func over (a, b) (a, b, a) in
    match a b in a b a end
end

-- DATA PTR

const ptr.null 0 int.& ptr.*

func ptr.= (ptr, ptr) (bool) in
    match p1 p2 in p1 ptr.& int.* p2 ptr.& int.* = end
end

func ptr.realloc (ptr, int, int) (ptr) in
    match src old_size new_size in
        new_size ptr.alloc
        match dst in
            dst src
            old_size new_size < if old_size else new_size fi
            ptr.@
            src ptr.free
        end
    end
end

func ptr.memcmp (ptr, ptr, int) (int) in -- s1, s2, n
    0 rot4' while -- acc, s1, s2, n
        dup 0 > loop -- acc, s1, s2, n
        match _acc s1 s2 n in
            s1 byte.init s2 byte.init - -- b1-b2
            dup 0 = if
                s1 1 ptr.+
                s2 1 ptr.+
                n 1 -
            else
                s1 s2 0
            fi -- acc, s1, s2, n
        end
    pool -- acc, s1, s2, n
    pop3
end

func ptr.strlen (ptr) (int) in
    0 swp while -- n, ptr
        dup byte.init BYTE_NULL = not loop -- n, ptr
        1 ptr.+ swp 1 + swp
    pool -- n, ptr
    pop
end

-- DATA ERROR

data error
    ( bool ok
    , string message
    )

func error.fail (string) (error) in
    false swp error.init
end

func error.nil () (error) in
    true "" error.init
end

func error.unwrap (error) () in
    dup error.ok not if
        error.message "\n" string.concat string.stderr
        panic
    else pop fi
end

-- DATA INT

func min (int, int) (int) in
    match a b in a b < if a else b fi end
end


func abs (int) (int) in
    dup 0 < if 0 swp - fi
end

func mod (int, int) (int) in
    match x m in
        x m % match r in r 0 < if r m + else r fi end
    end
end

func digit.show (int) (string) in
    dup 0 = if pop "0" else
    dup 1 = if pop "1" else
    dup 2 = if pop "2" else
    dup 3 = if pop "3" else
    dup 4 = if pop "4" else
    dup 5 = if pop "5" else
    dup 6 = if pop "6" else
    dup 7 = if pop "7" else
    dup 8 = if pop "8" else
    dup 9 = if pop "9" else pop ""
    fi fi fi fi fi fi fi fi fi fi
end

func int.show (int) (string) in
    dup 0 = if pop "0"
    else
        dup 0 < if abs "-" else "" fi -- int, str

        "" rot while -- str, int
            dup 0 > loop -- str, int
            match s n in
                n 10 mod digit.show s string.concat  -- str
                n 10 / -- str, int
            end
        pool -- str, int
        pop string.concat
    fi
end

func int.read (string) (int, bool) in
    -- TODO: parse negative numbers
    match s in
        s string.len 0 <= if
            0 true
        else
            0 0 true while -- i, ok
                match i ok in
                    i ok i s string.len < ok and
                end loop -- i, ok
                match r i ok in
                    s i string.!!
                    dup byte.isdigit if
                        BYTE_0 -  r 10 * + i 1 + ok
                    else
                        i 1 + false
                    fi
                end
            pool -- i, ok

            swp pop
        fi
    end
end

-- DATA BOOL

func <= (int, int) (bool) in
    dup2 < if pop2 true else = fi
end

func >= (int, int) (bool) in
    dup2 > if pop2 true else = fi
end

func not (bool) (bool) in
    if false else true fi
end

func and (bool, bool) (bool) in
    if else pop false fi
end

func or (bool, bool) (bool) in
    if pop true else fi
end

func bool.show (bool) (string) in
    if "true" else "false" fi
end

-- DATA STRING
data string (int len, ptr str)

-- compute how much memory you need to allocate for the string ptr
-- taking into account memory alignment by 8
func string.memory-needed (int) (int) in -- sz
    8 + 8 / 8 *
end

-- convert a c string (ptr) to a stack string
func string.init.cstr (ptr) (string) in
    dup ptr.strlen -- ptr, int
    swp string.init
end

-- concatenate two strings
func string.concat (string, string) (string) in -- s1, s2
    match s1 s2 in
        s1 string.len s2 string.len + -- L
        dup string.memory-needed ptr.alloc -- L, ptr
        s1 string.str s1 string.len ptr.@ -- L, ptr
        dup s1 string.len ptr.+ -- L, ptr, ptr+L1
        s2 string.str s2 string.len ptr.@ -- L, ptr, ptr+L1
        pop -- L, ptr
        string.init
    end
end

-- create a substring given the start and length
func string.substr (string, int, int) (string) in -- s, i, n
    match s1 i n in
        n string.memory-needed ptr.alloc -- ptr
        s1 string.str i ptr.+ -- ptr, str+i
        n -- ptr, str+i, n
        ptr.@ -- ptr
        n swp string.init
    end
end

-- repeat a string n times
func string.repeat (string, int) (string) in -- s, n
    match s n in
        "" 0 while -- result, i
            dup n < loop -- result, i
            match r i in
                r s string.concat
                i 1 +
            end
        pool -- result, i
        pop
    end
end

-- index a string into a byte
func string.!! (string, int) (int) in
    match s i in s string.str i ptr.+ byte.init end
end

-- check if two strings are equal
func string.= (string, string) (bool) in
    match s1 s2 in
        s1 string.len s2 string.len = if
            s1 string.str s2 string.str s1 string.len ptr.memcmp 0 =
        else
            false
        fi
    end
end

-- check if a string starts with another string
func string.starts_with (string, string) (bool) in
    match s pre in
        pre string.len s string.len > if
            false
        else
            s string.str pre string.str pre string.len ptr.memcmp 0 =
        fi
    end
end

-- split a string at the given index
func string.split_at (string, int) (string, string) in
    match s i in
        i s string.len > if
            s ""
        else
            s 0 i string.substr s i s string.len i - string.substr
        fi
    end
end

-- check if string contains another string and return the index of the first occurence
func string.index (string, string) (int, bool) in -- haystack, needle
    match s sep in
        0 true while -- i, run
            match i ok in i ok i s string.len < ok and end loop -- i, run
            match i ok in
                i sep string.len + s string.len <= if
                    s string.str i ptr.+ sep string.str sep string.len ptr.memcmp 0 =
                else
                    false
                fi
                if i false else i 1 + true fi
            end
        pool -- i, run
        not -- i, found
    end
end

-- split a string with a separator, returns first occurence only
func string.split (string, string) (string, string) in -- string, sep
    string.cut pop
end

-- same as split, but it also returns a bool if it failed or not
func string.cut (string, string) (string, string, bool) in
    match s sep in
        s sep string.index not if
            pop s "" false
        else
            s swp string.split_at
            sep string.len
            string.split_at
            swp pop
            true
        fi
    end
end

func string.stdin () (string) in -- ()
    STDIN stdlib.fread.<eof> -- s, ok
    unwrap -- s
end

func string.stdout (string) () in -- s
    STDOUT swp stdlib.fwrite -- bool
    unwrap
end

func string.stderr (string) () in -- s
    STDERR swp stdlib.fwrite -- bool
    unwrap
end

-- STDLIB

const stdlib.MAX_LINE 1024

const abort 1 sys.exit

const here -- () (string)
    __file__ ":" string.concat __line__ int.show string.concat ":" string.concat __col__ int.show string.concat ": " string.concat

const panic -- () ()
    here "panic!\n" string.concat STDERR swp stdlib.fwrite pop abort

const unwrap -- (ok) ()
    not if panic fi

const todo -- () ()
    here "todo!\n" string.concat STDERR swp stdlib.fwrite pop abort

func stdlib.fopen (string, string) (int, bool) in -- fn, md
    match fn md in
        md "r" string.= if
            fn string.str O_RDONLY O_0644 sys.open true
        else md "w" string.= if
            fn string.str O_WRONLY O_CREAT | O_0644 sys.open true
        else
            0 false
        fi fi
    end
end

func stdlib.fclose (int) (bool) in -- fd
    sys.close 0 =
end

func stdlib.fidentity (int) (int, int, bool) in -- fd
    match fd in
        STAT_SIZE ptr.alloc match buf in
            fd buf sys.fstat 0 = if
                buf STAT_DEV_OFF ptr.+ int.* 0 + buf STAT_INO_OFF ptr.+ int.* 0 + true
            else
                0 0 false
            fi
            buf ptr.free
        end
    end -- dev, ino, ok
end

-- Read at most L bytes. A failed read returns "" and false.
func stdlib.fread (int, int) (string, bool) in -- fd, L
    match fd L in
        L string.memory-needed ptr.alloc match buf in
            fd buf L sys.read match n in
                n 0 < if buf ptr.free "" false else n buf string.init true fi
            end
        end
    end
end

-- Read until a read returns 0 bytes. A failed read returns "" and false.
func stdlib.fread.<eof> (int) (string, bool) in -- fd
    match fd in
        "" true true while loop -- s, ok
            match s _ok in
                fd stdlib.MAX_LINE stdlib.fread match chunk ok in
                    ok not if
                        s string.len 0 > if s string.str ptr.free fi
                        "" false false
                    else chunk string.len 0 = if
                        s string.len 0 = if chunk else chunk string.str ptr.free s fi
                        true false
                    else s string.len 0 = if
                        chunk true true
                    else
                        s chunk string.concat true true
                        s string.str ptr.free
                        chunk string.str ptr.free
                    fi fi fi
                end
            end
        pool
    end
end

func stdlib.fwrite (int, string) (bool) in -- fd, s
    match fd s in fd s string.str s string.len sys.write 0 >= end
end

-- DATA ARRAY
data array (int capacity, int count, int sz, ptr items)

const array.SIZE 32

func array.init.with_sz (int) (array) in -- sz
    match sz in 0 0 sz ptr.null array.init end
end

func array.get (array, int) (ptr, bool) in -- a, i
    match xs i in
        xs array.count i <= if
            ptr.null false
        else
            xs array.items -- ptr
            xs array.sz -- ptr, sz
            i * -- ptr, i*sz
            ptr.+ -- ptr+i*sz
            true
        fi -- ptr, ok
    end
end

func array.set (array, int, ptr) (bool) in -- array, index, item
    match xs i item in
        i 0 >= i xs array.count < and if
            xs array.items i xs array.sz * ptr.+
            item xs array.sz ptr.@ pop
            true
        else
            false
        fi
    end
end

func array.copy (array) (array, bool) in -- a
    match xs in xs array.sz array.init.with_sz dup xs array.extend end
end

func array.last (array) (ptr, bool) in -- a
    match xs in
        xs array.count 0 <= if
            0 int.& false
        else
            xs xs array.count 1 - array.get
        fi
    end
end

func array.pop (array) (bool) in -- a
    match xs in
        xs array.count 0 <= if
            false
        else
            xs xs array.count 1 - array.delete
        fi
    end
end

func array.= (array, array) (bool) in -- xs, ys
    match xs ys in
        xs array.count ys array.count = if
            xs array.items -- xs.items
            ys array.items -- xs.items, ys.items
            xs array.count -- xs.items, ys.items, L
            ptr.memcmp 0 = -- ok
        else
            false
        fi
    end
end

-- Make room for n items. The items move to a new block and the old block is
-- freed.
func array.reserve' (array, int) () in
    match xs n in
        n xs array.capacity > if
            xs array.capacity 2 * dup 0 <= if pop array.SIZE fi
            dup n < if pop n fi 0 +
            match cap in
                xs array.items
                xs array.capacity xs array.sz *
                cap xs array.sz *
                ptr.realloc
                xs swp array.items.set
                xs cap array.capacity.set
            end
        fi
    end
end

-- Insert n items from p at index i. p can point into the items of xs.
func array.insert' (array, int, ptr, int) () in
    match xs i' p n' in
        i' 0 + n' 0 + xs array.count 0 + xs array.sz 0 + match i n L sz in
            n L i - + sz * ptr.alloc match tmp in
                tmp p n sz * ptr.@
                n sz * ptr.+ xs array.items i sz * ptr.+ L i - sz * ptr.@ pop
                xs L n + array.reserve'
                xs array.items i sz * ptr.+ tmp n L i - + sz * ptr.@ pop
                tmp ptr.free
            end
            xs L n + array.count.set
        end
    end
end

func array.insert (array, int, ptr) (bool) in -- dst, i, item
    match xs i item in
        i xs array.count <= if xs i item 1 array.insert' true else false fi
    end
end

func array.insert_many (array, int, array) (bool) in
    match dst i src in
        i dst array.count <= if
            dst i src array.items src array.count array.insert' true
        else
            false
        fi
    end
end

func array.delete (array, int) (bool) in -- a, i
    match xs i in
        i xs array.count < if
            xs array.items i xs array.sz * ptr.+ -- ptr+i*sz
            xs array.items i 1 + xs array.sz * ptr.+ -- ptr+i*sz, ptr+(i+1)*sz
            xs array.count i - 1 - xs array.sz *  -- ptr+i*sz, ptr+(i+1)*sz (L-i-1)*sz
            ptr.@ pop -- ()

            xs array.count 1 - -- L-1
            xs swp array.count.set -- ()

            true
        else false fi
    end
end

func array.extend (array, array) (bool) in -- xs, xs'
    match dst src in dst dst array.count src array.insert_many end
end

func array.append (array, ptr) (bool) in -- a, ptr
    match xs item in
        xs array.count xs array.capacity < if
            xs array.items xs array.count xs array.sz * ptr.+ item xs array.sz ptr.@ pop
            xs xs array.count 1 + array.count.set
        else
            xs xs array.count item 1 array.insert'
        fi
        true
    end
end

func array.swap (array, int, int) () in
    match xs i j in
        xs array.sz ptr.alloc match tmp in
            xs i array.get unwrap match fst in
                tmp fst xs array.sz ptr.@ pop
                xs j array.get unwrap match snd in
                    fst snd xs array.sz ptr.@ pop
                    snd tmp xs array.sz ptr.@ pop
                end
            end
            tmp ptr.free
        end
    end
end

func array.sort<int> (array) () in
    match xs in
        0 while -- i
            dup xs array.count < loop -- i

            dup 1 + while -- i, j
            dup xs array.count < loop -- i, j
                match i j in
                    xs i array.get unwrap int.* -- x
                    xs j array.get unwrap int.* -- y
                    - 0 > if xs i j array.swap fi
                    i j 1 +
                end
            pool -- i, j

            pop 1 +
        pool -- i

        pop
    end
end

-- DATA BYTE is a subdata of int

const BYTE_NULL 0
const BYTE_\T 9
const BYTE_\N 10
const BYTE_EOF -1
const BYTE_SPACE 32
const BYTE_! 33
const BYTE_QUOTE 34
const BYTE_# 35
const BYTE_$ 36
const BYTE_% 37
const BYTE_& 38
const BYTE_' 39
const BYTE_LPAREN 40
const BYTE_RPAREN 41
const BYTE_* 42
const BYTE_+ 43
const BYTE_COMMA 44
const BYTE_- 45
const BYTE_. 46
const BYTE_/ 47
const BYTE_0 48
const BYTE_9 57
const BYTE_: 58
const BYTE_; 59
const BYTE_< 60
const BYTE_= 61
const BYTE_> 62
const BYTE_? 63
const BYTE_@ 64
const BYTE_A 65
const BYTE_Z 90
const BYTE_[ 91
const BYTE_\ 92
const BYTE_] 93
const BYTE_^ 94
const BYTE__ 95
const BYTE_` 96
const BYTE_a 97
const BYTE_b 98
const BYTE_f 102
const BYTE_n 110
const BYTE_r 114
const BYTE_t 116
const BYTE_z 122
const BYTE_{ 123
const BYTE_| 124
const BYTE_} 125
const BYTE_~ 126

func byte.ispunct' (int) (bool) in -- chr
    dup BYTE_! = swp
    dup BYTE_# = swp
    dup BYTE_$ = swp
    dup BYTE_% = swp
    dup BYTE_& = swp
    dup BYTE_' = swp
    dup BYTE_* = swp
    dup BYTE_+ = swp
    dup BYTE_- = swp
    dup BYTE_. = swp
    dup BYTE_/ = swp
    dup BYTE_: = swp
    dup BYTE_; = swp
    dup BYTE_< = swp
    dup BYTE_= = swp
    dup BYTE_> = swp
    dup BYTE_? = swp
    dup BYTE_@ = swp
    dup BYTE_[ = swp
    dup BYTE_\ = swp
    dup BYTE_] = swp
    dup BYTE_^ = swp
    dup BYTE__ = swp
    dup BYTE_` = swp
    dup BYTE_{ = swp
    dup BYTE_| = swp
    dup BYTE_} = swp
    dup BYTE_~ = swp pop
    or or or or or or or or or or or or or or or or or or or or or or or or or or or
end

func byte.init (ptr) (int) in -- chr*
    match p in
        int.sizeof ptr.alloc match buf in
            buf p 1 ptr.@ int.* 0 + buf ptr.free
        end
    end
end

func byte.isdigit (int) (bool) in -- chr
    dup BYTE_0 >= swp BYTE_9 <= and
end

func byte.isupper (int) (bool) in -- chr
    dup BYTE_A >= swp BYTE_Z <= and
end

func byte.islower (int) (bool) in -- chr
    dup BYTE_a >= swp BYTE_z <= and
end

func byte.isletter (int) (bool) in -- chr
    dup byte.isupper swp byte.islower or
end

func byte.isalnum (int) (bool) in -- chr
    dup byte.isdigit swp byte.isletter or
end

func byte.isspace (int) (bool) in -- chr
    dup BYTE_\T = swp -- bool i
    dup BYTE_\N = swp -- bool bool i
    dup BYTE_SPACE = swp -- bool bool bool i
    pop or or -- bool
end

func byte.isname (int) (bool) in -- chr
    dup byte.isalnum swp byte.ispunct' or
end

func byte.chr (int) (string) in -- chr
    match x in
        1 string.memory-needed ptr.alloc x int.& 1 ptr.@ 1 swp string.init
    end
end

-- OS

func os.env.get (string) (string, bool) in -- name
    match name in
        "" false os.env while -- result, found, ptr<c-str>
            match result found env in
                result found env found not env int.* 0 = not and
            end loop -- result, found, ptr<c-str>
            match _result _found env in
                env ptr.* string.init.cstr "=" string.split match key value in
                    value key name string.= env 8 ptr.+
                end
            end
        pool -- result, found, ptr<c-str>
        pop
    end -- result, found
end
