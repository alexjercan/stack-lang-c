@import "stdlib"
@import "stack/lexer"

-- The parser and the syntax tree of the Stack compiler.

-- After the first error the parser reads only the end of the file, so every
-- loop stops. The error is in the stack_diagnostic at diag_ptr. Each syntax
-- node has a copy of the parser, so the diagnostic is not in the parser.
-- depth is the number of open if, match and while blocks.
data stack_parser (stack_lexer lexer, stack_token tok, stack_token next_tok, ptr diag_ptr, int depth)

-- The parser and the later passes recurse for each block. More nested
-- blocks can overflow the call stack.
const STACK_PARSER_DEPTH_MAX 2048

func stack_parser.init.with_lexer (stack_lexer) (stack_parser) in
    match lexer in
        lexer stack_token.init.empty stack_token.init.empty lexer stack_diagnostic.new stack_diagnostic.& 0
        stack_parser.init
        dup stack_parser.read pop
    end
end

func stack_parser.diag (stack_parser) (stack_diagnostic) in stack_parser.diag_ptr stack_diagnostic.* end

func stack_parser.peek (stack_parser) (stack_token) in stack_parser.next_tok end

func stack_parser.read (stack_parser) (stack_token) in
    dup dup stack_parser.peek stack_parser.tok.set
    dup dup stack_parser.lexer stack_lexer.next stack_parser.next_tok.set
    stack_parser.tok
end

func stack_parser.failed (stack_parser) (bool) in stack_parser.diag stack_diagnostic.failed end

-- Record an error at the next token and skip to the end of the file.
func stack_parser.fail (stack_parser, string) () in
    match parser message in
        parser stack_parser.diag parser stack_parser.lexer parser stack_parser.peek stack_token.pos message
        stack_diagnostic.fail
        parser stack_parser.lexer match lexer in
            lexer stack_lexer.buffer string.len 0 + match end' in
                lexer end' stack_lexer.pos.set
                lexer end' stack_lexer.read_pos.set
                lexer BYTE_EOF stack_lexer.ch.set
                parser STACK_TOKEN_EOF "" end' stack_token.init.ok stack_parser.next_tok.set
            end
        end
    end
end

func stack_parser.parse.exprs.error (stack_parser, string) () in
    match parser message in parser "Parser error: " message string.concat stack_parser.fail end
end

-- Open a block. False, with an error, when the block is too deep.
func stack_parser.enter (stack_parser) (bool) in
    match parser in
        parser parser stack_parser.depth 1 + stack_parser.depth.set
        parser stack_parser.depth STACK_PARSER_DEPTH_MAX > if
            parser "blocks are nested too deep\n" stack_parser.parse.exprs.error false
        else
            true
        fi
    end
end

func stack_parser.leave (stack_parser) () in
    match parser in parser parser stack_parser.depth 1 - stack_parser.depth.set end
end

func stack_parser.illegal.check (stack_parser) () in
    match parser in
        parser stack_parser.peek stack_token.kind STACK_TOKEN_ILLEGAL = if
            parser parser stack_parser.illegal.message stack_parser.fail
        fi
    end
end

func stack_parser.expect.fail (stack_parser, string) () in -- parser, expected
    match parser expected in
        parser stack_parser.illegal.check
        parser "expected " expected string.concat ", got " string.concat
        parser stack_parser.peek stack_token.kind stack_token_kind.describe string.concat
        "\n" string.concat stack_parser.parse.exprs.error
    end
end

func stack_parser.expect (stack_parser, int) (stack_token) in -- parser, kind
    match parser kind in
        parser stack_parser.peek stack_token.kind kind = not if
            parser kind stack_token_kind.describe stack_parser.expect.fail
        fi
        parser stack_parser.read
    end
end

func stack_parser.list.empty (stack_parser) (bool) in
    match parser in
        parser stack_parser.peek stack_token.kind STACK_TOKEN_RPAREN = if
            parser stack_parser.read pop true
        else
            parser stack_parser.peek stack_token.kind STACK_TOKEN_NAME = not if
                parser "name or ')'" stack_parser.expect.fail
            fi
            false
        fi
    end
end

func stack_parser.list.continue (stack_parser) (bool) in
    match parser in
        parser stack_parser.peek stack_token.kind STACK_TOKEN_COMMA = if
            parser stack_parser.read pop true
        else
            parser stack_parser.peek stack_token.kind STACK_TOKEN_RPAREN = not if
                parser "',' or ')'" stack_parser.expect.fail
            fi
            parser stack_parser.read pop false
        fi
    end
end

func stack_parser.parse.exprs.unexpected (stack_parser, int, int) () in
    match parser stop1 stop2 in
        parser "expression"
        stop1 stop2 = if
            " or " string.concat stop1 stack_token_kind.describe string.concat
        else
            ", " string.concat stop1 stack_token_kind.describe string.concat
            ", or " string.concat stop2 stack_token_kind.describe string.concat
        fi
        stack_parser.expect.fail
    end
end

func stack_parser.parse.name (stack_parser) (stack_ast_node) in
    match parser in
        parser STACK_TOKEN_NAME stack_parser.expect match tok in
            parser tok stack_token.value tok stack_token.pos stack_ast_node.init
        end
    end
end

func stack_parser.parse.exprs.until (stack_parser, int, array) (array) in
    match parser stop exprs in
        parser stop stop exprs stack_parser.parse.exprs.until2
    end
end

func stack_parser.parse.exprs.while (stack_parser, array) (array) in -- parser, array<expr>
    match parser exprs in
        while parser stack_parser.parse.expr loop
            exprs swp stack_ast_expr.& array.append unwrap
        pool
        pop -- Discard the dummy expression from the failed parse.
        exprs
    end
end

func stack_parser.parse.exprs.until2 (stack_parser, int, int, array) (array) in
    match parser stop1 stop2 exprs in
        while
            parser stack_parser.peek stack_token.kind stop1 =
            parser stack_parser.peek stack_token.kind stop2 = or not
            parser stack_parser.failed not and
        loop
            parser stack_parser.illegal.check

            parser stack_parser.parse.expr if
                exprs swp stack_ast_expr.& array.append unwrap
            else
                pop -- Discard the dummy expression from the failed parse.
                parser stop1 stop2 stack_parser.parse.exprs.unexpected
            fi
        pool

        parser stack_parser.read pop -- Consume the accepted terminator exactly once.
        exprs
    end
end

func stack_parser.parse.names.until (stack_parser, array) (array) in -- parser, array<node>
    match parser names in
        parser stack_parser.list.empty not while loop
            names parser stack_parser.parse.name stack_ast_node.& array.append unwrap
            parser stack_parser.list.continue
        pool
        names
    end
end

func stack_parser.parse.cond (stack_parser) (stack_ast_cond) in
    dup stack_parser.read -- parser, tok
    dup2 stack_token.value rot stack_token.pos stack_ast_node.init -- parser, node

    swp dup STACK_TOKEN_ELSE STACK_TOKEN_FI stack_ast_expr.sizeof array.init.with_sz -- node, parser, parser, k1, k2, array
    stack_parser.parse.exprs.until2 -- node, parser, if_

    swp -- node, if_, parser

    dup stack_parser.tok stack_token.kind STACK_TOKEN_ELSE = if -- node, if_, parser
        dup STACK_TOKEN_FI stack_ast_expr.sizeof array.init.with_sz -- node, if_, parser, parser, k, array
        stack_parser.parse.exprs.until -- node, if_, parser, else_
        swp
    else
        stack_ast_expr.sizeof array.init.with_sz -- node, if_, parser, array
        swp
    fi -- node, if_, else_, parser

    pop stack_ast_cond.init -- cond
end

func stack_parser.parse.names.until.in (stack_parser, array) (array) in -- parser, array<node>
    match parser names in
        true while loop
            names parser stack_parser.parse.name stack_ast_node.& array.append unwrap

            parser stack_parser.peek stack_token.kind
            dup STACK_TOKEN_IN = if
                pop false
            else dup STACK_TOKEN_EOF = if
                pop parser "expected 'in' before end of file\n" stack_parser.parse.exprs.error
                false
            else dup STACK_TOKEN_NAME = if
                pop true
            else
                pop parser stack_parser.illegal.check
                parser "expected 'in' after match bindings\n" stack_parser.parse.exprs.error
                false
            fi fi fi
        pool
        names
    end
end

func stack_parser.parse.match (stack_parser) (stack_ast_match) in
    dup stack_parser.read -- parser, tok
    dup2 stack_token.value rot stack_token.pos stack_ast_node.init -- parser, match
    swp -- match, parser

    dup stack_ast_node.sizeof array.init.with_sz -- match, parser, parser, array<node>
    stack_parser.parse.names.until.in swp -- match, array<stack_ast_node>, parser

    dup STACK_TOKEN_IN stack_parser.expect pop -- match, array<node>, parser
    dup STACK_TOKEN_END stack_ast_expr.sizeof array.init.with_sz stack_parser.parse.exprs.until swp pop -- match, binds, exprs
    stack_ast_match.init -- match
end

func stack_parser.parse.while (stack_parser) (stack_ast_while) in
    dup stack_parser.read -- parser, tok
    dup2 stack_token.value rot stack_token.pos stack_ast_node.init -- parser, node

    swp dup STACK_TOKEN_LOOP stack_ast_expr.sizeof array.init.with_sz -- node, parser, parser, k1, array
    stack_parser.parse.exprs.until -- node, parser, while_
    swp -- node, while_, parser

    dup STACK_TOKEN_POOL stack_ast_expr.sizeof array.init.with_sz -- node, while_, parser, parser, k, array
    stack_parser.parse.exprs.until -- node, while_, parser, loop_
    swp -- node, whike_, loop_, parser

    pop stack_ast_while.init -- while
end

func stack_parser.illegal.message (stack_parser) (string) in
    stack_parser.peek match tok in
        tok stack_token.err match err in
            err STACK_ILLEGAL_INVALID = if
                "Invalid character: byte " tok stack_token.value string.concat
            else err STACK_ILLEGAL_STRING_NULL = if
                "String contains null character"
            else err STACK_ILLEGAL_STRING_\N = if
                "String contains new line character"
            else err STACK_ILLEGAL_STRING_EOF = if
                "Unterminated string"
            else err STACK_ILLEGAL_FLOAT_RANGE = if
                "Float out of range: " tok stack_token.value string.concat
            else
                panic ""
            fi fi fi fi fi
        end
        "Lexical Error: " swp string.concat "\n" string.concat
    end
end

func stack_parser.parse.expr (stack_parser) (stack_ast_expr, bool) in
    dup stack_parser.peek stack_token.kind STACK_TOKEN_NAME = if -- parser
        dup stack_parser.read -- parser, tok
        dup stack_token.value swp stack_token.pos stack_ast_node.init -- node
        STACK_AST_EXPR_NAME swp stack_ast_node.& stack_ast_expr.init -- expr
        true
    else dup stack_parser.peek stack_token.kind STACK_TOKEN_NUMBER = if
        dup stack_parser.read -- parser, tok
        dup stack_token.value swp stack_token.pos stack_ast_node.init -- node
        STACK_AST_EXPR_NUMBER swp stack_ast_node.& stack_ast_expr.init -- expr
        true
    else dup stack_parser.peek stack_token.kind STACK_TOKEN_FLOAT = if
        dup stack_parser.read -- parser, tok
        dup stack_token.value swp stack_token.pos stack_ast_node.init -- node
        STACK_AST_EXPR_FLOAT swp stack_ast_node.& stack_ast_expr.init -- expr
        true
    else dup stack_parser.peek stack_token.kind STACK_TOKEN_BOOLEAN = if
        dup stack_parser.read -- parser, tok
        dup stack_token.value swp stack_token.pos stack_ast_node.init -- node
        STACK_AST_EXPR_BOOLEAN swp stack_ast_node.& stack_ast_expr.init -- expr
        true
    else dup stack_parser.peek stack_token.kind STACK_TOKEN_STRING = if
        dup stack_parser.read -- parser, tok
        dup stack_token.value swp stack_token.pos stack_ast_node.init -- node
        STACK_AST_EXPR_STRING swp stack_ast_node.& stack_ast_expr.init -- expr
        true
    else dup stack_parser.peek stack_token.kind STACK_TOKEN_IF = if
        match parser in
            parser stack_parser.enter if
                parser stack_parser.parse.cond -- stack_ast_cond
                STACK_AST_EXPR_COND swp stack_ast_cond.& stack_ast_expr.init -- expr
                true
            else 0 0 int.& stack_ast_expr.init false fi
            parser stack_parser.leave
        end
    else dup stack_parser.peek stack_token.kind STACK_TOKEN_MATCH = if
        match parser in
            parser stack_parser.enter if
                parser stack_parser.parse.match -- stack_ast_match
                STACK_AST_EXPR_MATCH swp stack_ast_match.& stack_ast_expr.init -- expr
                true
            else 0 0 int.& stack_ast_expr.init false fi
            parser stack_parser.leave
        end
    else dup stack_parser.peek stack_token.kind STACK_TOKEN_WHILE = if
        match parser in
            parser stack_parser.enter if
                parser stack_parser.parse.while -- stack_ast_while
                STACK_AST_EXPR_WHILE swp stack_ast_while.& stack_ast_expr.init -- expr
                true
            else 0 0 int.& stack_ast_expr.init false fi
            parser stack_parser.leave
        end
    else dup stack_parser.peek stack_token.kind STACK_TOKEN_ILLEGAL = if
        stack_parser.illegal.check 0 0 int.& stack_ast_expr.init false
    else
        pop 0 0 int.& stack_ast_expr.init false
    fi fi fi fi fi fi fi fi fi -- expr, ok
end

func stack_parser.parse.func (stack_parser) (stack_ast_func) in -- parser
    dup stack_parser.read stack_token.kind STACK_TOKEN_FUNC = unwrap -- parser
    dup STACK_TOKEN_NAME stack_parser.expect -- parser tok
    dup2 stack_token.value rot stack_token.pos stack_ast_node.init swp -- name, parser

    dup STACK_TOKEN_LPAREN stack_parser.expect pop -- name, parser
    dup stack_ast_node.sizeof array.init.with_sz stack_parser.parse.names.until swp -- name, array<stack_ast_node>, parser

    dup STACK_TOKEN_LPAREN stack_parser.expect pop -- name, args, parser
    dup stack_ast_node.sizeof array.init.with_sz stack_parser.parse.names.until swp -- name, args, rets, parser

    dup STACK_TOKEN_IN stack_parser.expect pop -- name, parser
    dup STACK_TOKEN_END stack_ast_expr.sizeof array.init.with_sz stack_parser.parse.exprs.until swp pop -- name, args, rets, exprs
    stack_ast_func.init -- func
end

func stack_parser.parse.data_field.until (stack_parser, array) (array) in -- parser, array<field>
    match parser fields in
        parser stack_parser.list.empty not while loop
            fields
            parser stack_parser.parse.name -- type
            parser stack_parser.parse.name -- type, name
            stack_ast_data_field.init stack_ast_data_field.& array.append unwrap
            parser stack_parser.list.continue
        pool
        fields
    end
end

func stack_parser.parse.data (stack_parser) (stack_ast_data) in -- parser
    dup stack_parser.read stack_token.kind STACK_TOKEN_DATA = unwrap -- parser
    dup STACK_TOKEN_NAME stack_parser.expect -- parser tok
    dup2 stack_token.value rot stack_token.pos stack_ast_node.init swp -- name, parser

    dup STACK_TOKEN_LPAREN stack_parser.expect pop -- name, parser
    dup stack_ast_data_field.sizeof array.init.with_sz stack_parser.parse.data_field.until swp -- name, array<stack_ast_data_field>, parser

    pop -- name, array
    stack_ast_data.init -- data
end

func stack_parser.parse.const (stack_parser) (stack_ast_const) in -- parser
    dup stack_parser.read stack_token.kind STACK_TOKEN_CONST = unwrap -- parser
    dup STACK_TOKEN_NAME stack_parser.expect -- parser tok
    dup2 stack_token.value rot stack_token.pos stack_ast_node.init swp -- name, parser

    dup stack_ast_expr.sizeof array.init.with_sz stack_parser.parse.exprs.while swp -- name, array<stack_ast_data_field>, parser

    pop -- name, array
    stack_ast_const.init -- const
end

func stack_parser.parse.import (stack_parser) (stack_ast_import) in -- parser
    dup stack_parser.read stack_token.kind STACK_TOKEN_IMPORT = unwrap -- parser
    dup STACK_TOKEN_STRING stack_parser.expect -- parser tok
    dup2 stack_token.value over stack_parser.failed not if stack_string.interpret fi
    rot stack_token.pos stack_ast_node.init swp -- name, parser

    pop -- name
    stack_ast_import.init -- import
end

func stack_parser.parse.extern (stack_parser) (stack_ast_extern) in -- parser
    dup stack_parser.read stack_token.kind STACK_TOKEN_EXTERN = unwrap -- parser
    dup STACK_TOKEN_NAME stack_parser.expect -- parser tok
    dup2 stack_token.value rot stack_token.pos stack_ast_node.init swp -- name, parser

    dup STACK_TOKEN_LPAREN stack_parser.expect pop -- name, parser
    dup stack_ast_node.sizeof array.init.with_sz stack_parser.parse.names.until swp -- name, args, parser

    dup STACK_TOKEN_LPAREN stack_parser.expect pop -- name, args, parser
    dup stack_ast_node.sizeof array.init.with_sz stack_parser.parse.names.until swp -- name, args, rets, parser

    dup STACK_TOKEN_STRING stack_parser.expect -- name, args, rets, parser, tok
    dup2 stack_token.value over stack_parser.failed not if stack_string.interpret fi
    rot stack_token.pos stack_ast_node.init swp -- name, args, rets, symbol, parser

    pop stack_ast_extern.init -- extern
end

func stack_parser.parse.unexpected (stack_parser) () in
    match parser in
        parser "'data', 'func', '@import', 'const', or 'extern'" stack_parser.expect.fail
    end
end

-- Parse the file. On an error the result is false and the tree has only the
-- features before the feature with the error.
func stack_parser.parse (stack_parser) (stack_ast, bool) in
    stack_ast.init.empty match parser ast in
        while parser stack_parser.peek stack_token.kind STACK_TOKEN_EOF = not loop
            parser stack_parser.peek stack_token.kind
            dup STACK_TOKEN_DATA = if
                pop parser stack_parser.parse.data
                parser stack_parser.failed if pop else ast swp stack_ast.features.append.data fi
            else dup STACK_TOKEN_FUNC = if
                pop parser stack_parser.parse.func
                parser stack_parser.failed if pop else ast swp stack_ast.features.append.func fi
            else dup STACK_TOKEN_IMPORT = if
                pop parser stack_parser.parse.import
                parser stack_parser.failed if pop else ast swp stack_ast.features.append.import fi
            else dup STACK_TOKEN_CONST = if
                pop parser stack_parser.parse.const
                parser stack_parser.failed if pop else ast swp stack_ast.features.append.const fi
            else dup STACK_TOKEN_EXTERN = if
                pop parser stack_parser.parse.extern
                parser stack_parser.failed if pop else ast swp stack_ast.features.append.extern fi
            else
                pop parser stack_parser.parse.unexpected
            fi fi fi fi fi
        pool
        ast parser stack_parser.failed not
    end
end

data stack_ast_node (stack_parser parser, string value, int pos)
data stack_ast_cond (stack_ast_node cond, array if_, array else_) -- array<stack_ast_expr>, array<stack_ast_expr>
data stack_ast_match (stack_ast_node node, array binds, array exprs) -- array<stack_ast_node>, array<stack_ast_expr>
data stack_ast_while (stack_ast_node node, array while_, array exprs) -- array<stack_ast_expr>, array<stack_ast_expr>

const STACK_AST_EXPR_NUMBER 0
const STACK_AST_EXPR_BOOLEAN 1
const STACK_AST_EXPR_STRING 2
const STACK_AST_EXPR_NAME 3
const STACK_AST_EXPR_COND 4
const STACK_AST_EXPR_MATCH 5
const STACK_AST_EXPR_WHILE 6
const STACK_AST_EXPR_FLOAT 7

data stack_ast_expr (int kind, ptr expr)

data stack_ast_data_field (stack_ast_node type, stack_ast_node name)

data stack_ast_data (stack_ast_node name, array fields)
data stack_ast_func (stack_ast_node name, array args, array rets, array exprs)
data stack_ast_const (stack_ast_node name, array exprs)
data stack_ast_import (stack_ast_node name)
-- An external function. symbol has the interpreted string.
data stack_ast_extern (stack_ast_node name, array args, array rets, stack_ast_node symbol) -- array<node>, array<node>

const STACK_AST_FEATURE_DATA 0
const STACK_AST_FEATURE_FUNC 1
const STACK_AST_FEATURE_CONST 2
const STACK_AST_FEATURE_IMPORT 3
const STACK_AST_FEATURE_EXTERN 4

data stack_ast_feature (int kind, ptr feature)

data stack_ast (array features)

func stack_ast.init.empty () (stack_ast) in
    stack_ast_feature.sizeof array.init.with_sz stack_ast.init
end

func stack_ast.append (stack_ast, stack_ast) () in -- ast, ast'
    stack_ast.features swp stack_ast.features swp array.extend unwrap
end

func stack_ast.features.append (stack_ast, stack_ast_feature) () in
    swp stack_ast.features swp stack_ast_feature.& array.append unwrap
end

func stack_ast.features.append.func (stack_ast, stack_ast_func) () in
    stack_ast_func.& STACK_AST_FEATURE_FUNC swp stack_ast_feature.init stack_ast.features.append
end

func stack_ast.features.append.data (stack_ast, stack_ast_data) () in
    stack_ast_data.& STACK_AST_FEATURE_DATA swp stack_ast_feature.init stack_ast.features.append
end

func stack_ast.features.append.const (stack_ast, stack_ast_const) () in
    stack_ast_const.& STACK_AST_FEATURE_CONST swp stack_ast_feature.init stack_ast.features.append
end

func stack_ast.features.append.import (stack_ast, stack_ast_import) () in
    stack_ast_import.& STACK_AST_FEATURE_IMPORT swp stack_ast_feature.init stack_ast.features.append
end

func stack_ast.features.append.extern (stack_ast, stack_ast_extern) () in
    stack_ast_extern.& STACK_AST_FEATURE_EXTERN swp stack_ast_feature.init stack_ast.features.append
end

func stack_string.interpret (string) (string) in -- string
    dup string.len 2 - 1 swp string.substr -- s\"
    match s in
        "" 0 while dup s string.len < loop -- result, i
            match result i in
                s i string.!! BYTE_\ = if
                    s i 1 + string.!!
                    dup BYTE_n = if
                        pop "\n"
                    else dup BYTE_t = if
                        pop "\t"
                    else dup BYTE_b = if
                        pop "\b"
                    else dup BYTE_f = if
                        pop "\f"
                    else dup BYTE_r = if
                        pop "\r"
                    else
                        pop s i 1 + 1 string.substr
                    fi fi fi fi fi -- chr
                    result swp string.concat i 2 +
                else
                    result s i 1 string.substr string.concat i 1 +
                fi
            end
        pool pop
    end
end
