@import "stdlib"
@import "stack/parser"
@import "stack/preprocessor"
@import "stack/typecheck"
@import "stack/builtins"

-- Analysis of one Stack file for an editor. It finds the names in the file
-- and resolves them with the parser, the preprocessor and the definitions of
-- the type checker. Offsets are byte offsets in the text of the file.

-- Kinds of names in the file.
const STACK_REF_CALL 0    -- a name in a body: a constant, a function or nothing
const STACK_REF_BOUND 1   -- a name in a body that a match binds
const STACK_REF_BINDING 2 -- a match binding
const STACK_REF_TYPE 3    -- a type in a signature or a data field
const STACK_REF_FUNC 4    -- the name of a func
const STACK_REF_DATA 5    -- the name of a data type
const STACK_REF_FIELD 6   -- the name of a data field
const STACK_REF_CONST 7   -- the name of a const

-- The bytes [start, stop) of a name. decl is the stack_ast_func of
-- STACK_REF_FUNC, the stack_ast_data of STACK_REF_DATA, the stack_ast_const
-- of STACK_REF_CONST and the stack_ast_func of the body of STACK_REF_BOUND and
-- STACK_REF_BINDING in a func, else ptr.null. bind is the position of the
-- binding of STACK_REF_BOUND and STACK_REF_BINDING, else -1.
data stack_ref (int kind, int start, int stop, string name, ptr decl, int bind)

-- Kinds of definitions that the type checker accepts.
const STACK_DECL_DATA 0
const STACK_DECL_FUNC 1
const STACK_DECL_REF 2   -- T.& of a data type
const STACK_DECL_DEREF 3 -- T.* of a data type

-- decl is the stack_ast_func of STACK_DECL_FUNC, else the stack_ast_data.
data stack_decl (int kind, string name, ptr decl)

-- refs: array<stack_ref> of the file. decls: array<stack_decl> of the file and
-- its imports. ctx has the builtins and the definitions. pre has the data
-- helpers. parsed is false when the file has a syntax error; then the refs
-- and the definitions are only from the features before the error. docs and
-- shared: array<stack_doc> of the texts that hovers lexed. shared is for the
-- module cache and the caller owns it. types is the stack_types of the
-- bindings.
data stack_analysis (array refs, array decls, stack_context ctx, stack_preprocessor pre, string filename, bool parsed, ptr docs, ptr shared, ptr types)

-- NAMES OF THE FILE

func stack_ref.add.bind (array, int, stack_ast_node, ptr, int) () in -- array<stack_ref>, kind, node, decl, bind
    match refs kind node decl bind in
        node stack_ast_node.value match name in
            node stack_ast_node.pos 0 + match start in
                kind start start name string.len + name decl bind stack_ref.init stack_ref.& match r in
                    refs r array.append unwrap r ptr.free
                end
            end
        end
    end
end

func stack_ref.add (array, int, stack_ast_node, ptr) () in -- array<stack_ref>, kind, node, decl
    -1 stack_ref.add.bind
end

func stack_special.is (string) (bool) in -- name
    match name in
        name STACK_SPECIAL_FILE string.= name STACK_SPECIAL_LINE string.= or name STACK_SPECIAL_COL string.= or
    end
end

-- The position of the innermost binding with the name in scope
-- (array<stack_ast_node>).
func stack_scope.find (array, string) (int, bool) in -- scope, name
    match scope name in
        -1 scope array.count while dup 0 > loop -- pos, i
            1 - match pos i in
                pos 0 < if
                    scope i array.get unwrap stack_ast_node.* match node in
                        node stack_ast_node.value name string.= if node stack_ast_node.pos 0 + else pos fi
                    end
                else pos fi
                i
            end
        pool pop
        dup 0 >=
    end
end

func stack_analysis.names.nodes (array, int, array) () in -- array<stack_ref>, kind, array<stack_ast_node>
    match refs kind nodes in
        0 while dup nodes array.count < loop
            match i in refs kind nodes i array.get unwrap stack_ast_node.* ptr.null stack_ref.add i 1 + end
        pool pop
    end
end

-- scope has the bindings of the enclosing matches (array<stack_ast_node>).
-- owner is the stack_ast_func of the body, or ptr.null in a const.
func stack_analysis.names.exprs (array, array, ptr, array) () in -- array<stack_ref>, scope, owner, array<stack_ast_expr>
    match refs scope owner exprs in
        0 while dup exprs array.count < loop
            match i in
                exprs i array.get unwrap stack_ast_expr.* match expr in
                    expr stack_ast_expr.kind match kind in
                        kind STACK_AST_EXPR_NAME = if
                            expr stack_ast_expr.expr stack_ast_node.* match node in
                                scope node stack_ast_node.value stack_scope.find
                                -- The preprocessor replaces a special name with a literal.
                                node stack_ast_node.value stack_special.is not and
                                match bind bound in
                                    refs bound if STACK_REF_BOUND else STACK_REF_CALL fi node
                                    bound if owner else ptr.null fi
                                    bound if bind else -1 fi
                                    stack_ref.add.bind
                                end
                            end
                        else kind STACK_AST_EXPR_COND = if
                            expr stack_ast_expr.expr stack_ast_cond.* match cond in
                                refs scope owner cond stack_ast_cond.if_ stack_analysis.names.exprs
                                refs scope owner cond stack_ast_cond.else_ stack_analysis.names.exprs
                            end
                        else kind STACK_AST_EXPR_MATCH = if
                            expr stack_ast_expr.expr stack_ast_match.* match m in
                                m stack_ast_match.binds match binds in
                                    0 while dup binds array.count < loop
                                        match j in
                                            binds j array.get unwrap stack_ast_node.* match node in
                                                refs STACK_REF_BINDING node owner node stack_ast_node.pos 0 +
                                                stack_ref.add.bind
                                                scope node stack_ast_node.& array.append unwrap
                                            end
                                            j 1 +
                                        end
                                    pool pop
                                    refs scope owner m stack_ast_match.exprs stack_analysis.names.exprs
                                    0 while dup binds array.count < loop scope array.pop unwrap 1 + pool pop
                                end
                            end
                        else kind STACK_AST_EXPR_WHILE = if
                            expr stack_ast_expr.expr stack_ast_while.* match w in
                                refs scope owner w stack_ast_while.while_ stack_analysis.names.exprs
                                refs scope owner w stack_ast_while.exprs stack_analysis.names.exprs
                            end
                        fi fi fi fi
                    end
                end
                i 1 +
            end
        pool pop
    end
end

-- The names of the features of ast.
func stack_analysis.names (stack_ast) (array) in
    stack_ast.features match features in
        stack_ref.sizeof array.init.with_sz stack_ast_node.sizeof array.init.with_sz match refs scope in
            0 while dup features array.count < loop
                match i in
                    features i array.get unwrap stack_ast_feature.* match feat in
                        feat stack_ast_feature.kind match kind in
                            kind STACK_AST_FEATURE_DATA = if
                                feat stack_ast_feature.feature match p in
                                    p stack_ast_data.* match d in
                                        refs STACK_REF_DATA d stack_ast_data.name p stack_ref.add
                                        d stack_ast_data.fields match fields in
                                            0 while dup fields array.count < loop
                                                match j in
                                                    fields j array.get unwrap stack_ast_data_field.* match field in
                                                        refs STACK_REF_TYPE field stack_ast_data_field.type ptr.null stack_ref.add
                                                        refs STACK_REF_FIELD field stack_ast_data_field.name ptr.null stack_ref.add
                                                    end
                                                    j 1 +
                                                end
                                            pool pop
                                        end
                                    end
                                end
                            else kind STACK_AST_FEATURE_FUNC = if
                                feat stack_ast_feature.feature match p in
                                    p stack_ast_func.* match f in
                                        refs STACK_REF_FUNC f stack_ast_func.name p stack_ref.add
                                        refs STACK_REF_TYPE f stack_ast_func.args stack_analysis.names.nodes
                                        refs STACK_REF_TYPE f stack_ast_func.rets stack_analysis.names.nodes
                                        refs scope p f stack_ast_func.exprs stack_analysis.names.exprs
                                    end
                                end
                            else kind STACK_AST_FEATURE_CONST = if
                                feat stack_ast_feature.feature match p in p stack_ast_const.* match c in
                                    refs STACK_REF_CONST c stack_ast_const.name p stack_ref.add
                                    refs scope ptr.null c stack_ast_const.exprs stack_analysis.names.exprs
                                end end
                            fi fi fi
                        end
                    end
                    i 1 +
                end
            pool pop
            scope array.items ptr.free
            scope array.& ptr.free
            refs
        end
    end
end

-- DEFINITIONS

func stack_decl.add (array, int, string, ptr) () in -- array<stack_decl>, kind, name, decl
    stack_decl.init stack_decl.& match decls d in decls d array.append unwrap d ptr.free end
end

-- The definitions of the files in the order of the type checker: the data
-- types with T.& and T.*, then the functions. The type checker uses the
-- first symbol with a name, after the builtins, and rejects later ones, so
-- the first definition with a name is the one that it uses.
func stack_analysis.defines (stack_ast) (array) in
    stack_ast.features match features in
        stack_decl.sizeof array.init.with_sz match decls in
            0 while dup features array.count < loop
                match i in
                    features i array.get unwrap stack_ast_feature.* match feat in
                        feat stack_ast_feature.kind STACK_AST_FEATURE_DATA = if
                            feat stack_ast_feature.feature match p in
                                p stack_ast_data.* stack_ast_data.name stack_ast_node.value match name in
                                    decls STACK_DECL_DATA name p stack_decl.add
                                    decls STACK_DECL_REF name ".&" string.concat p stack_decl.add
                                    decls STACK_DECL_DEREF name ".*" string.concat p stack_decl.add
                                end
                            end
                        fi
                    end
                    i 1 +
                end
            pool pop
            0 while dup features array.count < loop
                match i in
                    features i array.get unwrap stack_ast_feature.* match feat in
                        feat stack_ast_feature.kind STACK_AST_FEATURE_FUNC = if
                            feat stack_ast_feature.feature match p in
                                decls STACK_DECL_FUNC p stack_ast_func.* stack_ast_func.name stack_ast_node.value p
                                stack_decl.add
                            end
                        fi
                    end
                    i 1 +
                end
            pool pop
            decls
        end
    end
end

-- Analyse the file text with the name filename and the file id. sources
-- are the texts of the open files (array<stack_source>). modules is the
-- module cache (array<stack_module>) and shared has its docs (array<stack_doc>).
func stack_analysis.build (string, string, stack_file_id, array, array, ptr) (stack_analysis) in -- text, filename, id, sources, modules, shared
    match text filename id sources modules shared in
        text filename stack_lexer.init.with_buffer stack_parser.init.with_lexer stack_parser.parse
        match ast parsed in
            ast stack_analysis.names
            id stack_preprocessor.init.with_main match refs pre in
                pre modules stack_preprocessor.cache.use
                0 while dup sources array.count < loop
                    match i in
                        sources i array.get unwrap stack_source.* match src in
                            pre src stack_source.id src stack_source.text stack_preprocessor.sources.add
                        end
                        i 1 +
                    end
                pool pop
                pre ast stack_preprocessor.load pop2
                stack_ast.init.empty stack_context.init.base pre stack_preprocessor.user stack_analysis.defines
                match base ctx decls in
                    pre base stack_preprocessor.run.base.consts
                    refs decls ctx pre filename parsed
                    stack_doc.sizeof array.init.with_sz array.& shared decls base stack_types.new stack_analysis.init
                end
            end
        end
    end
end

-- Free the names, the definitions and the lists of the analysis. The syntax
-- trees and the data helpers stay, because the module cache shares them.
func stack_analysis.free (stack_analysis) () in
    match an in
        an stack_analysis.refs array.items ptr.free
        an stack_analysis.ctx stack_context.symbols array.items ptr.free
        an stack_analysis.pre match pre in
            pre stack_preprocessor.files array.items ptr.free
            pre stack_preprocessor.user stack_ast.features array.items ptr.free
            pre stack_preprocessor.generated stack_ast.features array.items ptr.free
            pre stack_preprocessor.helpers array.items ptr.free
            pre stack_preprocessor.sources array.items ptr.free
        end
        an stack_analysis.decls match decls in
            0 while dup decls array.count < loop
                match i in
                    decls i array.get unwrap stack_decl.* match d in
                        d stack_decl.kind STACK_DECL_REF = d stack_decl.kind STACK_DECL_DEREF = or if
                            d stack_decl.name string.str ptr.free
                        fi
                    end
                    i 1 +
                end
            pool pop
            decls array.items ptr.free
        end
        an stack_analysis.docs array.* match docs in
            0 while dup docs array.count < loop
                match i in
                    docs i array.get unwrap stack_doc.* stack_doc.free
                    i 1 +
                end
            pool pop
            docs array.items ptr.free
            docs array.& ptr.free
        end
        an stack_analysis.types stack_types.free
    end
end

-- LOOKUP

-- The name with start <= offset < stop.
func stack_analysis.find (stack_analysis, int) (stack_ref, bool) in -- an, offset
    match an offset in
        an stack_analysis.refs match refs in
            -1 0 while dup refs array.count < loop -- found, i
                match found i in
                    found 0 < if
                        refs i array.get unwrap stack_ref.* match r in
                            r stack_ref.start offset <= offset r stack_ref.stop < and if i else found fi
                        end
                    else found fi
                    i 1 +
                end
            pool pop
            match found in
                found 0 >= if
                    refs found array.get unwrap stack_ref.* true
                else
                    0 0 0 "" ptr.null -1 stack_ref.init false
                fi
            end
        end
    end
end

func stack_analysis.decl (stack_analysis, string) (stack_decl, bool) in -- an, name
    match an name in
        an stack_analysis.decls match decls in
            -1 0 while dup decls array.count < loop -- found, i
                match found i in
                    found 0 < decls i array.get unwrap stack_decl.* stack_decl.name name string.= and if i else found fi
                    i 1 +
                end
            pool pop
            match found in
                found 0 >= if
                    decls found array.get unwrap stack_decl.* true
                else
                    0 "" ptr.null stack_decl.init false
                fi
            end
        end
    end
end

func stack_analysis.helper (stack_analysis, string) (stack_helper, bool) in -- an, name
    match an name in
        an stack_analysis.pre stack_preprocessor.helpers match helpers in
            -1 0 while dup helpers array.count < loop -- found, i
                match found i in
                    found 0 < helpers i array.get unwrap stack_helper.* stack_helper.node stack_ast_node.value name string.=
                    and if i else found fi
                    i 1 +
                end
            pool pop
            match found in
                found 0 >= if helpers found array.get unwrap stack_helper.* true
                else ptr.null stack_helper.* false fi
            end
        end
    end
end

-- The first constant of the files with the name, not a data helper.
func stack_analysis.const (stack_analysis, string) (stack_ast_const, bool) in -- an, name
    match an name in
        an stack_analysis.pre stack_preprocessor.user stack_ast.features match features in
            -1 0 while dup features array.count < loop -- found, i
                match found i in
                    features i array.get unwrap stack_ast_feature.* match feat in
                        found 0 < feat stack_ast_feature.kind STACK_AST_FEATURE_CONST = and if
                            feat stack_ast_feature.feature stack_ast_const.* stack_ast_const.name stack_ast_node.value
                            name string.= if i else found fi
                        else found fi
                    end
                    i 1 +
                end
            pool pop
            match found in
                found 0 >= if
                    features found array.get unwrap stack_ast_feature.* stack_ast_feature.feature stack_ast_const.* true
                else ptr.null stack_ast_const.* false fi
            end
        end
    end
end

-- TEXT

func stack_signature.text (string, array, array) (string) in -- name, args, rets
    match name args rets in
        name " (" string.concat args array.string.show string.concat ") (" string.concat
        rets array.string.show string.concat ")" string.concat
    end
end

func stack_analysis.func.text (stack_context_func) (string) in
    match f in
        "func " f stack_context_func.name f stack_context_func.args f stack_context_func.rets stack_signature.text
        string.concat
    end
end

func stack_ast_func.text (stack_ast_func) (string) in
    match f in
        "func " f stack_ast_func.name stack_ast_node.value
        f stack_ast_func.args stack_params.node_to_string f stack_ast_func.rets stack_params.node_to_string
        stack_signature.text string.concat
    end
end

func stack_ast_data.text (stack_ast_data) (string) in
    match d in
        d stack_ast_data.fields match fields in
            "data " d stack_ast_data.name stack_ast_node.value string.concat " (" string.concat
            0 while dup fields array.count < loop
                match s i in
                    s i 0 > if ", " string.concat fi
                    fields i array.get unwrap stack_ast_data_field.* match field in
                        field stack_ast_data_field.type stack_ast_node.value string.concat " " string.concat
                        field stack_ast_data_field.name stack_ast_node.value string.concat
                    end
                    i 1 +
                end
            pool pop
            ")" string.concat
        end
    end
end

func stack_helper.note (stack_helper) (string) in
    match h in
        h stack_helper.kind h stack_helper.owner h stack_helper.field match kind owner field in
            kind STACK_HELPER_SIZEOF = if
                owner " size"
            else kind STACK_HELPER_OFFSET = if
                owner "." string.concat field string.concat " offset"
            else kind STACK_HELPER_INIT = if
                owner " constructor"
            else kind STACK_HELPER_GETTER = if
                owner "." string.concat field string.concat " getter"
            else
                owner "." string.concat field string.concat " setter"
            fi fi fi fi
            string.concat
        end
    end
end

-- DOCS

-- The offset of the first byte of the line with the byte at p.
func stack_doc.line (string, int) (int) in -- text, p
    match text p in
        p while dup 0 > if dup 1 - text swp string.!! BYTE_\N = not else false fi loop 1 - pool
    end
end

func stack_doc.space (int) (bool) in
    match c in c BYTE_SPACE = c BYTE_\T = or end
end

-- The offset of the first byte in [i, e) that is not a space or a tab.
func stack_doc.skip (string, int, int) (int) in -- text, i, e
    match text i e in
        i while dup e < if dup text swp string.!! stack_doc.space else false fi loop 1 + pool
    end
end

func stack_doc.dashes (string, int, int) (bool) in -- text, i, e
    match text i e in
        i 2 + e <= if text i string.!! BYTE_- = text i 1 + string.!! BYTE_- = and else false fi
    end
end

-- The bytes [i, e) without the leading -- and one space, or as they are
-- when they are not a comment.
func stack_doc.segment (string, int, int) (string) in -- text, i, e
    match text i e in
        text i e stack_doc.skip match j in
            text j e stack_doc.dashes if
                j 2 + match k in
                    k e < if text k string.!! BYTE_SPACE = else false fi if k 1 + else k fi
                end
            else i fi
        end
        match k in text k e k - string.substr end
    end
end

-- The doc text of the line [i, e) and true when the line is only a comment.
-- A carriage return before e is dropped and the others are line breaks.
func stack_doc.comment (string, int, int) (string, bool) in -- text, i, e
    match text i e in
        text i e stack_doc.skip match j in
            text j e stack_doc.dashes not if
                "" false
            else
                e j > if text e 1 - string.!! 13 = else false fi if e 1 - else e fi
                match e' in
                    "" j j while dup e' <= loop -- out, s, k
                        match out s k in
                            k e' = if true else text k string.!! 13 = fi if
                                out s j > if "\n" string.concat fi text s k stack_doc.segment string.concat
                                k 1 + k 1 +
                            else
                                out s k 1 +
                            fi
                        end
                    pool pop2 true
                end
            fi
        end
    end
end

-- The comment lines just above the line that starts at s and not before
-- lo, without the empty lines at the start and at the end.
func stack_doc.block (string, int, int) (string) in -- text, s, lo
    match text s lo in
        string.sizeof array.init.with_sz match lines in
            s 1 - s lo > while dup loop -- e, more
                pop match e in
                    text e stack_doc.line match i in
                        text i e stack_doc.comment match line ok in
                            ok if
                                line string.& match p in lines p array.append unwrap p ptr.free end
                                i 1 - i lo >
                            else
                                e false
                            fi
                        end
                    end
                end
            pool pop2
            -- lines is from the bottom up.
            0 while dup lines array.count < if dup lines swp array.get unwrap string.* string.len 0 = else false fi loop
                1 +
            pool
            lines array.count while dup2 < if dup 1 - lines swp array.get unwrap string.* string.len 0 = else false fi loop
                1 -
            pool
            match lo' hi in
                "" hi while dup lo' > loop
                    match out k in
                        out k hi < if "\n" string.concat fi lines k 1 - array.get unwrap string.* string.concat
                        k 1 -
                    end
                pool pop
            end
            lines array.items ptr.free
            lines array.& ptr.free
        end
    end
end

-- The doc of the keyword at p. The token before it ends at q, or q is -1.
-- The doc is empty when the keyword is on the line of that token.
func stack_doc.of (string, int, int) (string) in -- text, p, q
    match text p q in
        q 0 < if
            0
        else
            q while dup p < if dup text swp string.!! BYTE_\N = not else false fi loop 1 + pool 1 +
        fi
        match lo in
            lo p > if "" else text text p stack_doc.line lo stack_doc.block fi
        end
    end
end

-- The doc and the code of the definition with the name at pos in the text at
-- buffer. code is the text of a const, else empty. id is the module of the
-- text, or -1 -1. pos is -1 for the mark of a text that is lexed.
data stack_doc (stack_file_id id, ptr buffer, int pos, string text, string code)

func stack_doc.add (array, stack_file_id, ptr, int, string, string) () in -- array<stack_doc>, id, buffer, pos, text, code
    match docs id buffer pos text code in
        id buffer pos text code stack_doc.init stack_doc.& match p in docs p array.append unwrap p ptr.free end
    end
end

func stack_doc.free (stack_doc) () in
    match d in
        d stack_doc.text string.len 0 > if d stack_doc.text string.str ptr.free fi
        d stack_doc.code string.len 0 > if d stack_doc.code string.str ptr.free fi
    end
end

func stack_doc.find (array, stack_file_id, ptr, int) (string, string, bool) in -- array<stack_doc>, id, buffer, pos
    match docs id buffer pos in
        -1 0 while dup docs array.count < loop -- found, i
            match found i in
                found 0 < if
                    docs i array.get unwrap stack_doc.* match d in
                        d stack_doc.buffer buffer ptr.= d stack_doc.pos pos = and d stack_doc.id id stack_file_id.= and
                        if i else found fi
                    end
                else found fi
                i 1 +
            end
        pool pop
        match found in
            found 0 >= if
                docs found array.get unwrap stack_doc.* match d in d stack_doc.text d stack_doc.code true end
            else "" "" false fi
        end
    end
end

-- The state of stack_doc.lex. q is the end of the last token. kind is the
-- keyword before a name, with its doc and its offset start. name is the
-- offset of the name of an open const, depth its open blocks and stop the end
-- of its last token, else -1.
data stack_doc_scan (int q, int kind, string doc, int start, int name, int depth, int stop)

-- Add the open const.
func stack_doc_scan.close (stack_doc_scan, array, stack_file_id, string) () in -- s, docs, id, text
    match s docs id text in
        s stack_doc_scan.name 0 >= if
            docs id text string.str s stack_doc_scan.name 0 + s stack_doc_scan.doc
            text s stack_doc_scan.start 0 + s stack_doc_scan.stop s stack_doc_scan.start - string.substr
            stack_doc.add
            s -1 stack_doc_scan.name.set
        fi
    end
end

-- Read the token of kind k at the bytes [p, e). A const has the expressions
-- that the parser reads after its name.
func stack_doc_scan.step (stack_doc_scan, array, stack_file_id, string, int, int, int) () in -- s, docs, id, text, k, p, e
    match s docs id text k p e in
        k STACK_TOKEN_IF = k STACK_TOKEN_MATCH = or k STACK_TOKEN_WHILE = or
        k STACK_TOKEN_FI = k STACK_TOKEN_END = or k STACK_TOKEN_POOL = or
        match opens closes in
            s stack_doc_scan.name 0 >= if
                s stack_doc_scan.depth 0 > if
                    s s stack_doc_scan.depth 0 + opens if 1 + fi closes if 1 - fi stack_doc_scan.depth.set true
                else
                    opens k STACK_TOKEN_NAME = or k STACK_TOKEN_NUMBER = or k STACK_TOKEN_BOOLEAN = or k STACK_TOKEN_STRING = or
                    if
                        s opens if 1 else 0 fi stack_doc_scan.depth.set true
                    else
                        s docs id text stack_doc_scan.close false
                    fi
                fi
                dup if s e stack_doc_scan.stop.set fi
            else false fi
            not if
                s stack_doc_scan.kind 0 + match pending in
                    s 0 stack_doc_scan.kind.set
                    pending 0 = not k STACK_TOKEN_NAME = and if
                        pending STACK_TOKEN_CONST = if
                            s p stack_doc_scan.name.set s 0 stack_doc_scan.depth.set s e stack_doc_scan.stop.set
                        else s stack_doc_scan.doc string.len 0 > if
                            docs id text string.str p s stack_doc_scan.doc "" stack_doc.add
                        fi fi
                    fi
                end
                k STACK_TOKEN_FUNC = k STACK_TOKEN_DATA = or k STACK_TOKEN_CONST = or if
                    s k stack_doc_scan.kind.set
                    s text p s stack_doc_scan.q 0 + stack_doc.of stack_doc_scan.doc.set
                    s p stack_doc_scan.start.set
                fi
            fi
            s e stack_doc_scan.q.set
        end
    end
end

-- Add the docs of the definitions in text and the code of its consts. The
-- lexer of the compiler finds the comments, so the text of a string is never
-- a doc.
func stack_doc.lex (array, stack_file_id, string) () in -- array<stack_doc>, id, text
    match docs id text in
        -1 0 "" 0 -1 0 0 stack_doc_scan.init match s in
            text "" stack_lexer.init.with_buffer match lexer in
                lexer stack_lexer.next
                while dup stack_token.kind STACK_TOKEN_EOF = not loop
                    match tok in
                        s docs id text tok stack_token.kind 0 + tok stack_token.pos 0 + lexer stack_lexer.pos 0 +
                        stack_doc_scan.step
                        lexer stack_lexer.next
                    end
                pool pop
            end
            s docs id text stack_doc_scan.close
            s stack_doc_scan.& ptr.free
        end
        docs id text string.str -1 "" "" stack_doc.add
    end
end

-- The id of the module in modules (array<stack_module>) with the text at
-- buffer. False when there is none.
func stack_modules.with_text (array, ptr) (stack_file_id, bool) in -- modules, buffer
    match modules buffer in
        -1 -1 stack_file_id.init false 0 while dup modules array.count < loop
            match id found i in
                found if
                    id true
                else modules i array.get unwrap stack_module.* match m in
                    m stack_module.text string.str buffer ptr.= if m stack_module.id true else id false fi
                end fi
                i 1 +
            end
        pool pop
    end
end

-- Remove the docs of the texts that are not in modules (array<stack_module>).
func stack_docs.prune (array, array) () in -- array<stack_doc>, modules
    match docs modules in
        stack_doc.sizeof array.init.with_sz match kept in
            0 while dup docs array.count < loop
                match i in
                    docs i array.get unwrap match p in
                        p stack_doc.* match d in
                            modules d stack_doc.buffer stack_modules.with_text match id found in
                                found if id d stack_doc.id stack_file_id.= else false fi
                            end
                            if kept p array.append unwrap else d stack_doc.free fi
                        end
                    end
                    i 1 +
                end
            pool pop
            docs array.items ptr.free
            docs array.& kept array.& array.sizeof ptr.@ pop
            kept array.& ptr.free
        end
    end
end

-- The doc and the code of the definition with the name node. A text is
-- lexed once: the docs of a module in the module cache are in shared, the
-- others in the analysis.
func stack_analysis.doc (stack_analysis, stack_ast_node) (string, string) in -- an, name
    match an name in
        name stack_ast_node.parser stack_parser.lexer stack_lexer.buffer name stack_ast_node.pos 0 +
        match text p in
            an stack_analysis.pre stack_preprocessor.modules array.* text string.str stack_modules.with_text
            match id shared in
                shared if an stack_analysis.shared else an stack_analysis.docs fi array.* match docs in
                    docs id text string.str -1 stack_doc.find match doc code lexed in
                        lexed not if docs id text stack_doc.lex fi
                    end
                    docs id text string.str p stack_doc.find pop
                end
            end
        end
    end
end

-- TYPES OF BINDINGS

-- The type checker gives the types of the match bindings of a func body, on
-- the first hover of a binding in it. ids index the definitions: the builtin
-- symbols, then the decls, then the constants. table is the hash table of the
-- ids by name (array<int>, -1 is empty). funcs has the positions of the names
-- of the checked funcs (array<int>) and binds their types
-- (array<stack_context_bind>). marks has for each id the number of the last
-- check that uses it (array<int>). base has the builtin constants.
data stack_types
    ( bool built
    , stack_context builtins
    , array decls
    , array consts
    , array table
    , array funcs
    , array binds
    , array marks
    , stack_ast base
    )

const STACK_NAME_BASE 4  -- a builtin symbol
const STACK_NAME_CONST 5 -- a constant

func stack_types.new (array, stack_ast) (ptr) in -- array<stack_decl>, base
    match decls base in
        false stack_context_symbol.sizeof array.init.with_sz true true ptr.null stack_context.init
        decls ptr.sizeof array.init.with_sz int.sizeof array.init.with_sz int.sizeof array.init.with_sz
        stack_context_bind.sizeof array.init.with_sz int.sizeof array.init.with_sz base stack_types.init stack_types.&
    end
end

func stack_ints.has (array, int) (bool) in -- array<int>, n
    match xs n in
        false 0 while dup xs array.count < loop
            match found i in found xs i array.get unwrap int.* n = or i 1 + end
        pool pop
    end
end

func stack_types.kind (stack_types, int) (int) in -- types, id
    match types id in
        types stack_types.builtins stack_context.symbols array.count match nb in
            id nb < if STACK_NAME_BASE
            else id nb - types stack_types.decls array.count < if
                types stack_types.decls id nb - array.get unwrap stack_decl.* stack_decl.kind
            else STACK_NAME_CONST fi fi
        end
    end
end

func stack_types.symbol (stack_types, int) (stack_context_symbol) in -- types, id
    swp stack_types.builtins stack_context.symbols swp array.get unwrap stack_context_symbol.*
end

func stack_types.decl (stack_types, int) (stack_decl) in -- types, id
    match types id in
        types stack_types.decls id types stack_types.builtins stack_context.symbols array.count - array.get unwrap
        stack_decl.*
    end
end

func stack_types.const (stack_types, int) (stack_ast_const) in -- types, id
    match types id in
        types stack_types.consts
        id types stack_types.builtins stack_context.symbols array.count - types stack_types.decls array.count -
        array.get unwrap ptr.* stack_ast_const.*
    end
end

func stack_types.name (stack_types, int) (string) in -- types, id
    match types id in
        types id stack_types.kind match kind in
            kind STACK_NAME_BASE = if types id stack_types.symbol stack_context_symbol.name
            else kind STACK_NAME_CONST = if types id stack_types.const stack_ast_const.name stack_ast_node.value
            else types id stack_types.decl stack_decl.name fi fi
        end
    end
end

-- The hash of the length and of five bytes of the name.
func stack_types.hash (string) (int) in -- name
    match s in
        s string.len match n in
            n n 0 > if
                0 while dup 5 < loop -- h, k
                    match h k in h 31 * s n 1 - k * 4 / string.!! + k 1 + end
                pool pop
            fi
        end
    end
end

-- The first id with the name and the count of the ids with the name: of the
-- constants when consts is true, else of the other definitions.
func stack_types.find (stack_types, string, bool) (int, int) in -- types, name, consts
    match types name consts in
        types stack_types.table match table in
            -1 0 name stack_types.hash table array.count %
            while dup table swp array.get unwrap int.* 0 >= loop -- first, count, slot
                match first count slot in
                    table slot array.get unwrap int.* match id in
                        types id stack_types.kind STACK_NAME_CONST = if consts else consts not fi
                        types id stack_types.name name string.= and if
                            first 0 < id first < or if id else first fi count 1 +
                        else first count fi
                    end
                    slot 1 + table array.count %
                end
            pool pop
        end
    end
end

func stack_types.consts.add (array, stack_ast) () in -- array<ptr>, ast
    match consts ast in
        ast stack_ast.features match features in
            0 while dup features array.count < loop
                match i in
                    features i array.get unwrap stack_ast_feature.* match feat in
                        feat stack_ast_feature.kind STACK_AST_FEATURE_CONST = if
                            consts feat stack_ast_feature.feature ptr.& array.append unwrap
                        fi
                    end
                    i 1 +
                end
            pool pop
        end
    end
end

-- Make the builtin symbols, the list of the constants and the hash table.
func stack_types.build (stack_types, stack_analysis) () in -- types, an
    match types an in
        stack_context.init.base match ctx in
            types stack_types.builtins stack_context.symbols ctx stack_context.symbols array.extend unwrap
            ctx stack_context.symbols array.items ptr.free
            ctx stack_context.& ptr.free
        end
        types stack_types.consts an stack_analysis.pre stack_preprocessor.user stack_types.consts.add
        types stack_types.consts types stack_types.base stack_types.consts.add
        types stack_types.consts an stack_analysis.pre stack_preprocessor.generated stack_types.consts.add
        types stack_types.builtins stack_context.symbols array.count types stack_types.decls array.count +
        types stack_types.consts array.count + match total in
            types stack_types.table match table in
                0 while dup total 2 * 1 + < loop table -1 int.& array.append unwrap 1 + pool pop
                0 while dup total < loop types stack_types.marks -1 int.& array.append unwrap 1 + pool pop
                0 while dup total < loop
                    match id in
                        types id stack_types.name stack_types.hash table array.count %
                        while dup table swp array.get unwrap int.* 0 >= loop 1 + table array.count % pool
                        table swp id int.& array.set unwrap
                        id 1 +
                    end
                pool pop
            end
        end
        types true stack_types.built.set
    end
end

-- A copy of the expressions that the preprocessor can change.
func stack_exprs.copy (array) (array) in -- array<stack_ast_expr>
    match exprs in
        stack_ast_expr.sizeof array.init.with_sz match out in
            0 while dup exprs array.count < loop
                match i in
                    exprs i array.get unwrap stack_ast_expr.* match e in
                        e stack_ast_expr.kind match kind in
                            kind
                            kind STACK_AST_EXPR_COND = if
                                e stack_ast_expr.expr stack_ast_cond.* match c in
                                    c stack_ast_cond.cond c stack_ast_cond.if_ stack_exprs.copy
                                    c stack_ast_cond.else_ stack_exprs.copy stack_ast_cond.init stack_ast_cond.&
                                end
                            else kind STACK_AST_EXPR_MATCH = if
                                e stack_ast_expr.expr stack_ast_match.* match m in
                                    m stack_ast_match.node m stack_ast_match.binds array.copy unwrap
                                    m stack_ast_match.exprs stack_exprs.copy stack_ast_match.init stack_ast_match.&
                                end
                            else kind STACK_AST_EXPR_WHILE = if
                                e stack_ast_expr.expr stack_ast_while.* match w in
                                    w stack_ast_while.node w stack_ast_while.while_ stack_exprs.copy
                                    w stack_ast_while.exprs stack_exprs.copy stack_ast_while.init stack_ast_while.&
                                end
                            else
                                e stack_ast_expr.expr stack_ast_node.* match node in
                                    node stack_ast_node.parser node stack_ast_node.value node stack_ast_node.pos 0 +
                                    stack_ast_node.init stack_ast_node.&
                                end
                            fi fi fi
                            stack_ast_expr.init stack_ast_expr.& match x in out x array.append unwrap x ptr.free end
                        end
                    end
                    i 1 +
                end
            pool pop
            out
        end
    end
end

-- Free a copy and the expansions of the preprocessor in it.
func stack_exprs.free (array) () in -- array<stack_ast_expr>
    match exprs in
        0 while dup exprs array.count < loop
            match i in
                exprs i array.get unwrap stack_ast_expr.* match e in
                    e stack_ast_expr.kind match kind in
                        kind STACK_AST_EXPR_COND = if
                            e stack_ast_expr.expr stack_ast_cond.* match c in
                                c stack_ast_cond.if_ stack_exprs.free c stack_ast_cond.else_ stack_exprs.free
                            end
                        else kind STACK_AST_EXPR_MATCH = if
                            e stack_ast_expr.expr stack_ast_match.* match m in
                                m stack_ast_match.binds array.items ptr.free m stack_ast_match.exprs stack_exprs.free
                            end
                        else kind STACK_AST_EXPR_WHILE = if
                            e stack_ast_expr.expr stack_ast_while.* match w in
                                w stack_ast_while.while_ stack_exprs.free w stack_ast_while.exprs stack_exprs.free
                            end
                        fi fi fi
                        e stack_ast_expr.expr ptr.free
                    end
                end
                i 1 +
            end
        pool pop
        exprs array.items ptr.free
    end
end

-- Append the names in exprs to names and the bindings to binds (array<string>).
func stack_exprs.names (array, array, array) () in -- array<stack_ast_expr>, names, binds
    match exprs names binds in
        0 while dup exprs array.count < loop
            match i in
                exprs i array.get unwrap stack_ast_expr.* match e in
                    e stack_ast_expr.kind match kind in
                        kind STACK_AST_EXPR_NAME = if
                            names e stack_ast_expr.expr stack_ast_node.* stack_ast_node.value string.& array.append unwrap
                        else kind STACK_AST_EXPR_COND = if
                            e stack_ast_expr.expr stack_ast_cond.* match c in
                                c stack_ast_cond.if_ names binds stack_exprs.names
                                c stack_ast_cond.else_ names binds stack_exprs.names
                            end
                        else kind STACK_AST_EXPR_MATCH = if
                            e stack_ast_expr.expr stack_ast_match.* match m in
                                m stack_ast_match.binds match nodes in
                                    0 while dup nodes array.count < loop
                                        match j in
                                            binds nodes j array.get unwrap stack_ast_node.* stack_ast_node.value string.&
                                            array.append unwrap
                                            j 1 +
                                        end
                                    pool pop
                                end
                                m stack_ast_match.exprs names binds stack_exprs.names
                            end
                        else kind STACK_AST_EXPR_WHILE = if
                            e stack_ast_expr.expr stack_ast_while.* match w in
                                w stack_ast_while.while_ names binds stack_exprs.names
                                w stack_ast_while.exprs names binds stack_exprs.names
                            end
                        fi fi fi fi
                    end
                end
                i 1 +
            end
        pool pop
    end
end

-- Visit the constants that names use, as the cycle check of the preprocessor.
-- done gets them after the constants that they use (array<int>). False on a
-- cycle or on a constant with more than one definition.
func stack_types.visit (stack_types, array, array, array) (bool) in -- types, names, active, done
    match types names active done in
        true 0 while dup names array.count < loop -- ok, i
            match ok i in
                ok if
                    types names i array.get unwrap string.* true stack_types.find match id count in
                        count 0 = if true
                        else count 1 > if false
                        else active id stack_ints.has if false
                        else done id stack_ints.has if true
                        else
                            stack_strings.new stack_strings.new match names' binds' in
                                types id stack_types.const stack_ast_const.exprs names' binds' stack_exprs.names
                                active id int.& array.append unwrap
                                types names' active done stack_types.visit
                                active array.pop unwrap
                                dup if done id int.& array.append unwrap fi
                                names' array.items ptr.free binds' array.items ptr.free
                            end
                        fi fi fi fi
                    end
                else false fi
                i 1 +
            end
        pool pop
    end
end

-- Expand the constants in body as the preprocessor does: a constant before
-- the constants that it uses. False when visit is false.
func stack_types.expand (stack_types, array) (bool) in -- types, body
    match types body in
        stack_strings.new stack_strings.new int.sizeof array.init.with_sz int.sizeof array.init.with_sz
        match names binds active done in
            body names binds stack_exprs.names
            types names active done stack_types.visit match ok in
                ok if
                    done array.count while dup 0 > loop
                        1 - match k in
                            body types done k array.get unwrap int.* stack_types.const
                            stack_preprocessor.run.expand.exprs
                            k
                        end
                    pool pop
                fi
                names array.items ptr.free binds array.items ptr.free
                active array.items ptr.free done array.items ptr.free
                ok
            end
        end
    end
end

-- Mark the ids of the definitions of names with check, and append the types
-- of their signatures to sigs once for each id. False when a name has more
-- than one definition.
func stack_types.need (stack_types, array, int, array) (bool) in -- types, names, check, sigs
    match types names check sigs in
        true 0 while dup names array.count < loop -- ok, i
            match ok i in
                ok if
                    types names i array.get unwrap string.* false stack_types.find match id count in
                        count 1 > if false
                        else count 1 = if
                            types stack_types.marks id array.get unwrap int.* check = not if
                                types stack_types.marks id check int.& array.set unwrap
                                types id stack_types.kind match kind in
                                    kind STACK_NAME_BASE = if
                                        types id stack_types.symbol match sym in
                                            sym stack_context_symbol.kind STACK_CONTEXT_SYMBOL_FUNC = if
                                                sym stack_context_symbol.symbol stack_context_func.* match fn in
                                                    sigs fn stack_context_func.args array.extend unwrap
                                                    sigs fn stack_context_func.rets array.extend unwrap
                                                end
                                            fi
                                        end
                                    else kind STACK_DECL_FUNC = if
                                        types id stack_types.decl stack_decl.decl stack_ast_func.* match fn in
                                            fn stack_ast_func.args stack_params.node_to_string match xs in
                                                sigs xs array.extend unwrap xs array.items ptr.free
                                            end
                                            fn stack_ast_func.rets stack_params.node_to_string match xs in
                                                sigs xs array.extend unwrap xs array.items ptr.free
                                            end
                                        end
                                    else kind STACK_DECL_DATA = not if
                                        sigs types id stack_types.decl stack_decl.decl stack_ast_data.* stack_ast_data.name
                                        stack_ast_node.value string.& array.append unwrap
                                        sigs STACK_DATA_PTR string.& array.append unwrap
                                    fi fi fi
                                end
                            fi
                            true
                        else true fi fi
                    end
                else false fi
                i 1 +
            end
        pool pop
    end
end

-- The symbol of the decl id for the type checker.
func stack_types.decl.symbol (stack_types, int) (int, ptr) in -- types, id
    match types id in
        types id stack_types.decl match d in
            d stack_decl.kind match kind in
                kind STACK_DECL_FUNC = if
                    d stack_decl.decl stack_ast_func.* match fn in
                        STACK_CONTEXT_SYMBOL_FUNC
                        d stack_decl.name fn stack_ast_func.args stack_params.node_to_string
                        fn stack_ast_func.rets stack_params.node_to_string stack_context_func.init stack_context_func.&
                    end
                else kind STACK_DECL_DATA = if
                    STACK_CONTEXT_SYMBOL_DATA d stack_decl.name stack_context_data.init stack_context_data.&
                else
                    STACK_CONTEXT_SYMBOL_FUNC d stack_decl.decl stack_ast_data.* stack_ast_data.name stack_ast_node.value
                    kind STACK_DECL_REF = if stack_context_func.init.data_ref else stack_context_func.init.data_deref fi
                    stack_context_func.&
                fi fi
            end
        end
    end
end

-- The symbols for the type checker of f with body: the builtins, then the
-- definitions of the names in body and in the signatures, in the order of
-- the type checker. ids gets the decl ids of the symbols after the builtins.
-- The type checker only looks up these names, so it finds the same symbols
-- as with all definitions. False when a name has more than one definition.
func stack_types.symbols (stack_types, stack_ast_func, array, array) (array, bool) in -- types, f, body, ids
    match types f body ids in
        stack_strings.new stack_strings.new stack_strings.new types stack_types.funcs array.count 0 +
        match names sigs sigs' check in
            body names names stack_exprs.names
            names f stack_ast_func.name stack_ast_node.value string.& array.append unwrap
            f stack_ast_func.args stack_params.node_to_string match xs in names xs array.extend unwrap xs array.items ptr.free end
            f stack_ast_func.rets stack_params.node_to_string match xs in names xs array.extend unwrap xs array.items ptr.free end
            names STACK_DATA_INT string.& array.append unwrap
            names STACK_DATA_BOOL string.& array.append unwrap
            names STACK_DATA_PTR string.& array.append unwrap
            names STACK_DATA_STRING string.& array.append unwrap
            types names check sigs stack_types.need
            types sigs check sigs' stack_types.need and
            match ok in
                types stack_types.builtins stack_context.symbols match builtins in
                    builtins array.copy unwrap match symbols in
                        ok if
                            builtins array.count match nb in
                                nb while dup nb types stack_types.decls array.count + < loop
                                    match id in
                                        types stack_types.marks id array.get unwrap int.* check = if
                                            ids id int.& array.append unwrap
                                            types id stack_types.decl.symbol stack_context_symbol.init stack_context_symbol.&
                                            match s in symbols s array.append unwrap s ptr.free end
                                        fi
                                        id 1 +
                                    end
                                pool pop
                            end
                        fi
                        names array.items ptr.free sigs array.items ptr.free sigs' array.items ptr.free
                        symbols ok
                    end
                end
            end
        end
    end
end

-- Free the symbols after the builtins (decl ids in ids) and the list.
func stack_types.symbols.free (stack_types, array, array) () in -- types, symbols, ids
    match types symbols ids in
        types stack_types.builtins stack_context.symbols array.count match nb in
            0 while dup ids array.count < loop
                match i in
                    symbols nb i + array.get unwrap stack_context_symbol.* stack_context_symbol.symbol match p in
                        types ids i array.get unwrap int.* stack_types.decl stack_decl.kind match kind in
                            kind STACK_DECL_DATA = not if
                                p stack_context_func.* match fn in
                                    fn stack_context_func.args array.items ptr.free
                                    fn stack_context_func.rets array.items ptr.free
                                    kind STACK_DECL_FUNC = not if fn stack_context_func.name string.str ptr.free fi
                                end
                            fi
                        end
                        p ptr.free
                    end
                    i 1 +
                end
            pool pop
        end
        symbols array.items ptr.free
    end
end

-- Check the body of f with the type checker and keep the types of its
-- bindings. Errors in other funcs do not change them.
func stack_types.check (stack_types, stack_ast_func) () in -- types, f
    match types f in
        types stack_types.funcs f stack_ast_func.name stack_ast_node.pos 0 + int.& array.append unwrap
        f stack_ast_func.exprs stack_exprs.copy int.sizeof array.init.with_sz match body ids in
            types body stack_types.expand if
                body stack_preprocessor.run.expand.special.exprs
                types f body ids stack_types.symbols match symbols ok in
                    -- ctx has the list of symbols now. The type checker changes it.
                    symbols true true types stack_types.binds array.& stack_context.init symbols array.& ptr.free
                    match ctx in
                        ok if
                            f stack_ast_func.args stack_params.node_to_string match stack in
                                ctx stack body stack_context.typecheck.exprs
                                stack array.items ptr.free
                            end
                        fi
                        types ctx stack_context.symbols ids stack_types.symbols.free
                        ctx stack_context.& ptr.free
                    end
                end
            fi
            body stack_exprs.free
            ids array.items ptr.free
        end
    end
end

-- The type of the binding at pos in the body of f.
func stack_analysis.bind.type (stack_analysis, stack_ast_func, int) (string, bool) in -- an, f, pos
    match an f pos in
        an stack_analysis.types stack_types.* match types in
            types stack_types.built not if types an stack_types.build fi
            types stack_types.funcs f stack_ast_func.name stack_ast_node.pos 0 + stack_ints.has not if
                types f stack_types.check
            fi
            types stack_types.binds match binds in
                -1 0 while dup binds array.count < loop -- found, i
                    match found i in
                        found 0 < binds i array.get unwrap stack_context_bind.* stack_context_bind.pos pos = and
                        if i else found fi
                        i 1 +
                    end
                pool pop
                match found in
                    found 0 >= if
                        binds found array.get unwrap stack_context_bind.* stack_context_bind.type true
                    else "" false fi
                end
            end
        end
    end
end

-- Free the types of the analysis.
func stack_types.free (ptr) () in
    match p in
        p stack_types.* match types in
            types stack_types.builtins stack_context.symbols match symbols in
                0 while dup symbols array.count < loop
                    match i in
                        symbols i array.get unwrap stack_context_symbol.* match sym in
                            sym stack_context_symbol.kind STACK_CONTEXT_SYMBOL_FUNC = if
                                sym stack_context_symbol.symbol stack_context_func.* match fn in
                                    fn stack_context_func.args array.items ptr.free
                                    fn stack_context_func.rets array.items ptr.free
                                end
                            fi
                            sym stack_context_symbol.symbol ptr.free
                        end
                        i 1 +
                    end
                pool pop
                symbols array.items ptr.free
            end
            types stack_types.consts array.items ptr.free
            types stack_types.table array.items ptr.free
            types stack_types.funcs array.items ptr.free
            types stack_types.binds array.items ptr.free
            types stack_types.marks array.items ptr.free
            types stack_types.base stack_ast.features array.items ptr.free
        end
        p ptr.free
    end
end

-- HOVER

-- The description of a builtin function, or empty.
func stack_builtin.doc (string) (string) in
    match name in
        name STACK_FUNC_PTR_ALLOC string.= if "Allocate n bytes."
        else name STACK_FUNC_PTR_FREE string.= if "Free an allocated block."
        else name STACK_FUNC_PTR_OFFSET string.= if "Add a byte offset."
        else name STACK_FUNC_PTR_COPY string.= if "Copy n bytes from src to dst and return dst."
        else name STACK_FUNC_INT_REF string.= if "Address of the value."
        else name STACK_FUNC_PTR_REF string.= if "Address of the value."
        else name STACK_FUNC_BOOL_REF string.= if "Address of the value."
        else name STACK_FUNC_INT_DEREF string.= if "Dereference as int."
        else name STACK_FUNC_PTR_DEREF string.= if "Dereference as ptr."
        else name STACK_FUNC_BOOL_DEREF string.= if "Dereference as bool."
        else name STACK_FUNC_DUP string.= if "Duplicate the top item."
        else name STACK_FUNC_SWP string.= if "Swap the top two items."
        else name STACK_FUNC_ROT string.= if "Rotate (a, b, c) to (b, c, a)."
        else name STACK_FUNC_ROT4 string.= if "Rotate (a, b, c, d) to (b, c, d, a)."
        else name STACK_FUNC_POP string.= if "Remove the top item."
        else name STACK_FUNC_PLUS string.= if "Add two integers."
        else name STACK_FUNC_MINUS string.= if "Subtract two integers."
        else name STACK_FUNC_STAR string.= if "Multiply two integers."
        else name STACK_FUNC_DIV string.= if "Signed integer division."
        else name STACK_FUNC_MOD string.= if "Signed integer remainder."
        else name STACK_FUNC_OR string.= if "Bitwise OR."
        else name STACK_FUNC_AND string.= if "Bitwise AND."
        else name STACK_FUNC_XOR string.= if "Bitwise XOR."
        else name STACK_FUNC_SHL string.= if "Shift left"
        else name STACK_FUNC_SHR string.= if "Shift right"
        else name STACK_FUNC_GT string.= if "Greater than."
        else name STACK_FUNC_LT string.= if "Less than."
        else name STACK_FUNC_EQ string.= if "Equal."
        else name STACK_FUNC_ENV string.= if "Pointer to the environment variable array."
        else name STACK_FUNC_SYSCALL1 string.= if "Linux syscall with one argument."
        else name STACK_FUNC_SYSCALL3 string.= if "Linux syscall with three arguments."
        else name STACK_FUNC_PICK string.= if "duplicate item n on top of the stack as a pointer"
        else ""
        fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi
    end
end


func stack_analysis.hover.data (stack_analysis, stack_ast_data) (bool, string, string, string) in -- an, d
    match an d in true d stack_ast_data.text "" an d stack_ast_data.name stack_analysis.doc pop end
end

func stack_analysis.hover.const (stack_analysis, stack_ast_const) (bool, string, string, string) in -- an, c
    match an c in
        an c stack_ast_const.name stack_analysis.doc match doc code in
            true code string.len 0 > if code else "const " c stack_ast_const.name stack_ast_node.value string.concat fi
            "" doc
        end
    end
end

func stack_analysis.hover.type (stack_analysis, string) (bool, string, string, string) in -- an, name
    match an name in
        an stack_analysis.ctx name stack_context.get_symbol match builtin symbol in
            builtin if
                symbol stack_context_symbol.* stack_context_symbol.kind STACK_CONTEXT_SYMBOL_DATA = if
                    true "data " name string.concat "Builtin data type." ""
                else false "" "" "" fi
            else an name stack_analysis.decl match d found in
                found if d stack_decl.kind STACK_DECL_DATA = else false fi if
                    an d stack_decl.decl stack_ast_data.* stack_analysis.hover.data
                else false "" "" "" fi
            end fi
        end
    end
end

func stack_analysis.hover.decl (stack_analysis, stack_decl) (bool, string, string, string) in -- an, d
    match an d in
        d stack_decl.kind match kind in
            kind STACK_DECL_FUNC = if
                d stack_decl.decl stack_ast_func.* match f in
                    true f stack_ast_func.text "" an f stack_ast_func.name stack_analysis.doc pop
                end
            else kind STACK_DECL_DATA = if
                false "" "" ""
            else
                d stack_decl.decl stack_ast_data.* stack_ast_data.name stack_ast_node.value match owner in
                    true
                    owner kind STACK_DECL_REF = if stack_context_func.init.data_ref else stack_context_func.init.data_deref fi
                    stack_analysis.func.text
                    owner kind STACK_DECL_REF = if " reference" else " dereference" fi string.concat ""
                end
            fi fi
        end
    end
end

func stack_analysis.hover.call (stack_analysis, string) (bool, string, string, string) in -- an, name
    match an name in
        an name stack_analysis.helper match h is_helper in
            is_helper if
                true
                h stack_helper.node stack_ast_node.value h stack_helper.args h stack_helper.rets stack_signature.text
                h stack_helper.note ""
            else an name stack_analysis.const match c is_const in is_const if
                an c stack_analysis.hover.const
            else name stack_special.is if
                false "" "" ""
            else an stack_analysis.ctx name stack_context.get_symbol match builtin symbol in
                builtin if
                    symbol stack_context_symbol.* match sym in
                        sym stack_context_symbol.kind STACK_CONTEXT_SYMBOL_FUNC = if
                            true sym stack_context_symbol.symbol stack_context_func.* stack_analysis.func.text
                            name stack_builtin.doc match doc in
                                doc string.len 0 > if "" doc else "Builtin function." "" fi
                            end
                        else false "" "" "" fi
                    end
                else an name stack_analysis.decl match d found in
                    found if an d stack_analysis.hover.decl else false "" "" "" fi
                end fi
            end fi fi end fi
        end
    end
end

-- A binding and a bound name show "name: type" when the type checker gives
-- the type of the binding.
func stack_analysis.hover.bind (stack_analysis, stack_ref) (bool, string, string, string) in -- an, r
    match an r in
        r stack_ref.bind 0 < r stack_ref.decl ptr.null ptr.= or if
            false "" "" ""
        else
            an r stack_ref.decl stack_ast_func.* r stack_ref.bind stack_analysis.bind.type match type ok in
                ok if true r stack_ref.name ": " string.concat type string.concat "" "" else false "" "" "" fi
            end
        fi
    end
end

-- The hover text at offset: found, the bytes [start, stop) of the name, the
-- code, a note and the doc comment of the definition. Not found for literals,
-- keywords, type variables, names that do not resolve and bindings without a
-- type. A bound name that is a constant is the constant, as the preprocessor
-- expands it.
func stack_analysis.hover (stack_analysis, int) (bool, int, int, string, string, string) in -- an, offset
    match an offset in
        an offset stack_analysis.find match r found in
            found not if
                false "" "" ""
            else r stack_ref.kind match kind in
                kind STACK_REF_FUNC = if
                    r stack_ref.decl stack_ast_func.* match f in
                        true f stack_ast_func.text "" an f stack_ast_func.name stack_analysis.doc pop
                    end
                else kind STACK_REF_DATA = if
                    an r stack_ref.decl stack_ast_data.* stack_analysis.hover.data
                else kind STACK_REF_CONST = if
                    an r stack_ref.decl stack_ast_const.* stack_analysis.hover.const
                else kind STACK_REF_TYPE = if
                    an r stack_ref.name stack_analysis.hover.type
                else kind STACK_REF_CALL = if
                    an r stack_ref.name stack_analysis.hover.call
                else kind STACK_REF_BOUND = if
                    an r stack_ref.name stack_analysis.helper swp pop an r stack_ref.name stack_analysis.const swp pop or
                    if an r stack_ref.name stack_analysis.hover.call else an r stack_analysis.hover.bind fi
                else kind STACK_REF_BINDING = if
                    an r stack_analysis.hover.bind
                else
                    false "" "" ""
                fi fi fi fi fi fi fi
            end fi
            match ok code note doc in ok r stack_ref.start 0 + r stack_ref.stop 0 + code note doc end
        end
    end
end

-- DEFINITIONS

-- A definition is found, the stack_lexer of its file and the bytes
-- [start, stop) of its name. The lexer is ptr.null for the analysed file.

func stack_definition.none () (bool, ptr, int, int) in false ptr.null 0 0 end

-- The name node of a definition when its text has name at its position. A
-- node that the compiler makes, as the sizeof of a builtin type, has none.
func stack_definition.node (stack_ast_node, string) (bool, ptr, int, int) in -- node, name
    match node name in
        node stack_ast_node.parser stack_parser.lexer node stack_ast_node.pos 0 + name string.len match lexer p n in
            lexer stack_lexer.buffer match text in
                p 0 >= p n + text string.len <= and if
                    text string.str p ptr.+ name string.str n ptr.memcmp 0 =
                else false fi
            end
            if true lexer stack_lexer.& p p n + else stack_definition.none fi
        end
    end
end

-- The data type or the field of a data helper.
func stack_definition.helper (stack_helper) (bool, ptr, int, int) in -- h
    match h in
        h stack_helper.kind match kind in
            h stack_helper.node kind STACK_HELPER_SIZEOF = kind STACK_HELPER_INIT = or
            if h stack_helper.owner else h stack_helper.field fi
            stack_definition.node
        end
    end
end

-- A func, a data type, or the data type of T.& and T.*.
func stack_definition.decl (stack_decl) (bool, ptr, int, int) in -- d
    match d in
        d stack_decl.kind STACK_DECL_FUNC = if
            d stack_decl.decl stack_ast_func.* stack_ast_func.name
        else
            d stack_decl.decl stack_ast_data.* stack_ast_data.name
        fi
        dup stack_ast_node.value stack_definition.node
    end
end

-- A name in a body, in the order of the compiler: the preprocessor expands
-- the data helpers, the constants and the special names first, then the type
-- checker uses the builtins and then the definitions.
func stack_analysis.definition.call (stack_analysis, string) (bool, ptr, int, int) in -- an, name
    match an name in
        an name stack_analysis.helper match h is_helper in
            is_helper if
                h stack_definition.helper
            else an name stack_analysis.const match c is_const in is_const if
                c stack_ast_const.name dup stack_ast_node.value stack_definition.node
            else name stack_special.is an stack_analysis.ctx name stack_context.get_symbol pop or if
                stack_definition.none
            else an name stack_analysis.decl match d found in
                found if d stack_definition.decl else stack_definition.none fi
            end fi fi end fi
        end
    end
end

-- A type in a signature or a data field: a data type that is not a builtin.
func stack_analysis.definition.type (stack_analysis, string) (bool, ptr, int, int) in -- an, name
    match an name in
        an stack_analysis.ctx name stack_context.get_symbol pop if
            stack_definition.none
        else an name stack_analysis.decl match d found in
            found if d stack_decl.kind STACK_DECL_DATA = else false fi
            if d stack_definition.decl else stack_definition.none fi
        end fi
    end
end

-- The definition of the name at offset. A definition is its own definition.
-- A bound name is the binding of the innermost match, if the preprocessor
-- does not expand it and it is not a builtin. Not found for literals,
-- keywords, special names, builtins, type variables and names that do not
-- resolve.
func stack_analysis.definition (stack_analysis, int) (bool, ptr, int, int) in -- an, offset
    match an offset in
        an offset stack_analysis.find match r found in
            found not if
                stack_definition.none
            else r stack_ref.kind r stack_ref.name match kind name in
                kind STACK_REF_FUNC = kind STACK_REF_DATA = or kind STACK_REF_FIELD = or
                kind STACK_REF_CONST = or kind STACK_REF_BINDING = or if
                    true ptr.null r stack_ref.start 0 + r stack_ref.stop 0 +
                else kind STACK_REF_TYPE = if
                    an name stack_analysis.definition.type
                else kind STACK_REF_CALL = if
                    an name stack_analysis.definition.call
                else kind STACK_REF_BOUND = if
                    an name stack_analysis.helper swp pop an name stack_analysis.const swp pop or
                    an stack_analysis.ctx name stack_context.get_symbol pop or
                    if
                        an name stack_analysis.definition.call
                    else
                        true ptr.null r stack_ref.bind 0 + r stack_ref.bind name string.len +
                    fi
                else
                    stack_definition.none
                fi fi fi fi
            end fi
        end
    end
end

-- COMPLETION

-- What can replace the name at the cursor.
const STACK_COMPLETE_NONE 0
const STACK_COMPLETE_VALUE 1 -- a name in a body
const STACK_COMPLETE_TYPE 2  -- a type in a signature or a data field

-- Kinds of completion items, with the values of the LSP CompletionItemKind.
const STACK_ITEM_FUNCTION 3
const STACK_ITEM_CONSTRUCTOR 4
const STACK_ITEM_FIELD 5
const STACK_ITEM_VARIABLE 6
const STACK_ITEM_CONSTANT 21
const STACK_ITEM_STRUCT 22

-- detail is empty when it is not known.
data stack_item (string label, int kind, string detail)

-- A name that the scan finds: a match binding (STACK_TOKEN_MATCH) or the
-- name of a definition (STACK_TOKEN_FUNC, STACK_TOKEN_CONST or
-- STACK_TOKEN_DATA), and its position.
data stack_scan_name (int kind, string name, int pos)

-- States of the scan.
const STACK_SCAN_TOP 0
const STACK_SCAN_NAME 1   -- after func, data or const
const STACK_SCAN_SIG 2    -- the signature of a func
const STACK_SCAN_DATA 3   -- the fields of a data type
const STACK_SCAN_BODY 4   -- the body of a func or a const
const STACK_SCAN_BINDS 5  -- the bindings of a match, before in
const STACK_SCAN_IMPORT 6 -- after @import

-- The scan reads the tokens of the lexer of the compiler and does not need a
-- syntax tree, so it also works in code that is not complete. decl is the
-- keyword of STACK_SCAN_NAME. paren is true in parentheses and field is
-- true before the name of a field. blocks has the open blocks (array<int>:
-- STACK_TOKEN_FUNC, STACK_TOKEN_MATCH, STACK_TOKEN_IF or STACK_TOKEN_WHILE)
-- and marks the count of binds when each opened. binds has the bindings of
-- the open matches and mark their count before the open match. names has
-- the definitions of the text.
data stack_scan (int state, int decl, bool paren, bool field, int mark, array blocks, array marks, array binds, array names)

func stack_scan.new () (stack_scan) in
    int.sizeof array.init.with_sz int.sizeof array.init.with_sz
    stack_scan_name.sizeof array.init.with_sz stack_scan_name.sizeof array.init.with_sz
    match blocks marks binds names in
        STACK_SCAN_TOP 0 false false 0 blocks marks binds names stack_scan.init
        blocks array.& ptr.free
        marks array.& ptr.free
        binds array.& ptr.free
        names array.& ptr.free
    end
end

func stack_scan_names.add (array, int, string, int) () in -- array<stack_scan_name>, kind, name, pos
    stack_scan_name.init stack_scan_name.& match names p in names p array.append unwrap p ptr.free end
end

-- Keep the first n bindings.
func stack_scan.cut (stack_scan, int) () in -- s, n
    match s n in s stack_scan.binds match binds in binds array.count n > if binds n array.count.set fi end end
end

func stack_scan.reset (stack_scan) () in
    match s in
        s 0 stack_scan.cut
        s stack_scan.blocks 0 array.count.set
        s stack_scan.marks 0 array.count.set
    end
end

func stack_scan.push (stack_scan, int, int) () in -- s, kind, mark
    match s kind mark in
        s stack_scan.blocks kind int.& array.append unwrap
        s stack_scan.marks mark int.& array.append unwrap
    end
end

func stack_scan.pop (stack_scan) () in
    match s in
        s stack_scan.marks match marks in
            s marks array.last unwrap int.* 0 + stack_scan.cut
            marks array.pop unwrap
        end
        s stack_scan.blocks array.pop unwrap
    end
end

-- Close the innermost block of kind and the blocks in it. STACK_TOKEN_END
-- closes a match or a func. A fi or a pool does not close a match or a
-- func. The kind of the closed block, or -1.
func stack_scan.close (stack_scan, int) (int) in -- s, kind
    match s kind in
        -1 true while dup loop -- closed, more
            pop pop
            s stack_scan.blocks match blocks in
                blocks array.count 0 = if
                    -1 false
                else blocks array.last unwrap int.* 0 + match top in
                    top STACK_TOKEN_MATCH = top STACK_TOKEN_FUNC = or match outer in
                        top kind = kind STACK_TOKEN_END = outer and or if
                            s stack_scan.pop top false
                        else outer if
                            -1 false
                        else
                            s stack_scan.pop -1 true
                        fi fi
                    end
                end fi
            end
        pool pop
    end
end

-- Read the token of kind with value at pos.
func stack_scan.step (stack_scan, int, string, int) () in -- s, kind, value, pos
    match s kind value pos in
        s stack_scan.state 0 + match state in
            kind STACK_TOKEN_FUNC = kind STACK_TOKEN_DATA = or kind STACK_TOKEN_CONST = or if
                s stack_scan.reset
                s STACK_SCAN_NAME stack_scan.state.set
                s kind stack_scan.decl.set
            else kind STACK_TOKEN_IMPORT = if
                s stack_scan.reset
                s STACK_SCAN_IMPORT stack_scan.state.set
            else state STACK_SCAN_NAME = if
                kind STACK_TOKEN_NAME = if
                    s stack_scan.decl 0 + match decl in
                        s stack_scan.names decl value pos stack_scan_names.add
                        s decl STACK_TOKEN_FUNC = if STACK_SCAN_SIG
                        else decl STACK_TOKEN_DATA = if STACK_SCAN_DATA else STACK_SCAN_BODY fi fi
                        stack_scan.state.set
                    end
                    s false stack_scan.paren.set
                else
                    s STACK_SCAN_TOP stack_scan.state.set
                fi
            else state STACK_SCAN_SIG = if
                kind STACK_TOKEN_LPAREN = if
                    s true stack_scan.paren.set
                else kind STACK_TOKEN_RPAREN = if
                    s false stack_scan.paren.set
                else kind STACK_TOKEN_IN = if
                    s STACK_SCAN_BODY stack_scan.state.set
                    s STACK_TOKEN_FUNC 0 stack_scan.push
                fi fi fi
            else state STACK_SCAN_DATA = if
                kind STACK_TOKEN_LPAREN = if
                    s true stack_scan.paren.set
                    s false stack_scan.field.set
                else kind STACK_TOKEN_NAME = if
                    s s stack_scan.field not stack_scan.field.set
                else kind STACK_TOKEN_COMMA = if
                    s false stack_scan.field.set
                else kind STACK_TOKEN_RPAREN = if
                    s STACK_SCAN_TOP stack_scan.state.set
                fi fi fi fi
            else state STACK_SCAN_BINDS = if
                kind STACK_TOKEN_NAME = if
                    s stack_scan.binds STACK_TOKEN_MATCH value pos stack_scan_names.add
                else
                    kind STACK_TOKEN_IN = if
                        s STACK_TOKEN_MATCH s stack_scan.mark 0 + stack_scan.push
                    else
                        s s stack_scan.mark 0 + stack_scan.cut
                    fi
                    s STACK_SCAN_BODY stack_scan.state.set
                fi
            else state STACK_SCAN_BODY = if
                kind STACK_TOKEN_MATCH = if
                    s s stack_scan.binds array.count stack_scan.mark.set
                    s STACK_SCAN_BINDS stack_scan.state.set
                else kind STACK_TOKEN_IF = kind STACK_TOKEN_WHILE = or if
                    s kind s stack_scan.binds array.count stack_scan.push
                else kind STACK_TOKEN_FI = if
                    s STACK_TOKEN_IF stack_scan.close pop
                else kind STACK_TOKEN_POOL = if
                    s STACK_TOKEN_WHILE stack_scan.close pop
                else kind STACK_TOKEN_END = if
                    s STACK_TOKEN_END stack_scan.close STACK_TOKEN_FUNC = if s STACK_SCAN_TOP stack_scan.state.set fi
                fi fi fi fi fi
            else state STACK_SCAN_IMPORT = if
                s STACK_SCAN_TOP stack_scan.state.set
            fi fi fi fi fi fi fi fi
        end
    end
end

func stack_scan.context (stack_scan) (int) in
    match s in
        s stack_scan.state 0 + match state in
            state STACK_SCAN_BODY = if
                STACK_COMPLETE_VALUE
            else state STACK_SCAN_SIG = s stack_scan.paren and if
                STACK_COMPLETE_TYPE
            else state STACK_SCAN_DATA = s stack_scan.paren and s stack_scan.field not and if
                STACK_COMPLETE_TYPE
            else
                STACK_COMPLETE_NONE
            fi fi fi
        end
    end
end

-- A token that a name can replace: a name, a keyword or a boolean.
func stack_token.word (int) (bool) in -- kind
    match k in
        k STACK_TOKEN_BOOLEAN = k STACK_TOKEN_NAME >= k STACK_TOKEN_POOL <= and
        k STACK_TOKEN_LPAREN = not and k STACK_TOKEN_RPAREN = not and k STACK_TOKEN_COMMA = not and or
    end
end

-- The cursor: found, the context, the bytes [start, stop) that a completion
-- replaces and the bindings in scope (array<stack_scan_name>, the innermost
-- last).
data stack_place (bool found, int ctx, int start, int stop, array scope)

-- The cursor is at the bytes [start, stop) in the state of s.
func stack_place.set (stack_place, stack_scan, int, int) () in -- place, s, start, stop
    match place s start stop in
        place true stack_place.found.set
        place s stack_scan.context stack_place.ctx.set
        place start stack_place.start.set
        place stop stack_place.stop.set
        place stack_place.ctx STACK_COMPLETE_VALUE = if
            place stack_place.scope s stack_scan.binds array.extend unwrap
        fi
    end
end

-- Skip the spaces and the comments before the next token, as
-- stack_lexer.next does. A cursor in a comment has no completion.
func stack_place.comments (stack_place, stack_lexer, int) () in -- place, lexer, cursor
    match place lexer cursor in
        lexer stack_lexer.skip.whitespace
        while lexer stack_lexer.ch BYTE_- = lexer stack_lexer.peek BYTE_- = and loop
            lexer stack_lexer.pos 0 + match start in
                lexer stack_lexer.skip.until_newline
                place stack_place.found not start cursor < and cursor lexer stack_lexer.pos <= and if
                    place true stack_place.found.set
                    place STACK_COMPLETE_NONE stack_place.ctx.set
                    place cursor stack_place.start.set
                    place cursor stack_place.stop.set
                fi
            end
            lexer stack_lexer.skip.whitespace
        pool
    end
end

-- Find the cursor in the token of kind at the bytes [pos, e). False when the
-- scan must not read the token: it is the name at the cursor.
func stack_place.at (stack_place, stack_scan, int, int, int, int) (bool) in -- place, s, cursor, kind, pos, e
    match place s cursor kind pos e in
        pos cursor >= if
            kind stack_token.word pos cursor = and if
                place s pos e stack_place.set false
            else
                place s cursor cursor stack_place.set
                true
            fi
        else e cursor >= if
            kind stack_token.word if
                place s pos e stack_place.set false
            else kind STACK_TOKEN_LPAREN = kind STACK_TOKEN_RPAREN = or kind STACK_TOKEN_COMMA = or if
                true
            else
                -- A string, a number or a byte that is not valid.
                place s cursor cursor stack_place.set
                place STACK_COMPLETE_NONE stack_place.ctx.set
                true
            fi fi
        else true fi fi
    end
end

-- Scan text for the cursor and the names of the definitions
-- (array<stack_scan_name>).
func stack_analysis.complete.scan (string, int) (stack_place, array) in -- text, cursor
    match text cursor in
        stack_scan.new stack_scan_name.sizeof array.init.with_sz match s scope in
            false STACK_COMPLETE_NONE cursor cursor scope stack_place.init match place in
                scope array.& ptr.free
                text "" stack_lexer.init.with_buffer match lexer in
                    false while dup not loop -- eof
                        pop
                        place lexer cursor stack_place.comments
                        lexer stack_lexer.next match tok in
                            tok stack_token.kind 0 + tok stack_token.pos 0 + lexer stack_lexer.pos 0 +
                            match kind pos e in
                                place stack_place.found if true else place s cursor kind pos e stack_place.at fi
                                if s kind tok stack_token.value pos stack_scan.step fi
                                kind STACK_TOKEN_EOF =
                            end
                        end
                    pool pop
                end
                place s stack_scan.names
                s stack_scan.blocks array.items ptr.free
                s stack_scan.marks array.items ptr.free
                s stack_scan.binds array.items ptr.free
            end
        end
    end
end

-- A set of names. table has the indexes in names (array<string>), or -1.
data stack_names (array table, array names)

-- A set for n names.
func stack_names.new (int) (stack_names) in -- n
    match n in
        int.sizeof array.init.with_sz string.sizeof array.init.with_sz match table names in
            0 while dup n 2 * 1 + < loop table -1 int.& array.append unwrap 1 + pool pop
            table names stack_names.init
            table array.& ptr.free
            names array.& ptr.free
        end
    end
end

func stack_names.free (stack_names) () in
    match set in
        set stack_names.table array.items ptr.free
        set stack_names.names array.items ptr.free
        set stack_names.& ptr.free
    end
end

-- Add label when it starts with prefix and the set does not have it.
func stack_names.take (stack_names, string, string) (bool) in -- set, prefix, label
    match set prefix label in
        label prefix string.starts_with if
            set stack_names.table set stack_names.names match table names in
                label stack_types.hash table array.count %
                while
                    table over array.get unwrap int.* 0 + match id in
                        id 0 >= if names id array.get unwrap string.* label string.= not else false fi
                    end
                loop 1 + table array.count % pool
                match slot in
                    table slot array.get unwrap int.* 0 < if
                        table slot names array.count int.& array.set unwrap
                        names label string.& array.append unwrap
                        true
                    else false fi
                end
            end
        else false fi
    end
end

func stack_items.add (array, string, int, string) () in -- array<stack_item>, label, kind, detail
    stack_item.init stack_item.& match items p in items p array.append unwrap p ptr.free end
end

-- The type of the binding at pos, or empty.
func stack_analysis.complete.bind (stack_analysis, int) (string) in -- an, pos
    match an pos in
        an stack_analysis.refs match refs in
            -1 0 while dup refs array.count < loop -- found, i
                match found i in
                    found 0 < if
                        refs i array.get unwrap stack_ref.* match r in
                            r stack_ref.kind STACK_REF_BINDING = r stack_ref.start pos = and
                            r stack_ref.decl ptr.null ptr.= not and if i else found fi
                        end
                    else found fi
                    i 1 +
                end
            pool pop
            match found in
                found 0 < if
                    ""
                else refs found array.get unwrap stack_ref.* match r in
                    an r stack_ref.decl stack_ast_func.* pos stack_analysis.bind.type match type ok in
                        ok if type else "" fi
                    end
                end fi
            end
        end
    end
end

func stack_helper.item (stack_helper) (int) in -- h
    stack_helper.kind match kind in
        kind STACK_HELPER_INIT = if STACK_ITEM_CONSTRUCTOR
        else kind STACK_HELPER_GETTER = kind STACK_HELPER_SETTER = or if STACK_ITEM_FIELD
        else STACK_ITEM_CONSTANT fi fi
    end
end

-- The names of one kind that the scan found, without detail.
func stack_analysis.complete.names (array, int, string, array, stack_names) () in -- names, kind, prefix, items, set
    match names kind prefix items set in
        0 while dup names array.count < loop
            match i in
                names i array.get unwrap stack_scan_name.* match n in
                    n stack_scan_name.kind kind = if set prefix n stack_scan_name.name stack_names.take else false fi if
                        items n stack_scan_name.name
                        kind STACK_TOKEN_FUNC = if STACK_ITEM_FUNCTION else STACK_ITEM_CONSTANT fi ""
                        stack_items.add
                    fi
                end
                i 1 +
            end
        pool pop
    end
end

-- The names in a body, in the order of the compiler: the data helpers, the
-- constants (parsed, then found by the scan), the special names (no items),
-- the builtins, the bindings from the innermost and the definitions. A later
-- name with the same label is left out.
func stack_analysis.complete.values (stack_analysis, array, array, string, array, stack_names) () in -- an, scope, names, prefix, items, set
    match an scope names prefix items set in
        an stack_analysis.pre stack_preprocessor.helpers match helpers in
            0 while dup helpers array.count < loop
                match i in
                    helpers i array.get unwrap stack_helper.* match h in
                        h stack_helper.node stack_ast_node.value match label in
                            set prefix label stack_names.take if
                                items label h stack_helper.item label h stack_helper.args h stack_helper.rets
                                stack_signature.text stack_items.add
                            fi
                        end
                    end
                    i 1 +
                end
            pool pop
        end
        an stack_analysis.pre stack_preprocessor.user stack_ast.features match features in
            0 while dup features array.count < loop
                match i in
                    features i array.get unwrap stack_ast_feature.* match feat in
                        feat stack_ast_feature.kind STACK_AST_FEATURE_CONST = if
                            feat stack_ast_feature.feature stack_ast_const.* stack_ast_const.name stack_ast_node.value
                            match label in
                                set prefix label stack_names.take if items label STACK_ITEM_CONSTANT "" stack_items.add fi
                            end
                        fi
                    end
                    i 1 +
                end
            pool pop
        end
        -- The scan finds constants that the parser did not get to.
        names STACK_TOKEN_CONST prefix items set stack_analysis.complete.names
        -- The preprocessor replaces a special name that is not a constant.
        set "" STACK_SPECIAL_FILE stack_names.take pop
        set "" STACK_SPECIAL_LINE stack_names.take pop
        set "" STACK_SPECIAL_COL stack_names.take pop
        an stack_analysis.ctx stack_context.symbols match symbols in
            0 while dup symbols array.count < loop
                match i in
                    symbols i array.get unwrap stack_context_symbol.* match sym in
                        sym stack_context_symbol.kind STACK_CONTEXT_SYMBOL_FUNC = if
                            sym stack_context_symbol.name match label in
                                set prefix label stack_names.take if
                                    items label STACK_ITEM_FUNCTION
                                    sym stack_context_symbol.symbol stack_context_func.* stack_analysis.func.text
                                    stack_items.add
                                fi
                            end
                        fi
                    end
                    i 1 +
                end
            pool pop
        end
        scope array.count while dup 0 > loop
            1 - match i in
                scope i array.get unwrap stack_scan_name.* match b in
                    set prefix b stack_scan_name.name stack_names.take if
                        items b stack_scan_name.name STACK_ITEM_VARIABLE an b stack_scan_name.pos 0 + stack_analysis.complete.bind
                        stack_items.add
                    fi
                end
                i
            end
        pool pop
        an stack_analysis.decls match decls in
            0 while dup decls array.count < loop
                match i in
                    decls i array.get unwrap stack_decl.* match d in
                        d stack_decl.kind 0 + d stack_decl.name match kind label in
                            kind STACK_DECL_DATA = not if set prefix label stack_names.take else false fi if
                                items label STACK_ITEM_FUNCTION
                                kind STACK_DECL_FUNC = if
                                    d stack_decl.decl stack_ast_func.* stack_ast_func.text
                                else
                                    d stack_decl.decl stack_ast_data.* stack_ast_data.name stack_ast_node.value
                                    kind STACK_DECL_REF = if stack_context_func.init.data_ref else stack_context_func.init.data_deref fi
                                    stack_analysis.func.text
                                fi
                                stack_items.add
                            fi
                        end
                    end
                    i 1 +
                end
            pool pop
        end
        names STACK_TOKEN_FUNC prefix items set stack_analysis.complete.names
    end
end

-- The types: the builtin data types, then the data types of the files.
func stack_analysis.complete.types (stack_analysis, array, string, array, stack_names) () in -- an, names, prefix, items, set
    match an names prefix items set in
        an stack_analysis.ctx stack_context.symbols match symbols in
            0 while dup symbols array.count < loop
                match i in
                    symbols i array.get unwrap stack_context_symbol.* match sym in
                        sym stack_context_symbol.kind STACK_CONTEXT_SYMBOL_DATA = if
                            sym stack_context_symbol.name match label in
                                set prefix label stack_names.take if
                                    items label STACK_ITEM_STRUCT "data " label string.concat stack_items.add
                                fi
                            end
                        fi
                    end
                    i 1 +
                end
            pool pop
        end
        an stack_analysis.decls match decls in
            0 while dup decls array.count < loop
                match i in
                    decls i array.get unwrap stack_decl.* match d in
                        d stack_decl.kind STACK_DECL_DATA = if set prefix d stack_decl.name stack_names.take else false fi if
                            items d stack_decl.name STACK_ITEM_STRUCT d stack_decl.decl stack_ast_data.* stack_ast_data.text
                            stack_items.add
                        fi
                    end
                    i 1 +
                end
            pool pop
        end
        0 while dup names array.count < loop
            match i in
                names i array.get unwrap stack_scan_name.* match n in
                    n stack_scan_name.kind STACK_TOKEN_DATA = if set prefix n stack_scan_name.name stack_names.take else false fi
                    if items n stack_scan_name.name STACK_ITEM_STRUCT "" stack_items.add fi
                end
                i 1 +
            end
        pool pop
    end
end

-- The completion at the byte cursor of text, the text of the analysis: the
-- bytes [start, stop) that an item replaces and the items
-- (array<stack_item>). An item starts with the bytes [start, cursor) and has
-- a label that no item before it has. No items in a comment, a string, a
-- number or the name of a new definition or binding.
func stack_analysis.complete (stack_analysis, string, int) (int, int, array) in -- an, text, cursor
    match an text cursor in
        text cursor stack_analysis.complete.scan match place names in
            place stack_place.start 0 + place stack_place.stop 0 + place stack_place.ctx 0 + place stack_place.scope
            stack_item.sizeof array.init.with_sz
            match start stop ctx scope items in
                ctx STACK_COMPLETE_NONE = not if
                    text start cursor start - string.substr match prefix in
                        an stack_analysis.pre stack_preprocessor.helpers array.count
                        an stack_analysis.pre stack_preprocessor.user stack_ast.features array.count +
                        an stack_analysis.ctx stack_context.symbols array.count +
                        an stack_analysis.decls array.count + scope array.count + names array.count + 3 +
                        stack_names.new match set in
                            ctx STACK_COMPLETE_VALUE = if
                                an scope names prefix items set stack_analysis.complete.values
                            else
                                an names prefix items set stack_analysis.complete.types
                            fi
                            set stack_names.free
                        end
                        prefix string.str ptr.free
                    end
                fi
                scope array.items ptr.free
                names array.items ptr.free
                start stop items
            end
        end
    end
end
