@import "stdlib"
@import "stack/parser"
@import "stack/preprocessor"
@import "stack/typecheck"
@import "stack/builtins"

-- Analysis of one Stack file for an editor. It finds the names in the file
-- and resolves them with the parser, the preprocessor and the definitions of
-- the type checker. Offsets are byte offsets in the text of the file.

-- Kinds of names in the file.
const STACK_REF_CALL 0    -- a name in a body: a constant, a function or nothing
const STACK_REF_BOUND 1   -- a name in a body that a match binds
const STACK_REF_BINDING 2 -- a match binding
const STACK_REF_TYPE 3    -- a type in a signature or a data field
const STACK_REF_FUNC 4    -- the name of a func
const STACK_REF_DATA 5    -- the name of a data type
const STACK_REF_FIELD 6   -- the name of a data field
const STACK_REF_CONST 7   -- the name of a const

-- The bytes [start, stop) of a name. decl is the stack_ast_func of
-- STACK_REF_FUNC, the stack_ast_data of STACK_REF_DATA and the stack_ast_const
-- of STACK_REF_CONST, else ptr.null.
data stack_ref (int kind, int start, int stop, string name, ptr decl)

-- Kinds of definitions that the type checker accepts.
const STACK_DECL_DATA 0
const STACK_DECL_FUNC 1
const STACK_DECL_REF 2   -- T.& of a data type
const STACK_DECL_DEREF 3 -- T.* of a data type

-- decl is the stack_ast_func of STACK_DECL_FUNC, else the stack_ast_data.
data stack_decl (int kind, string name, ptr decl)

-- refs: array<stack_ref> of the file. decls: array<stack_decl> of the file and
-- its imports. ctx has the builtins and the definitions. pre has the data
-- helpers. parsed is false when the file has a syntax error; then the refs
-- and the definitions are only from the features before the error. docs and
-- shared: array<stack_doc> of the texts that hovers lexed. shared is for the
-- module cache and the caller owns it.
data stack_analysis (array refs, array decls, stack_context ctx, stack_preprocessor pre, string filename, bool parsed, ptr docs, ptr shared)

-- NAMES OF THE FILE

func stack_ref.add (array, int, stack_ast_node, ptr) () in -- array<stack_ref>, kind, node, decl
    match refs kind node decl in
        node stack_ast_node.value match name in
            node stack_ast_node.pos 0 + match start in
                kind start start name string.len + name decl stack_ref.init stack_ref.& match r in
                    refs r array.append unwrap r ptr.free
                end
            end
        end
    end
end

func stack_strings.has (array, string) (bool) in
    match xs s in
        false 0 while dup xs array.count < loop
            match found i in found xs i array.get unwrap string.* s string.= or i 1 + end
        pool pop
    end
end

func stack_analysis.names.nodes (array, int, array) () in -- array<stack_ref>, kind, array<stack_ast_node>
    match refs kind nodes in
        0 while dup nodes array.count < loop
            match i in refs kind nodes i array.get unwrap stack_ast_node.* ptr.null stack_ref.add i 1 + end
        pool pop
    end
end

-- scope has the names that the enclosing matches bind.
func stack_analysis.names.exprs (array, array, array) () in -- array<stack_ref>, scope, array<stack_ast_expr>
    match refs scope exprs in
        0 while dup exprs array.count < loop
            match i in
                exprs i array.get unwrap stack_ast_expr.* match expr in
                    expr stack_ast_expr.kind match kind in
                        kind STACK_AST_EXPR_NAME = if
                            expr stack_ast_expr.expr stack_ast_node.* match node in
                                refs scope node stack_ast_node.value stack_strings.has if STACK_REF_BOUND else STACK_REF_CALL fi
                                node ptr.null stack_ref.add
                            end
                        else kind STACK_AST_EXPR_COND = if
                            expr stack_ast_expr.expr stack_ast_cond.* match cond in
                                refs scope cond stack_ast_cond.if_ stack_analysis.names.exprs
                                refs scope cond stack_ast_cond.else_ stack_analysis.names.exprs
                            end
                        else kind STACK_AST_EXPR_MATCH = if
                            expr stack_ast_expr.expr stack_ast_match.* match m in
                                m stack_ast_match.binds match binds in
                                    refs STACK_REF_BINDING binds stack_analysis.names.nodes
                                    0 while dup binds array.count < loop
                                        match j in
                                            scope binds j array.get unwrap stack_ast_node.* stack_ast_node.value string.&
                                            array.append unwrap
                                            j 1 +
                                        end
                                    pool pop
                                    refs scope m stack_ast_match.exprs stack_analysis.names.exprs
                                    0 while dup binds array.count < loop scope array.pop unwrap 1 + pool pop
                                end
                            end
                        else kind STACK_AST_EXPR_WHILE = if
                            expr stack_ast_expr.expr stack_ast_while.* match w in
                                refs scope w stack_ast_while.while_ stack_analysis.names.exprs
                                refs scope w stack_ast_while.exprs stack_analysis.names.exprs
                            end
                        fi fi fi fi
                    end
                end
                i 1 +
            end
        pool pop
    end
end

-- The names of the features of ast.
func stack_analysis.names (stack_ast) (array) in
    stack_ast.features match features in
        stack_ref.sizeof array.init.with_sz stack_strings.new match refs scope in
            0 while dup features array.count < loop
                match i in
                    features i array.get unwrap stack_ast_feature.* match feat in
                        feat stack_ast_feature.kind match kind in
                            kind STACK_AST_FEATURE_DATA = if
                                feat stack_ast_feature.feature match p in
                                    p stack_ast_data.* match d in
                                        refs STACK_REF_DATA d stack_ast_data.name p stack_ref.add
                                        d stack_ast_data.fields match fields in
                                            0 while dup fields array.count < loop
                                                match j in
                                                    fields j array.get unwrap stack_ast_data_field.* match field in
                                                        refs STACK_REF_TYPE field stack_ast_data_field.type ptr.null stack_ref.add
                                                        refs STACK_REF_FIELD field stack_ast_data_field.name ptr.null stack_ref.add
                                                    end
                                                    j 1 +
                                                end
                                            pool pop
                                        end
                                    end
                                end
                            else kind STACK_AST_FEATURE_FUNC = if
                                feat stack_ast_feature.feature match p in
                                    p stack_ast_func.* match f in
                                        refs STACK_REF_FUNC f stack_ast_func.name p stack_ref.add
                                        refs STACK_REF_TYPE f stack_ast_func.args stack_analysis.names.nodes
                                        refs STACK_REF_TYPE f stack_ast_func.rets stack_analysis.names.nodes
                                        refs scope f stack_ast_func.exprs stack_analysis.names.exprs
                                    end
                                end
                            else kind STACK_AST_FEATURE_CONST = if
                                feat stack_ast_feature.feature match p in p stack_ast_const.* match c in
                                    refs STACK_REF_CONST c stack_ast_const.name p stack_ref.add
                                    refs scope c stack_ast_const.exprs stack_analysis.names.exprs
                                end end
                            fi fi fi
                        end
                    end
                    i 1 +
                end
            pool pop
            scope array.items ptr.free
            scope array.& ptr.free
            refs
        end
    end
end

-- DEFINITIONS

func stack_decl.add (array, int, string, ptr) () in -- array<stack_decl>, kind, name, decl
    stack_decl.init stack_decl.& match decls d in decls d array.append unwrap d ptr.free end
end

-- The definitions of the files in the order of the type checker: the data
-- types with T.& and T.*, then the functions. The type checker uses the
-- first symbol with a name, after the builtins, and rejects later ones, so
-- the first definition with a name is the one that it uses.
func stack_analysis.defines (stack_ast) (array) in
    stack_ast.features match features in
        stack_decl.sizeof array.init.with_sz match decls in
            0 while dup features array.count < loop
                match i in
                    features i array.get unwrap stack_ast_feature.* match feat in
                        feat stack_ast_feature.kind STACK_AST_FEATURE_DATA = if
                            feat stack_ast_feature.feature match p in
                                p stack_ast_data.* stack_ast_data.name stack_ast_node.value match name in
                                    decls STACK_DECL_DATA name p stack_decl.add
                                    decls STACK_DECL_REF name ".&" string.concat p stack_decl.add
                                    decls STACK_DECL_DEREF name ".*" string.concat p stack_decl.add
                                end
                            end
                        fi
                    end
                    i 1 +
                end
            pool pop
            0 while dup features array.count < loop
                match i in
                    features i array.get unwrap stack_ast_feature.* match feat in
                        feat stack_ast_feature.kind STACK_AST_FEATURE_FUNC = if
                            feat stack_ast_feature.feature match p in
                                decls STACK_DECL_FUNC p stack_ast_func.* stack_ast_func.name stack_ast_node.value p
                                stack_decl.add
                            end
                        fi
                    end
                    i 1 +
                end
            pool pop
            decls
        end
    end
end

-- Analyse the file text with the name filename and the file id. sources
-- are the texts of the open files (array<stack_source>). modules is the
-- module cache (array<stack_module>) and shared has its docs (array<stack_doc>).
func stack_analysis.build (string, string, stack_file_id, array, array, ptr) (stack_analysis) in -- text, filename, id, sources, modules, shared
    match text filename id sources modules shared in
        text filename stack_lexer.init.with_buffer stack_parser.init.with_lexer stack_parser.parse
        match ast parsed in
            ast stack_analysis.names
            id stack_preprocessor.init.with_main match refs pre in
                pre modules stack_preprocessor.cache.use
                0 while dup sources array.count < loop
                    match i in
                        sources i array.get unwrap stack_source.* match src in
                            pre src stack_source.id src stack_source.text stack_preprocessor.sources.add
                        end
                        i 1 +
                    end
                pool pop
                pre ast stack_preprocessor.load pop2
                pre stack_ast.init.empty stack_preprocessor.run.base.consts
                stack_context.init.base match ctx in
                    refs pre stack_preprocessor.user stack_analysis.defines ctx pre filename parsed
                    stack_doc.sizeof array.init.with_sz array.& shared stack_analysis.init
                end
            end
        end
    end
end

-- Free the names, the definitions and the lists of the analysis. The syntax
-- trees and the data helpers stay, because the module cache shares them.
func stack_analysis.free (stack_analysis) () in
    match an in
        an stack_analysis.refs array.items ptr.free
        an stack_analysis.ctx stack_context.symbols array.items ptr.free
        an stack_analysis.pre match pre in
            pre stack_preprocessor.files array.items ptr.free
            pre stack_preprocessor.user stack_ast.features array.items ptr.free
            pre stack_preprocessor.generated stack_ast.features array.items ptr.free
            pre stack_preprocessor.helpers array.items ptr.free
            pre stack_preprocessor.sources array.items ptr.free
        end
        an stack_analysis.decls match decls in
            0 while dup decls array.count < loop
                match i in
                    decls i array.get unwrap stack_decl.* match d in
                        d stack_decl.kind STACK_DECL_REF = d stack_decl.kind STACK_DECL_DEREF = or if
                            d stack_decl.name string.str ptr.free
                        fi
                    end
                    i 1 +
                end
            pool pop
            decls array.items ptr.free
        end
        an stack_analysis.docs array.* match docs in
            0 while dup docs array.count < loop
                match i in
                    docs i array.get unwrap stack_doc.* stack_doc.free
                    i 1 +
                end
            pool pop
            docs array.items ptr.free
            docs array.& ptr.free
        end
    end
end

-- LOOKUP

-- The name with start <= offset < stop.
func stack_analysis.find (stack_analysis, int) (stack_ref, bool) in -- an, offset
    match an offset in
        an stack_analysis.refs match refs in
            -1 0 while dup refs array.count < loop -- found, i
                match found i in
                    found 0 < if
                        refs i array.get unwrap stack_ref.* match r in
                            r stack_ref.start offset <= offset r stack_ref.stop < and if i else found fi
                        end
                    else found fi
                    i 1 +
                end
            pool pop
            match found in
                found 0 >= if
                    refs found array.get unwrap stack_ref.* true
                else
                    0 0 0 "" ptr.null stack_ref.init false
                fi
            end
        end
    end
end

func stack_analysis.decl (stack_analysis, string) (stack_decl, bool) in -- an, name
    match an name in
        an stack_analysis.decls match decls in
            -1 0 while dup decls array.count < loop -- found, i
                match found i in
                    found 0 < decls i array.get unwrap stack_decl.* stack_decl.name name string.= and if i else found fi
                    i 1 +
                end
            pool pop
            match found in
                found 0 >= if
                    decls found array.get unwrap stack_decl.* true
                else
                    0 "" ptr.null stack_decl.init false
                fi
            end
        end
    end
end

func stack_analysis.helper (stack_analysis, string) (stack_helper, bool) in -- an, name
    match an name in
        an stack_analysis.pre stack_preprocessor.helpers match helpers in
            -1 0 while dup helpers array.count < loop -- found, i
                match found i in
                    found 0 < helpers i array.get unwrap stack_helper.* stack_helper.node stack_ast_node.value name string.=
                    and if i else found fi
                    i 1 +
                end
            pool pop
            match found in
                found 0 >= if helpers found array.get unwrap stack_helper.* true
                else ptr.null stack_helper.* false fi
            end
        end
    end
end

-- The first constant of the files with the name, not a data helper.
func stack_analysis.const (stack_analysis, string) (stack_ast_const, bool) in -- an, name
    match an name in
        an stack_analysis.pre stack_preprocessor.user stack_ast.features match features in
            -1 0 while dup features array.count < loop -- found, i
                match found i in
                    features i array.get unwrap stack_ast_feature.* match feat in
                        found 0 < feat stack_ast_feature.kind STACK_AST_FEATURE_CONST = and if
                            feat stack_ast_feature.feature stack_ast_const.* stack_ast_const.name stack_ast_node.value
                            name string.= if i else found fi
                        else found fi
                    end
                    i 1 +
                end
            pool pop
            match found in
                found 0 >= if
                    features found array.get unwrap stack_ast_feature.* stack_ast_feature.feature stack_ast_const.* true
                else ptr.null stack_ast_const.* false fi
            end
        end
    end
end

-- TEXT

func stack_strings.join (array) (string) in
    match xs in
        "" 0 while dup xs array.count < loop
            match s i in
                s i 0 > if ", " string.concat fi xs i array.get unwrap string.* string.concat
                i 1 +
            end
        pool pop
    end
end

func stack_signature.text (string, array, array) (string) in -- name, args, rets
    match name args rets in
        name " (" string.concat args stack_strings.join string.concat ") (" string.concat
        rets stack_strings.join string.concat ")" string.concat
    end
end

func stack_analysis.func.text (stack_context_func) (string) in
    match f in
        "func " f stack_context_func.name f stack_context_func.args f stack_context_func.rets stack_signature.text
        string.concat
    end
end

func stack_ast_func.text (stack_ast_func) (string) in
    match f in
        "func " f stack_ast_func.name stack_ast_node.value
        f stack_ast_func.args stack_params.node_to_string f stack_ast_func.rets stack_params.node_to_string
        stack_signature.text string.concat
    end
end

func stack_ast_data.text (stack_ast_data) (string) in
    match d in
        d stack_ast_data.fields match fields in
            "data " d stack_ast_data.name stack_ast_node.value string.concat " (" string.concat
            0 while dup fields array.count < loop
                match s i in
                    s i 0 > if ", " string.concat fi
                    fields i array.get unwrap stack_ast_data_field.* match field in
                        field stack_ast_data_field.type stack_ast_node.value string.concat " " string.concat
                        field stack_ast_data_field.name stack_ast_node.value string.concat
                    end
                    i 1 +
                end
            pool pop
            ")" string.concat
        end
    end
end

func stack_helper.note (stack_helper) (string) in
    match h in
        h stack_helper.kind h stack_helper.owner h stack_helper.field match kind owner field in
            kind STACK_HELPER_SIZEOF = if
                owner " size"
            else kind STACK_HELPER_OFFSET = if
                owner "." string.concat field string.concat " offset"
            else kind STACK_HELPER_INIT = if
                owner " constructor"
            else kind STACK_HELPER_GETTER = if
                owner "." string.concat field string.concat " getter"
            else
                owner "." string.concat field string.concat " setter"
            fi fi fi fi
            string.concat
        end
    end
end

-- DOCS

-- The offset of the first byte of the line with the byte at p.
func stack_doc.line (string, int) (int) in -- text, p
    match text p in
        p while dup 0 > if dup 1 - text swp string.!! BYTE_\N = not else false fi loop 1 - pool
    end
end

func stack_doc.space (int) (bool) in
    match c in c BYTE_SPACE = c BYTE_\T = or end
end

-- The offset of the first byte in [i, e) that is not a space or a tab.
func stack_doc.skip (string, int, int) (int) in -- text, i, e
    match text i e in
        i while dup e < if dup text swp string.!! stack_doc.space else false fi loop 1 + pool
    end
end

func stack_doc.dashes (string, int, int) (bool) in -- text, i, e
    match text i e in
        i 2 + e <= if text i string.!! BYTE_- = text i 1 + string.!! BYTE_- = and else false fi
    end
end

-- The bytes [i, e) without the leading -- and one space, or as they are
-- when they are not a comment.
func stack_doc.segment (string, int, int) (string) in -- text, i, e
    match text i e in
        text i e stack_doc.skip match j in
            text j e stack_doc.dashes if
                j 2 + match k in
                    k e < if text k string.!! BYTE_SPACE = else false fi if k 1 + else k fi
                end
            else i fi
        end
        match k in text k e k - string.substr end
    end
end

-- The doc text of the line [i, e) and true when the line is only a comment.
-- A carriage return before e is dropped and the others are line breaks.
func stack_doc.comment (string, int, int) (string, bool) in -- text, i, e
    match text i e in
        text i e stack_doc.skip match j in
            text j e stack_doc.dashes not if
                "" false
            else
                e j > if text e 1 - string.!! 13 = else false fi if e 1 - else e fi
                match e' in
                    "" j j while dup e' <= loop -- out, s, k
                        match out s k in
                            k e' = if true else text k string.!! 13 = fi if
                                out s j > if "\n" string.concat fi text s k stack_doc.segment string.concat
                                k 1 + k 1 +
                            else
                                out s k 1 +
                            fi
                        end
                    pool pop2 true
                end
            fi
        end
    end
end

-- The comment lines just above the line that starts at s and not before
-- lo, without the empty lines at the start and at the end.
func stack_doc.block (string, int, int) (string) in -- text, s, lo
    match text s lo in
        string.sizeof array.init.with_sz match lines in
            s 1 - s lo > while dup loop -- e, more
                pop match e in
                    text e stack_doc.line match i in
                        text i e stack_doc.comment match line ok in
                            ok if
                                line string.& match p in lines p array.append unwrap p ptr.free end
                                i 1 - i lo >
                            else
                                e false
                            fi
                        end
                    end
                end
            pool pop2
            -- lines is from the bottom up.
            0 while dup lines array.count < if dup lines swp array.get unwrap string.* string.len 0 = else false fi loop
                1 +
            pool
            lines array.count while dup2 < if dup 1 - lines swp array.get unwrap string.* string.len 0 = else false fi loop
                1 -
            pool
            match lo' hi in
                "" hi while dup lo' > loop
                    match out k in
                        out k hi < if "\n" string.concat fi lines k 1 - array.get unwrap string.* string.concat
                        k 1 -
                    end
                pool pop
            end
            lines array.items ptr.free
            lines array.& ptr.free
        end
    end
end

-- The doc of the keyword at p. The token before it ends at q, or q is -1.
-- The doc is empty when the keyword is on the line of that token.
func stack_doc.of (string, int, int) (string) in -- text, p, q
    match text p q in
        q 0 < if
            0
        else
            q while dup p < if dup text swp string.!! BYTE_\N = not else false fi loop 1 + pool 1 +
        fi
        match lo in
            lo p > if "" else text text p stack_doc.line lo stack_doc.block fi
        end
    end
end

-- The doc and the code of the definition with the name at pos in the text at
-- buffer. code is the text of a const, else empty. id is the module of the
-- text, or -1 -1. pos is -1 for the mark of a text that is lexed.
data stack_doc (stack_file_id id, ptr buffer, int pos, string text, string code)

func stack_doc.add (array, stack_file_id, ptr, int, string, string) () in -- array<stack_doc>, id, buffer, pos, text, code
    match docs id buffer pos text code in
        id buffer pos text code stack_doc.init stack_doc.& match p in docs p array.append unwrap p ptr.free end
    end
end

func stack_doc.free (stack_doc) () in
    match d in
        d stack_doc.text string.len 0 > if d stack_doc.text string.str ptr.free fi
        d stack_doc.code string.len 0 > if d stack_doc.code string.str ptr.free fi
    end
end

func stack_doc.find (array, stack_file_id, ptr, int) (string, string, bool) in -- array<stack_doc>, id, buffer, pos
    match docs id buffer pos in
        -1 0 while dup docs array.count < loop -- found, i
            match found i in
                found 0 < if
                    docs i array.get unwrap stack_doc.* match d in
                        d stack_doc.buffer buffer ptr.= d stack_doc.pos pos = and d stack_doc.id id stack_file_id.= and
                        if i else found fi
                    end
                else found fi
                i 1 +
            end
        pool pop
        match found in
            found 0 >= if
                docs found array.get unwrap stack_doc.* match d in d stack_doc.text d stack_doc.code true end
            else "" "" false fi
        end
    end
end

-- The state of stack_doc.lex. q is the end of the last token. kind is the
-- keyword before a name, with its doc and its offset start. name is the
-- offset of the name of an open const, depth its open blocks and stop the end
-- of its last token, else -1.
data stack_doc_scan (int q, int kind, string doc, int start, int name, int depth, int stop)

-- Add the open const.
func stack_doc_scan.close (stack_doc_scan, array, stack_file_id, string) () in -- s, docs, id, text
    match s docs id text in
        s stack_doc_scan.name 0 >= if
            docs id text string.str s stack_doc_scan.name 0 + s stack_doc_scan.doc
            text s stack_doc_scan.start 0 + s stack_doc_scan.stop s stack_doc_scan.start - string.substr
            stack_doc.add
            s -1 stack_doc_scan.name.set
        fi
    end
end

-- Read the token of kind k at the bytes [p, e). A const has the expressions
-- that the parser reads after its name.
func stack_doc_scan.step (stack_doc_scan, array, stack_file_id, string, int, int, int) () in -- s, docs, id, text, k, p, e
    match s docs id text k p e in
        k STACK_TOKEN_IF = k STACK_TOKEN_MATCH = or k STACK_TOKEN_WHILE = or
        k STACK_TOKEN_FI = k STACK_TOKEN_END = or k STACK_TOKEN_POOL = or
        match opens closes in
            s stack_doc_scan.name 0 >= if
                s stack_doc_scan.depth 0 > if
                    s s stack_doc_scan.depth 0 + opens if 1 + fi closes if 1 - fi stack_doc_scan.depth.set true
                else
                    opens k STACK_TOKEN_NAME = or k STACK_TOKEN_NUMBER = or k STACK_TOKEN_BOOLEAN = or k STACK_TOKEN_STRING = or
                    if
                        s opens if 1 else 0 fi stack_doc_scan.depth.set true
                    else
                        s docs id text stack_doc_scan.close false
                    fi
                fi
                dup if s e stack_doc_scan.stop.set fi
            else false fi
            not if
                s stack_doc_scan.kind 0 + match pending in
                    s 0 stack_doc_scan.kind.set
                    pending 0 = not k STACK_TOKEN_NAME = and if
                        pending STACK_TOKEN_CONST = if
                            s p stack_doc_scan.name.set s 0 stack_doc_scan.depth.set s e stack_doc_scan.stop.set
                        else s stack_doc_scan.doc string.len 0 > if
                            docs id text string.str p s stack_doc_scan.doc "" stack_doc.add
                        fi fi
                    fi
                end
                k STACK_TOKEN_FUNC = k STACK_TOKEN_DATA = or k STACK_TOKEN_CONST = or if
                    s k stack_doc_scan.kind.set
                    s text p s stack_doc_scan.q 0 + stack_doc.of stack_doc_scan.doc.set
                    s p stack_doc_scan.start.set
                fi
            fi
            s e stack_doc_scan.q.set
        end
    end
end

-- Add the docs of the definitions in text and the code of its consts. The
-- lexer of the compiler finds the comments, so the text of a string is never
-- a doc.
func stack_doc.lex (array, stack_file_id, string) () in -- array<stack_doc>, id, text
    match docs id text in
        -1 0 "" 0 -1 0 0 stack_doc_scan.init match s in
            text "" stack_lexer.init.with_buffer match lexer in
                lexer stack_lexer.next
                while dup stack_token.kind STACK_TOKEN_EOF = not loop
                    match tok in
                        s docs id text tok stack_token.kind 0 + tok stack_token.pos 0 + lexer stack_lexer.pos 0 +
                        stack_doc_scan.step
                        lexer stack_lexer.next
                    end
                pool pop
            end
            s docs id text stack_doc_scan.close
            s stack_doc_scan.& ptr.free
        end
        docs id text string.str -1 "" "" stack_doc.add
    end
end

-- The id of the module in modules (array<stack_module>) with the text at
-- buffer. False when there is none.
func stack_modules.with_text (array, ptr) (stack_file_id, bool) in -- modules, buffer
    match modules buffer in
        -1 -1 stack_file_id.init false 0 while dup modules array.count < loop
            match id found i in
                found if
                    id true
                else modules i array.get unwrap stack_module.* match m in
                    m stack_module.text string.str buffer ptr.= if m stack_module.id true else id false fi
                end fi
                i 1 +
            end
        pool pop
    end
end

-- Remove the docs of the texts that are not in modules (array<stack_module>).
func stack_docs.prune (array, array) () in -- array<stack_doc>, modules
    match docs modules in
        stack_doc.sizeof array.init.with_sz match kept in
            0 while dup docs array.count < loop
                match i in
                    docs i array.get unwrap match p in
                        p stack_doc.* match d in
                            modules d stack_doc.buffer stack_modules.with_text match id found in
                                found if id d stack_doc.id stack_file_id.= else false fi
                            end
                            if kept p array.append unwrap else d stack_doc.free fi
                        end
                    end
                    i 1 +
                end
            pool pop
            docs array.items ptr.free
            docs array.& kept array.& array.sizeof ptr.@ pop
            kept array.& ptr.free
        end
    end
end

-- The doc and the code of the definition with the name node. A text is
-- lexed once: the docs of a module in the module cache are in shared, the
-- others in the analysis.
func stack_analysis.doc (stack_analysis, stack_ast_node) (string, string) in -- an, name
    match an name in
        name stack_ast_node.parser stack_parser.lexer stack_lexer.buffer name stack_ast_node.pos 0 +
        match text p in
            an stack_analysis.pre stack_preprocessor.modules array.* text string.str stack_modules.with_text
            match id shared in
                shared if an stack_analysis.shared else an stack_analysis.docs fi array.* match docs in
                    docs id text string.str -1 stack_doc.find match doc code lexed in
                        lexed not if docs id text stack_doc.lex fi
                    end
                    docs id text string.str p stack_doc.find pop
                end
            end
        end
    end
end

-- HOVER

-- The description of a builtin function, or empty.
func stack_builtin.doc (string) (string) in
    match name in
        name STACK_FUNC_PTR_ALLOC string.= if "Allocate n bytes."
        else name STACK_FUNC_PTR_FREE string.= if "Free an allocated block."
        else name STACK_FUNC_PTR_OFFSET string.= if "Add a byte offset."
        else name STACK_FUNC_PTR_COPY string.= if "Copy n bytes from src to dst and return dst."
        else name STACK_FUNC_INT_REF string.= if "Address of the value."
        else name STACK_FUNC_PTR_REF string.= if "Address of the value."
        else name STACK_FUNC_BOOL_REF string.= if "Address of the value."
        else name STACK_FUNC_INT_DEREF string.= if "Dereference as int."
        else name STACK_FUNC_PTR_DEREF string.= if "Dereference as ptr."
        else name STACK_FUNC_BOOL_DEREF string.= if "Dereference as bool."
        else name STACK_FUNC_DUP string.= if "Duplicate the top item."
        else name STACK_FUNC_SWP string.= if "Swap the top two items."
        else name STACK_FUNC_ROT string.= if "Rotate (a, b, c) to (b, c, a)."
        else name STACK_FUNC_ROT4 string.= if "Rotate (a, b, c, d) to (b, c, d, a)."
        else name STACK_FUNC_POP string.= if "Remove the top item."
        else name STACK_FUNC_PLUS string.= if "Add two integers."
        else name STACK_FUNC_MINUS string.= if "Subtract two integers."
        else name STACK_FUNC_STAR string.= if "Multiply two integers."
        else name STACK_FUNC_DIV string.= if "Signed integer division."
        else name STACK_FUNC_MOD string.= if "Signed integer remainder."
        else name STACK_FUNC_OR string.= if "Bitwise OR."
        else name STACK_FUNC_AND string.= if "Bitwise AND."
        else name STACK_FUNC_XOR string.= if "Bitwise XOR."
        else name STACK_FUNC_SHL string.= if "Shift left"
        else name STACK_FUNC_SHR string.= if "Shift right"
        else name STACK_FUNC_GT string.= if "Greater than."
        else name STACK_FUNC_LT string.= if "Less than."
        else name STACK_FUNC_EQ string.= if "Equal."
        else name STACK_FUNC_ENV string.= if "Pointer to the environment variable array."
        else name STACK_FUNC_SYSCALL1 string.= if "Linux syscall with one argument."
        else name STACK_FUNC_SYSCALL3 string.= if "Linux syscall with three arguments."
        else name STACK_FUNC_PICK string.= if "duplicate item n on top of the stack as a pointer"
        else ""
        fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi fi
    end
end


func stack_analysis.hover.data (stack_analysis, stack_ast_data) (bool, string, string, string) in -- an, d
    match an d in true d stack_ast_data.text "" an d stack_ast_data.name stack_analysis.doc pop end
end

func stack_analysis.hover.const (stack_analysis, stack_ast_const) (bool, string, string, string) in -- an, c
    match an c in
        an c stack_ast_const.name stack_analysis.doc match doc code in
            true code string.len 0 > if code else "const " c stack_ast_const.name stack_ast_node.value string.concat fi
            "" doc
        end
    end
end

func stack_analysis.hover.type (stack_analysis, string) (bool, string, string, string) in -- an, name
    match an name in
        an stack_analysis.ctx name stack_context.get_symbol match builtin symbol in
            builtin if
                symbol stack_context_symbol.* stack_context_symbol.kind STACK_CONTEXT_SYMBOL_DATA = if
                    true "data " name string.concat "Builtin data type." ""
                else false "" "" "" fi
            else an name stack_analysis.decl match d found in
                found if d stack_decl.kind STACK_DECL_DATA = else false fi if
                    an d stack_decl.decl stack_ast_data.* stack_analysis.hover.data
                else false "" "" "" fi
            end fi
        end
    end
end

func stack_analysis.hover.decl (stack_analysis, stack_decl) (bool, string, string, string) in -- an, d
    match an d in
        d stack_decl.kind match kind in
            kind STACK_DECL_FUNC = if
                d stack_decl.decl stack_ast_func.* match f in
                    true f stack_ast_func.text "" an f stack_ast_func.name stack_analysis.doc pop
                end
            else kind STACK_DECL_DATA = if
                false "" "" ""
            else
                d stack_decl.decl stack_ast_data.* stack_ast_data.name stack_ast_node.value match owner in
                    true
                    owner kind STACK_DECL_REF = if stack_context_func.init.data_ref else stack_context_func.init.data_deref fi
                    stack_analysis.func.text
                    owner kind STACK_DECL_REF = if " reference" else " dereference" fi string.concat ""
                end
            fi fi
        end
    end
end

func stack_analysis.hover.call (stack_analysis, string) (bool, string, string, string) in -- an, name
    match an name in
        an name stack_analysis.helper match h is_helper in
            is_helper if
                true
                h stack_helper.node stack_ast_node.value h stack_helper.args h stack_helper.rets stack_signature.text
                h stack_helper.note ""
            else an name stack_analysis.const match c is_const in is_const if
                an c stack_analysis.hover.const
            else name STACK_SPECIAL_FILE string.= name STACK_SPECIAL_LINE string.= or name STACK_SPECIAL_COL string.= or if
                false "" "" ""
            else an stack_analysis.ctx name stack_context.get_symbol match builtin symbol in
                builtin if
                    symbol stack_context_symbol.* match sym in
                        sym stack_context_symbol.kind STACK_CONTEXT_SYMBOL_FUNC = if
                            true sym stack_context_symbol.symbol stack_context_func.* stack_analysis.func.text
                            name stack_builtin.doc match doc in
                                doc string.len 0 > if "" doc else "Builtin function." "" fi
                            end
                        else false "" "" "" fi
                    end
                else an name stack_analysis.decl match d found in
                    found if an d stack_analysis.hover.decl else false "" "" "" fi
                end fi
            end fi fi end fi
        end
    end
end

-- The hover text at offset: found, the bytes [start, stop) of the name, the
-- code, a note and the doc comment of the definition. Not found for literals,
-- keywords, bindings, type variables and names that do not resolve. A bound
-- name that is a constant is the constant, as the preprocessor expands it.
func stack_analysis.hover (stack_analysis, int) (bool, int, int, string, string, string) in -- an, offset
    match an offset in
        an offset stack_analysis.find match r found in
            found not if
                false "" "" ""
            else r stack_ref.kind match kind in
                kind STACK_REF_FUNC = if
                    r stack_ref.decl stack_ast_func.* match f in
                        true f stack_ast_func.text "" an f stack_ast_func.name stack_analysis.doc pop
                    end
                else kind STACK_REF_DATA = if
                    an r stack_ref.decl stack_ast_data.* stack_analysis.hover.data
                else kind STACK_REF_CONST = if
                    an r stack_ref.decl stack_ast_const.* stack_analysis.hover.const
                else kind STACK_REF_TYPE = if
                    an r stack_ref.name stack_analysis.hover.type
                else kind STACK_REF_CALL = if
                    an r stack_ref.name stack_analysis.hover.call
                else kind STACK_REF_BOUND = if
                    an r stack_ref.name stack_analysis.helper swp pop an r stack_ref.name stack_analysis.const swp pop or
                    if an r stack_ref.name stack_analysis.hover.call else false "" "" "" fi
                else
                    false "" "" ""
                fi fi fi fi fi fi
            end fi
            match ok code note doc in ok r stack_ref.start 0 + r stack_ref.stop 0 + code note doc end
        end
    end
end
